    vec_push(v,evt_new("Egyptian-Hittite Peace Treaty",(0-1259),"Bronze Age",CAT_TREATY,"Earliest known international peace treaty, between Ramesses II and Hattusili III","Ancient Egypt;Hittite Empire",SIG_CONTINENTAL));
    vec_push(v,evt_new("Founding of the Shang Dynasty",(0-1600),"Bronze Age",CAT_FOUNDING,"Earliest archaeologically attested Chinese dynasty, with oracle bone writing","Ancient China",SIG_REGIONAL));
    vec_push(v,evt_new("Invention of the Wheel",(0-3500),"Bronze Age",CAT_INVENTION,"Development of the potter's wheel and wheeled vehicles in Mesopotamia","Mesopotamia",SIG_GLOBAL));
    vec_push(v,evt_new("Migration of the Sea Peoples",(0-1200),"Bronze Age",CAT_MIGRATION,"Mass migration of maritime raiders destabilizing eastern Mediterranean civilizations","Ancient Egypt;Hittite Empire",SIG_CONTINENTAL));
    vec_push(v,evt_new("Decline of the Indus Valley Civilization",(0-1900),"Bronze Age",CAT_COLLAPSE,"Gradual abandonment of major Indus cities such as Mohenjo-daro and Harappa","Indus Valley",SIG_REGIONAL));
