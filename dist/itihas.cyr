    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+FIG_NAME));
    _json_sep(sb); _json_int(sb, "birth_year", load64(p+FIG_BIRTH));
    _json_sep(sb); _json_int(sb, "death_year", load64(p+FIG_DEATH));
    _json_sep(sb); _json_str(sb, "civilization", load64(p+FIG_CIV));
    _json_sep(sb); _json_int(sb, "domain", load64(p+FIG_DOM));
    _json_sep(sb); _json_str(sb, "description", load64(p+FIG_DESC));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
