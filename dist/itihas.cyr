# itihas — historical events (105)

enum EventCategory { CAT_WAR; CAT_TREATY; CAT_DISCOVERY; CAT_INVENTION; CAT_REVOLUTION; CAT_MIGRATION; CAT_FOUNDING; CAT_COLLAPSE; }
enum EventSignificance { SIG_LOCAL; SIG_REGIONAL; SIG_CONTINENTAL; SIG_GLOBAL; }
enum EvtOff { EVT_NAME=0; EVT_YEAR=8; EVT_ERA=16; EVT_CAT=24; EVT_DESC=32; EVT_CIVS=40; EVT_SIG=48; EVT_SIZE=56; }

var evt_vec = 0;
var evt_init_done = 0;

fn evt_new(name: Str, year, era: Str, cat, desc: Str, civs: Str, sig) {
    var p = alloc(EVT_SIZE);
    store64(p+EVT_NAME,name); store64(p+EVT_YEAR,year); store64(p+EVT_ERA,era);
    store64(p+EVT_CAT,cat); store64(p+EVT_DESC,desc); store64(p+EVT_CIVS,civs); store64(p+EVT_SIG,sig);
    return p;
}
fn evt_name(p) { return load64(p+EVT_NAME); }
fn evt_year(p) { return load64(p+EVT_YEAR); }
fn evt_cat(p) { return load64(p+EVT_CAT); }
fn evt_sig(p) { return load64(p+EVT_SIG); }

fn build_events() {
    var v = vec_new();
    vec_push(v,evt_new("Invention of Writing",(0-3400),"Bronze Age",CAT_INVENTION,"Development of cuneiform in Sumer, enabling record-keeping and literature","Mesopotamia",SIG_GLOBAL));
    vec_push(v,evt_new("Construction of the Great Pyramid",(0-2560),"Bronze Age",CAT_FOUNDING,"Completion of the Great Pyramid of Giza under Pharaoh Khufu","Ancient Egypt",SIG_REGIONAL));
    vec_push(v,evt_new("Code of Hammurabi",(0-1754),"Bronze Age",CAT_FOUNDING,"One of the earliest written legal codes, established by King Hammurabi of Babylon","Mesopotamia",SIG_GLOBAL));
    vec_push(v,evt_new("Bronze Age Collapse",(0-1177),"Bronze Age",CAT_COLLAPSE,"Widespread societal collapse across the Eastern Mediterranean","Mesopotamia;Ancient Egypt;Ancient Greece",SIG_CONTINENTAL));
    vec_push(v,evt_new("Battle of Kadesh",(0-1274),"Bronze Age",CAT_WAR,"Major chariot battle between Egypt and the Hittites in modern Syria","Ancient Egypt;Hittite Empire",SIG_CONTINENTAL));
    vec_push(v,evt_new("Trojan War",(0-1180),"Bronze Age",CAT_WAR,"Legendary conflict between Mycenaean Greeks and the city of Troy","Ancient Greece",SIG_REGIONAL));
