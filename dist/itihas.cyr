    _json_sep(sb); _json_int(sb, "end_year", load64(p+SITE_END));
    _json_sep(sb); _json_int(sb, "discovered", load64(p+SITE_DISC));
    _json_sep(sb); _json_str(sb, "description", load64(p+SITE_DESC));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

