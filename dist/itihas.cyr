}

fn all_events() {
    if (evt_init_done == 0) { evt_vec = build_events(); evt_init_done = 1; }
    return evt_vec;
}
fn event_count() { return vec_len(all_events()); }

fn events_by_category(cat) {
    var result = vec_new();
    var v = all_events(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (evt_cat(p) == cat) { vec_push(result, p); }
    }
    return result;
}

fn events_at_year(year) {
    var result = vec_new();
    var v = all_events(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (evt_year(p) == year) { vec_push(result, p); }
    }
    return result;
}

fn _cmp_evt_year(a, b) { return load64(a+EVT_YEAR) - load64(b+EVT_YEAR); }

fn events_between(sy, ey) {
    var result = vec_new();
    var v = all_events(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (evt_year(p) >= sy && evt_year(p) <= ey) { vec_push(result, p); }
    }
    vec_sort(result, &_cmp_evt_year);
    return result;
}

fn events_by_significance(sig) {
    var result = vec_new();
    var v = all_events(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (evt_sig(p) == sig) { vec_push(result, p); }
    }
    return result;
}

fn event_by_name(name: Str) {
    var v = all_events(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq_lower(evt_name(p), name) == 1) { return p; }
    }
    return 0;
}

# --- causality.cyr ---

# itihas — causal links (13)

enum CausalStrength { STRENGTH_WEAK; STRENGTH_MODERATE; STRENGTH_STRONG; STRENGTH_DIRECT; }
enum CausOff { CAUS_CAUSE=0; CAUS_EFFECT=8; CAUS_STR=16; CAUS_DESC=24; CAUS_SIZE=32; }

var caus_vec = 0;
var caus_init_done = 0;

fn caus_new(cause: Str, effect: Str, str, desc: Str) {
    var p = alloc(CAUS_SIZE);
    store64(p+CAUS_CAUSE,cause); store64(p+CAUS_EFFECT,effect);
    store64(p+CAUS_STR,str); store64(p+CAUS_DESC,desc);
    return p;
}
fn caus_cause(p) { return load64(p+CAUS_CAUSE); }
fn caus_effect(p) { return load64(p+CAUS_EFFECT); }

fn build_causalities() {
    var v = vec_new();
    vec_push(v, caus_new("Invention of Writing","Code of Hammurabi",STRENGTH_STRONG,"Written law codes required writing systems"));
    vec_push(v, caus_new("Bronze Age Collapse","Founding of Rome",STRENGTH_MODERATE,"Power vacuum allowed new Mediterranean polities"));
    vec_push(v, caus_new("Battle of Marathon","Conquests of Alexander the Great",STRENGTH_MODERATE,"Greek survival enabled rise of Macedon"));
    vec_push(v, caus_new("Conquests of Alexander the Great","Maurya Empire under Ashoka",STRENGTH_MODERATE,"Alexander destabilized the Nanda dynasty"));
    vec_push(v, caus_new("Fall of the Western Roman Empire","Rise of Islam",STRENGTH_WEAK,"Byzantine-Sassanid exhaustion enabled Islam's expansion"));
    vec_push(v, caus_new("Rise of Islam","Mongol Conquests",STRENGTH_WEAK,"Islamic caliphates drew Mongol expansion westward"));
    vec_push(v, caus_new("Mongol Conquests","Fall of Constantinople",STRENGTH_MODERATE,"Mongol disruption empowered Ottoman Turks"));
    vec_push(v, caus_new("Fall of Constantinople","French Revolution",STRENGTH_WEAK,"Accelerated Renaissance and Enlightenment ideals"));
    vec_push(v, caus_new("Gutenberg Printing Press","French Revolution",STRENGTH_STRONG,"Mass printing spread Enlightenment ideas"));
    vec_push(v, caus_new("French Revolution","Invention of the World Wide Web",STRENGTH_WEAK,"Open knowledge ideals influenced info-sharing tech"));
    vec_push(v, caus_new("Invention of Writing","Gutenberg Printing Press",STRENGTH_STRONG,"Printing mechanized written text reproduction"));
    vec_push(v, caus_new("Code of Hammurabi","Founding of Rome",STRENGTH_WEAK,"Legal code traditions influenced Roman law"));
    vec_push(v, caus_new("Gutenberg Printing Press","Invention of the World Wide Web",STRENGTH_STRONG,"Printing democratized information; web is successor"));
    return v;
}

fn all_causalities() {
    if (caus_init_done == 0) { caus_vec = build_causalities(); caus_init_done = 1; }
    return caus_vec;
}
fn causality_count() { return vec_len(all_causalities()); }

fn causes_of(event_name: Str) {
    var result = vec_new();
    var v = all_causalities(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq(caus_effect(p), event_name) == 1) { vec_push(result, p); }
    }
    return result;
}

fn effects_of(event_name: Str) {
    var result = vec_new();
    var v = all_causalities(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq(caus_cause(p), event_name) == 1) { vec_push(result, p); }
    }
    return result;
}

# BFS causal chain: returns vec of [name_str, depth] pairs stored as 16-byte entries
enum ChainOff { CH_NAME=0; CH_DEPTH=8; CH_SIZE=16; }

fn causal_chain(event_name: Str, max_depth) {
    var results = vec_new();
    var visited = vec_new();
    var frontier = vec_new();
    vec_push(visited, event_name);

    # Seed with direct effects
    var eff = effects_of(event_name);
    var en = vec_len(eff);
    for (var i = 0; i < en; i = i + 1) {
        var link = vec_get(eff, i);
        var ename = caus_effect(link);
        var already = 0;
        var vn = vec_len(visited);
        for (var j = 0; j < vn; j = j + 1) {
            if (str_eq(vec_get(visited, j), ename) == 1) { already = 1; }
        }
        if (already == 0) {
            vec_push(visited, ename);
            var entry = alloc(CH_SIZE);
            store64(entry + CH_NAME, ename);
            store64(entry + CH_DEPTH, 1);
            vec_push(results, entry);
            if (1 < max_depth) { vec_push(frontier, entry); }
        }
    }

    # Process frontier
    var fi = 0;
    while (fi < vec_len(frontier)) {
        var curr = vec_get(frontier, fi);
        fi = fi + 1;
        var cdepth = load64(curr + CH_DEPTH);
        if (cdepth >= max_depth) { continue; }
        var eff2 = effects_of(load64(curr + CH_NAME));
        var en2 = vec_len(eff2);
        for (var k = 0; k < en2; k = k + 1) {
            var link2 = vec_get(eff2, k);
            var ename2 = caus_effect(link2);
            var already2 = 0;
            var vn2 = vec_len(visited);
            for (var m = 0; m < vn2; m = m + 1) {
                if (str_eq(vec_get(visited, m), ename2) == 1) { already2 = 1; }
            }
            if (already2 == 0) {
                vec_push(visited, ename2);
                var entry2 = alloc(CH_SIZE);
                store64(entry2 + CH_NAME, ename2);
                store64(entry2 + CH_DEPTH, cdepth + 1);
                vec_push(results, entry2);
                if (cdepth + 1 < max_depth) { vec_push(frontier, entry2); }
            }
        }
    }
    return results;
}

fn chain_entry_name(p) { return load64(p + CH_NAME); }
fn chain_entry_depth(p) { return load64(p + CH_DEPTH); }

# --- interaction.cyr ---

# itihas — civilization interactions (22)

enum InteractionType { INT_TRADE; INT_WAR; INT_CULTURAL; INT_ALLIANCE; INT_CONQUEST; INT_DIPLOMACY; }
enum IntOff { INT_CIVA=0; INT_CIVB=8; INT_TYPE=16; INT_START=24; INT_END=32; INT_DESC=40; INT_SIZE=48; }

var int_vec = 0;
var int_init_done = 0;

fn int_new(ca: Str, cb: Str, itype, sy, ey, desc: Str) {
    var p = alloc(INT_SIZE);
    store64(p+INT_CIVA,ca); store64(p+INT_CIVB,cb); store64(p+INT_TYPE,itype);
    store64(p+INT_START,sy); store64(p+INT_END,ey); store64(p+INT_DESC,desc);
    return p;
}
fn int_civa(p) { return load64(p+INT_CIVA); }
fn int_civb(p) { return load64(p+INT_CIVB); }
fn int_type(p) { return load64(p+INT_TYPE); }

fn build_interactions() {
    var v = vec_new();
    vec_push(v, int_new("Mesopotamia","Ancient Egypt",INT_TRADE,(0-3000),(0-1200),"Trade in lapis lazuli, copper, grain"));
    vec_push(v, int_new("Mesopotamia","Indus Valley",INT_TRADE,(0-2600),(0-1900),"Maritime trade via Persian Gulf"));
    vec_push(v, int_new("Ancient Egypt","Hittite Empire",INT_WAR,(0-1400),(0-1259),"Battle of Kadesh and first peace treaty"));
    vec_push(v, int_new("Ancient Egypt","Hittite Empire",INT_DIPLOMACY,(0-1259),(0-1178),"Peace treaty and royal marriages"));
    vec_push(v, int_new("Ancient Greece","Persian Empire",INT_WAR,(0-499),(0-449),"Greco-Persian Wars"));
    vec_push(v, int_new("Ancient Greece","Ancient Egypt",INT_CULTURAL,(0-650),(0-30),"Greek adoption of Egyptian knowledge"));
    vec_push(v, int_new("Roman Empire","Ancient China",INT_TRADE,(0-130),200,"Silk Road trade"));
    vec_push(v, int_new("Roman Empire","Ancient Greece",INT_CONQUEST,(0-146),(0-146),"Roman conquest of Greece"));
    vec_push(v, int_new("Roman Empire","Phoenicia",INT_CONQUEST,(0-264),(0-146),"Punic Wars"));
    vec_push(v, int_new("Byzantine Empire","Ottoman Empire",INT_WAR,1299,1453,"Fall of Constantinople"));
    vec_push(v, int_new("Mongol Empire","Ancient China",INT_CONQUEST,1211,1279,"Mongol conquest establishing Yuan"));
    vec_push(v, int_new("Mongol Empire","Persian Empire",INT_CONQUEST,1219,1258,"Sack of Baghdad"));
    vec_push(v, int_new("Mali Empire","Arab Caliphates",INT_TRADE,1235,1500,"Trans-Saharan gold and salt trade"));
    vec_push(v, int_new("Viking/Norse","Byzantine Empire",INT_TRADE,800,1100,"Varangian trade routes"));
    vec_push(v, int_new("Khmer Empire","Ancient China",INT_CULTURAL,802,1431,"Chinese cultural influence"));
    vec_push(v, int_new("Chola Dynasty","Srivijaya",INT_WAR,1025,1025,"Chola naval raids"));
    vec_push(v, int_new("Spanish Empire","Aztec Empire",INT_CONQUEST,1519,1521,"Spanish conquest under Cortes"));
    vec_push(v, int_new("Spanish Empire","Inca Empire",INT_CONQUEST,1532,1572,"Spanish conquest under Pizarro"));
    vec_push(v, int_new("Portuguese Empire","Kingdom of Kongo",INT_TRADE,1483,1700,"Ivory, copper trade"));
    vec_push(v, int_new("Ottoman Empire","Republic of Venice",INT_TRADE,1400,1700,"Mediterranean spice trade"));
    vec_push(v, int_new("Ancient Egypt","Hittite Empire",INT_ALLIANCE,(0-1259),(0-1178),"Alliance after Treaty of Kadesh"));
    return v;
}

fn all_interactions() {
    if (int_init_done == 0) { int_vec = build_interactions(); int_init_done = 1; }
    return int_vec;
}
fn interaction_count() { return vec_len(all_interactions()); }

fn interactions_for(civ: Str) {
    var result = vec_new();
    var v = all_interactions(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq(int_civa(p), civ) == 1 || str_eq(int_civb(p), civ) == 1) { vec_push(result, p); }
    }
    return result;
}

fn interactions_between(ca: Str, cb: Str) {
    var result = vec_new();
    var v = all_interactions(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if ((str_eq(int_civa(p),ca)==1 && str_eq(int_civb(p),cb)==1) || (str_eq(int_civa(p),cb)==1 && str_eq(int_civb(p),ca)==1)) {
            vec_push(result, p);
        }
    }
    return result;
}

fn interactions_by_type(itype) {
    var result = vec_new();
    var v = all_interactions(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (int_type(p) == itype) { vec_push(result, p); }
    }
    return result;
}

fn interaction_neighbors(civ: Str) {
    var result = vec_new();
    var v = all_interactions(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        var neighbor = 0;
        if (str_eq(int_civa(p), civ) == 1) { neighbor = int_civb(p); }
        elif (str_eq(int_civb(p), civ) == 1) { neighbor = int_civa(p); }
        if (neighbor != 0) {
            var dup = 0;
            var rn = vec_len(result);
            for (var j = 0; j < rn; j = j + 1) {
                if (str_eq(vec_get(result, j), neighbor) == 1) { dup = 1; }
            }
            if (dup == 0) { vec_push(result, neighbor); }
        }
    }
    return result;
}

fn influence_score(ca: Str, cb: Str) {
    var btw = interactions_between(ca, cb);
    var score = 0;
    var n = vec_len(btw);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(btw, i);
        var t = int_type(p);
        if (t == INT_CONQUEST) { score = score + 4; }
        elif (t == INT_WAR) { score = score + 3; }
        elif (t == INT_ALLIANCE) { score = score + 3; }
        elif (t == INT_TRADE) { score = score + 2; }
        elif (t == INT_CULTURAL) { score = score + 2; }
        elif (t == INT_DIPLOMACY) { score = score + 1; }
    }
    return score;
}

# Split a ", "-delimited region string into a vec of trimmed Str parts
# e.g. "Near East, Europe" → ["Near East", "Europe"]
fn split_regions(region_str) {
    var parts = vec_new();
    var slen = str_len(region_str);
    var sd = str_data(region_str);
    var start = 0;
    var si = 0;
    while (si < slen) {
        # Look for ", " (comma + space)
        if (si + 1 < slen && load8(sd + si) == 44 && load8(sd + si + 1) == 32) {
            if (si > start) {
                vec_push(parts, str_new(sd + start, si - start));
            }
            si = si + 2;
            start = si;
        } else {
            si = si + 1;
        }
    }
    if (start < slen) {
        vec_push(parts, str_new(sd + start, slen - start));
    }
    return parts;
}

# Geographic proximity score between two civilizations (0-100)
# 100 = identical region strings, 50-99 = shared region components, 0 = no overlap
fn region_proximity(ca: Str, cb: Str) {
    var civ_a = civ_by_name(ca);
    var civ_b = civ_by_name(cb);
    if (civ_a == 0 || civ_b == 0) { return 0; }

    var reg_a = civ_region(civ_a);
    var reg_b = civ_region(civ_b);

    # Exact match
    if (str_eq(reg_a, reg_b) == 1) { return 100; }

    # Split and count shared components
    var parts_a = split_regions(reg_a);
    var parts_b = split_regions(reg_b);
    var na = vec_len(parts_a);
    var nb = vec_len(parts_b);

    var overlap = 0;
    for (var i = 0; i < na; i = i + 1) {
        var pa = vec_get(parts_a, i);
        for (var j = 0; j < nb; j = j + 1) {
            if (str_eq(pa, vec_get(parts_b, j)) == 1) { overlap = overlap + 1; }
        }
    }

    if (overlap == 0) { return 0; }

    var total = na;
    if (nb > na) { total = nb; }

    # Scale to 50-99 range
    return 50 + (overlap * 49) / total;
}

# --- campaign.cyr ---

# itihas — military campaigns (14 campaigns, 40+ battles)

enum CampaignOutcome { OUT_VICTORY; OUT_DEFEAT; OUT_STALEMATE; OUT_TREATY; OUT_INCONCLUSIVE; }
enum CampOff { CAMP_NAME=0; CAMP_REGION=8; CAMP_START=16; CAMP_END=24; CAMP_BELLA=32; CAMP_BELLB=40; CAMP_CMDS=48; CAMP_BATTLES=56; CAMP_OUT=64; CAMP_DESC=72; CAMP_SIZE=80; }
enum BatOff { BAT_NAME=0; BAT_YEAR=8; BAT_LOC=16; BAT_DESC=24; BAT_SIZE=32; }

var camp_vec = 0;
var camp_init_done = 0;

fn camp_new(name: Str, region: Str, sy, ey, ba: Str, bb: Str, cmds: Str, out, desc: Str) {
    var p = alloc(CAMP_SIZE);
    store64(p+CAMP_NAME,name); store64(p+CAMP_REGION,region);
    store64(p+CAMP_START,sy); store64(p+CAMP_END,ey);
    store64(p+CAMP_BELLA,ba); store64(p+CAMP_BELLB,bb); store64(p+CAMP_CMDS,cmds);
    store64(p+CAMP_BATTLES,vec_new()); store64(p+CAMP_OUT,out); store64(p+CAMP_DESC,desc);
    return p;
}
fn camp_name(p) { return load64(p+CAMP_NAME); }
fn camp_region(p) { return load64(p+CAMP_REGION); }
fn camp_out(p) { return load64(p+CAMP_OUT); }
fn camp_cmds(p) { return load64(p+CAMP_CMDS); }
fn camp_bella(p) { return load64(p+CAMP_BELLA); }
fn camp_bellb(p) { return load64(p+CAMP_BELLB); }

fn bat_add(camp, name: Str, year, loc: Str, desc: Str) {
    var b = alloc(BAT_SIZE);
    store64(b+BAT_NAME,name); store64(b+BAT_YEAR,year);
    store64(b+BAT_LOC,loc); store64(b+BAT_DESC,desc);
    vec_push(load64(camp+CAMP_BATTLES), b);
}

fn build_campaigns() {
    var v = vec_new();
    var c = camp_new("Greco-Persian Wars","Mediterranean",(0-499),(0-449),"Persian Empire","Ancient Greece","Darius I;Xerxes I;Themistocles;Leonidas I",OUT_DEFEAT,"Persian attempts to conquer Greece repelled; secured Greek independence and Classical golden age");
    bat_add(c,"Battle of Marathon",(0-490),"Marathon, Greece","Athenian hoplites defeat Persian invasion force on the plain of Marathon");
    bat_add(c,"Battle of Thermopylae",(0-480),"Thermopylae, Greece","Leonidas and 300 Spartans delay Xerxes' army at the narrow pass");
    bat_add(c,"Battle of Salamis",(0-480),"Salamis, Greece","Greek fleet destroys Persian navy in the straits; turning point of the war");
    bat_add(c,"Battle of Plataea",(0-479),"Plataea, Greece","Combined Greek army defeats Persian land forces, ending the invasion");
    vec_push(v, c);
    c = camp_new("Campaigns of Alexander the Great","Near East",(0-334),(0-323),"Macedon","Persian Empire","Alexander the Great;Darius III",OUT_VICTORY,"Macedonian conquest of the Persian Empire; created Hellenistic world from Greece to India");
    bat_add(c,"Battle of Granicus",(0-334),"Granicus River, Anatolia","Alexander's first major victory; opens Anatolia to Macedonian conquest");
    bat_add(c,"Battle of Issus",(0-333),"Issus, Cilicia","Alexander defeats Darius III; captures the Persian royal family");
    bat_add(c,"Battle of Gaugamela",(0-331),"Gaugamela, Mesopotamia","Decisive defeat of Darius III; Alexander becomes master of the Persian Empire");
    bat_add(c,"Battle of the Hydaspes",(0-326),"Hydaspes River, Punjab","Alexander defeats King Porus; easternmost extent of the campaign");
    vec_push(v, c);
    c = camp_new("Second Punic War","Mediterranean",(0-218),(0-201),"Carthage","Roman Republic","Hannibal Barca;Scipio Africanus",OUT_DEFEAT,"Hannibal's invasion of Italy via the Alps; despite tactical genius, Carthage ultimately lost to Roman strategic depth");
    bat_add(c,"Battle of Cannae",(0-216),"Cannae, Italy","Hannibal's double envelopment destroys 8 Roman legions; worst Roman defeat");
    bat_add(c,"Battle of Zama",(0-202),"Zama, North Africa","Scipio defeats Hannibal in Africa; ends the war and Carthaginian power");
    vec_push(v, c);
    c = camp_new("Gallic Wars","Europe",(0-58),(0-50),"Roman Republic","Gaul","Julius Caesar;Vercingetorix",OUT_VICTORY,"Roman conquest of Gaul; extended Roman territory to the Rhine and English Channel");
    bat_add(c,"Battle of Alesia",(0-52),"Alesia, Gaul","Caesar's double circumvallation traps Vercingetorix; Gaul surrenders");
    vec_push(v, c);
    c = camp_new("Muslim Conquest of Iberia","Europe",711,718,"Arab Caliphates","Visigothic Kingdom","Tariq ibn Ziyad;Musa ibn Nusayr;Roderic",OUT_VICTORY,"Umayyad conquest of Visigothic Iberia; established Al-Andalus for nearly 800 years");
    bat_add(c,"Battle of Guadalete",711,"Guadalete, Iberia","Umayyad forces defeat Visigothic King Roderic; opens Iberia to Muslim rule");
    bat_add(c,"Battle of Covadonga",718,"Covadonga, Asturias","Pelayo's victory; seeds of the Reconquista and the Kingdom of Asturias");
    vec_push(v, c);
    c = camp_new("Mongol Invasion of Khwarezmia","Central Asia",1219,1221,"Mongol Empire","Khwarezmian Empire","Genghis Khan;Muhammad II of Khwarezm",OUT_VICTORY,"Mongol destruction of the Khwarezmian Empire; opened Central Asia and Persia to Mongol rule");
    bat_add(c,"Siege of Bukhara",1220,"Bukhara, Central Asia","Mongols capture and sack Bukhara; demonstrates speed of Mongol advance");
    bat_add(c,"Siege of Samarkand",1220,"Samarkand, Central Asia","Largest city in Khwarezmia falls; Mongol Empire expands into Islamic world");
    vec_push(v, c);
    c = camp_new("Hundred Years' War","Europe",1337,1453,"Kingdom of England","Kingdom of France","Edward III;Henry V;Joan of Arc",OUT_DEFEAT,"English dynastic claim to the French throne; ended with French victory and English expulsion from continental France");
    bat_add(c,"Battle of Crecy",1346,"Crecy, France","English longbowmen devastate French cavalry; demonstrates ranged warfare supremacy");
    bat_add(c,"Battle of Agincourt",1415,"Agincourt, France","Henry V's outnumbered English army defeats French; peak of English success");
    bat_add(c,"Siege of Orleans",1429,"Orleans, France","Joan of Arc lifts the siege; turning point leading to French recovery");
    vec_push(v, c);
    c = camp_new("Ottoman Conquest of Constantinople","Near East",1453,1453,"Ottoman Empire","Byzantine Empire","Mehmed II;Constantine XI",OUT_VICTORY,"Ottoman capture of Constantinople; ended the Byzantine Empire and established Ottoman control of the Bosphorus");
    bat_add(c,"Siege of Constantinople",1453,"Constantinople","53-day siege; Mehmed's massive cannons breach the Theodosian Walls; end of the Roman state");
    vec_push(v, c);
    c = camp_new("Spanish Conquest of the Aztec Empire","Mesoamerica",1519,1521,"Spanish Empire","Aztec Empire","Hernan Cortes;Montezuma II;Cuauhtemoc",OUT_VICTORY,"Spanish conquest of the Aztec Empire with indigenous allies; smallpox and siege warfare destroyed Tenochtitlan");
    bat_add(c,"La Noche Triste",1520,"Tenochtitlan, Mexico","Spanish retreat from Tenochtitlan with heavy losses; Aztec tactical victory");
    bat_add(c,"Siege of Tenochtitlan",1521,"Tenochtitlan, Mexico","75-day siege; Spanish and indigenous allies destroy the Aztec capital");
    vec_push(v, c);
    c = camp_new("Thirty Years' War","Europe",1618,1648,"Holy Roman Empire;Spanish Empire","Kingdom of France;Sweden","Gustavus Adolphus;Albrecht von Wallenstein;Cardinal Richelieu",OUT_TREATY,"Religious and political war devastating Central Europe; ended by the Peace of Westphalia establishing state sovereignty");
    bat_add(c,"Battle of Breitenfeld",1631,"Breitenfeld, Saxony","Gustavus Adolphus' Swedish army defeats Imperial forces; demonstrates mobile artillery tactics");
    bat_add(c,"Battle of Lutzen",1632,"Lutzen, Saxony","Swedish victory but Gustavus Adolphus killed; shifted momentum of the war");
    bat_add(c,"Battle of Rocroi",1643,"Rocroi, France","French victory ends Spanish military supremacy; beginning of French dominance");
    vec_push(v, c);
    c = camp_new("Napoleonic Wars","Europe",1803,1815,"French Empire","British Empire;Russian Empire;Austrian Empire","Napoleon Bonaparte;Duke of Wellington;Mikhail Kutuzov",OUT_DEFEAT,"French bid for European hegemony; reshaped borders, spread revolutionary ideals, ended with Napoleon's exile");
    bat_add(c,"Battle of Austerlitz",1805,"Austerlitz, Moravia","Napoleon's masterpiece; defeats combined Austro-Russian army on the anniversary of his coronation");
    bat_add(c,"Battle of Trafalgar",1805,"Cape Trafalgar, Spain","Nelson destroys Franco-Spanish fleet; secures British naval supremacy");
    bat_add(c,"Battle of Borodino",1812,"Borodino, Russia","Bloodiest single day of the Napoleonic Wars; Pyrrhic French victory before Moscow");
    bat_add(c,"Battle of Waterloo",1815,"Waterloo, Belgium","Wellington and Blucher defeat Napoleon; ends the Napoleonic era");
    vec_push(v, c);
    c = camp_new("American Civil War","North America",1861,1865,"United States (Union)","Confederate States","Ulysses S. Grant;William T. Sherman;Robert E. Lee;Stonewall Jackson",OUT_VICTORY,"Union victory preserving the United States and abolishing slavery; deadliest American conflict");
    bat_add(c,"Battle of Gettysburg",1863,"Gettysburg, Pennsylvania","Turning point; Lee's invasion of the North repelled with massive casualties");
    bat_add(c,"Siege of Vicksburg",1863,"Vicksburg, Mississippi","Grant captures the last Confederate stronghold on the Mississippi; splits the Confederacy");
    vec_push(v, c);
    c = camp_new("Zulu War","Sub-Saharan Africa",1879,1879,"British Empire","Zulu Kingdom","Lord Chelmsford;Cetshwayo kaMpande",OUT_VICTORY,"British conquest of the Zulu Kingdom; ended Zulu military power despite early British defeats");
    bat_add(c,"Battle of Isandlwana",1879,"Isandlwana, Zululand","Zulu army overruns British camp; worst British defeat against an indigenous force");
    bat_add(c,"Battle of Rorke's Drift",1879,"Rorke's Drift, Zululand","150 British soldiers repel 3,000-4,000 Zulu warriors at a mission station");
    bat_add(c,"Battle of Ulundi",1879,"Ulundi, Zululand","British defeat the Zulu army and burn the royal kraal; ends Zulu independence");
    vec_push(v, c);
    c = camp_new("Russo-Japanese War","East Asia",1904,1905,"Japan","Russian Empire","Togo Heihachiro;Nogi Maresuke;Aleksei Kuropatkin",OUT_VICTORY,"Decisive Japanese victory over Russia; Treaty of Portsmouth; first modern Asian victory over a European empire");
    bat_add(c,"Siege of Port Arthur",1904,"Port Arthur, Manchuria","Prolonged Japanese siege of Russian naval base; foreshadows trench warfare");
    bat_add(c,"Battle of Tsushima",1905,"Tsushima Strait","Japanese fleet annihilates Russian Baltic Fleet; first modern naval victory by an Asian power over a European one");
    vec_push(v, c);
    return v;
}

fn all_campaigns() {
    if (camp_init_done == 0) { camp_vec = build_campaigns(); camp_init_done = 1; }
    return camp_vec;
}
fn campaign_count() { return vec_len(all_campaigns()); }

fn campaign_by_name(name: Str) {
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq_lower(camp_name(p), name) == 1) { return p; }
    }
    return 0;
}

fn campaigns_by_region(region: Str) {
    var result = vec_new();
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(camp_region(p), region) == 1) { vec_push(result, p); }
    }
    return result;
}

fn campaigns_by_outcome(outcome) {
    var result = vec_new();
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (camp_out(p) == outcome) { vec_push(result, p); }
    }
    return result;
}

fn campaigns_by_commander(cmd: Str) {
    var result = vec_new();
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(camp_cmds(p), cmd) == 1) { vec_push(result, p); }
    }
    return result;
}

fn campaigns_by_civilization(civ: Str) {
    var result = vec_new();
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(camp_bella(p), civ) == 1 || str_contains(camp_bellb(p), civ) == 1) { vec_push(result, p); }
    }
    return result;
}

fn campaigns_active_at(year) {
    var result = vec_new();
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (year >= load64(p+CAMP_START) && year <= load64(p+CAMP_END)) { vec_push(result, p); }
    }
    return result;
}

fn _cmp_camp_start(a, b) { return load64(a+CAMP_START) - load64(b+CAMP_START); }

fn campaigns_between(sy, ey) {
    var result = vec_new();
    var v = all_campaigns(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (load64(p+CAMP_START) <= ey && load64(p+CAMP_END) >= sy) { vec_push(result, p); }
    }
    vec_sort(result, &_cmp_camp_start);
    return result;
}

# --- site.cyr ---

# itihas — archaeological sites (32)

enum SiteType { ST_SETTLEMENT; ST_TEMPLE; ST_BURIAL; ST_FORTRESS; ST_MONUMENT; ST_PALACE; ST_WORKSHOP; ST_CAVE; ST_PORT; }
enum SiteOff { SITE_NAME=0; SITE_LOC=8; SITE_REG=16; SITE_TYPE=24; SITE_CIV=32; SITE_START=40; SITE_END=48; SITE_DISC=56; SITE_DESC=64; SITE_SIZE=72; }

var site_vec = 0;
var site_init_done = 0;

fn site_new(name: Str, loc: Str, reg: Str, st, civ: Str, sy, ey, disc, desc: Str) {
    var p = alloc(SITE_SIZE);
    store64(p+SITE_NAME,name); store64(p+SITE_LOC,loc); store64(p+SITE_REG,reg);
    store64(p+SITE_TYPE,st); store64(p+SITE_CIV,civ);
    store64(p+SITE_START,sy); store64(p+SITE_END,ey); store64(p+SITE_DISC,disc); store64(p+SITE_DESC,desc);
    return p;
}
fn site_name(p) { return load64(p+SITE_NAME); }
fn site_region(p) { return load64(p+SITE_REG); }

fn build_sites() {
    var v = vec_new();
    vec_push(v, site_new("Gobekli Tepe","Turkey","Near East",ST_TEMPLE,"Pre-Pottery Neolithic",(0-9500),(0-8000),1963,"Oldest known monumental sanctuary; massive T-shaped pillars with animal reliefs"));
    vec_push(v, site_new("Catalhoyuk","Turkey","Near East",ST_SETTLEMENT,"Neolithic Anatolia",(0-7500),(0-5700),1958,"Large Neolithic proto-city; densely packed mudbrick houses entered through rooftops"));
    vec_push(v, site_new("Ur","Iraq","Near East",ST_SETTLEMENT,"Mesopotamia",(0-3800),(0-500),1853,"Sumerian city-state; Royal Tombs with rich grave goods, Great Ziggurat"));
    vec_push(v, site_new("Babylon","Iraq","Near East",ST_SETTLEMENT,"Mesopotamia",(0-2300),(0-275),1899,"Capital of Babylonian Empire; Ishtar Gate, Hanging Gardens tradition"));
    vec_push(v, site_new("Persepolis","Iran","Near East",ST_PALACE,"Persian Empire",(0-518),(0-330),1620,"Ceremonial capital of the Achaemenid Empire; Apadana reliefs of tribute-bearers"));
    vec_push(v, site_new("Petra","Jordan","Near East",ST_SETTLEMENT,"Nabataean Kingdom",(0-312),663,1812,"Rock-cut Nabataean capital; Al-Khazneh treasury facade, water conduit system"));
    vec_push(v, site_new("Giza","Egypt","North Africa",ST_MONUMENT,"Ancient Egypt",(0-2580),(0-2510),0,"Great Pyramid of Khufu, Sphinx; Old Kingdom royal necropolis"));
    vec_push(v, site_new("Valley of the Kings","Egypt","North Africa",ST_BURIAL,"Ancient Egypt",(0-1539),(0-1075),1738,"New Kingdom royal tombs including Tutankhamun's tomb (KV62)"));
    vec_push(v, site_new("Carthage","Tunisia","North Africa",ST_PORT,"Phoenicia",(0-814),(0-146),1830,"Phoenician maritime capital; circular military harbor, tophet sanctuary"));
    vec_push(v, site_new("Leptis Magna","Libya","North Africa",ST_SETTLEMENT,"Roman Empire",(0-1000),647,1920,"Roman city; Severan basilica, market, theater, and harbor"));
    vec_push(v, site_new("Knossos","Greece","Mediterranean",ST_PALACE,"Minoan Civilization",(0-2000),(0-1375),1878,"Minoan palace complex; labyrinthine layout, bull-leap frescoes, Linear A/B tablets"));
    vec_push(v, site_new("Mycenae","Greece","Mediterranean",ST_FORTRESS,"Mycenaean Civilization",(0-1600),(0-1100),1876,"Mycenaean citadel; Lion Gate, Treasury of Atreus, Schliemann's gold masks"));
    vec_push(v, site_new("Pompeii","Italy","Mediterranean",ST_SETTLEMENT,"Roman Empire",(0-600),79,1748,"Roman city preserved by Vesuvius eruption; complete urban snapshot of 79 CE"));
    vec_push(v, site_new("Mohenjo-daro","Pakistan","South Asia",ST_SETTLEMENT,"Indus Valley",(0-2500),(0-1900),1922,"Indus Valley city; Great Bath, grid-plan streets, standardized brick construction"));
    vec_push(v, site_new("Harappa","Pakistan","South Asia",ST_SETTLEMENT,"Indus Valley",(0-2600),(0-1900),1826,"Indus Valley city; granaries, worker quarters, and extensive craft production"));
    vec_push(v, site_new("Sanchi","India","South Asia",ST_TEMPLE,"Maurya Empire",(0-300),1200,1818,"Buddhist stupa complex; Great Stupa with carved gateways (toranas)"));
    vec_push(v, site_new("Ajanta Caves","India","South Asia",ST_CAVE,"Gupta Empire",(0-200),650,1819,"Rock-cut Buddhist monasteries and prayer halls; masterwork murals and sculpture"));
    vec_push(v, site_new("Terracotta Army","China","East Asia",ST_BURIAL,"Ancient China",(0-246),(0-208),1974,"Mausoleum guard of Qin Shi Huang; 8,000+ life-size clay warriors"));
    vec_push(v, site_new("Longmen Grottoes","China","East Asia",ST_TEMPLE,"Ancient China",493,1127,0,"Buddhist rock-cut shrines; 100,000+ statues across 2,345 caves"));
    vec_push(v, site_new("Nara Heijo Palace","Japan","East Asia",ST_PALACE,"Japan",710,784,1852,"Imperial capital; modeled on Tang Chang'an, wooden palace complex"));
    vec_push(v, site_new("Angkor Wat","Cambodia","Southeast Asia",ST_TEMPLE,"Khmer Empire",1113,1431,1860,"Largest religious monument; Hindu-Buddhist temple with bas-relief galleries"));
    vec_push(v, site_new("Borobudur","Indonesia","Southeast Asia",ST_TEMPLE,"Sailendra Dynasty",780,1006,1814,"Largest Buddhist temple; 2,672 relief panels, 504 Buddha statues"));
    vec_push(v, site_new("Teotihuacan","Mexico","Mesoamerica",ST_SETTLEMENT,"Teotihuacan Civilization",(0-200),550,0,"Largest pre-Columbian city in the Americas; Pyramid of the Sun, Avenue of the Dead"));
    vec_push(v, site_new("Tikal","Guatemala","Mesoamerica",ST_SETTLEMENT,"Maya",(0-600),900,1848,"Major Maya city; towering temple pyramids, stelae with Long Count dates"));
    vec_push(v, site_new("Chichen Itza","Mexico","Mesoamerica",ST_TEMPLE,"Maya",600,1200,1843,"Maya-Toltec city; El Castillo pyramid with equinox serpent shadow"));
    vec_push(v, site_new("Machu Picchu","Peru","South America",ST_SETTLEMENT,"Inca Empire",1450,1572,1911,"Inca royal estate; dry-stone terraces, Intihuatana sundial, cloud-forest setting"));
    vec_push(v, site_new("Great Zimbabwe","Zimbabwe","Sub-Saharan Africa",ST_SETTLEMENT,"Kingdom of Zimbabwe",1100,1450,1871,"Medieval stone city; Great Enclosure with drystone walls up to 11m high"));
    vec_push(v, site_new("Lalibela","Ethiopia","Sub-Saharan Africa",ST_TEMPLE,"Zagwe Dynasty",1181,1221,1520,"11 monolithic rock-hewn churches; carved top-down from living rock"));
    vec_push(v, site_new("Stonehenge","England","Europe",ST_MONUMENT,"Neolithic Britain",(0-3000),(0-1500),0,"Megalithic stone circle; sarsen trilithons aligned to solstice sunrise"));
    vec_push(v, site_new("Lascaux","France","Europe",ST_CAVE,"Upper Paleolithic",(0-17000),(0-15000),1940,"Paleolithic cave paintings; Hall of Bulls, polychrome animal figures"));
    vec_push(v, site_new("Altamira","Spain","Europe",ST_CAVE,"Upper Paleolithic",(0-36000),(0-13000),1868,"Paleolithic cave art; polychrome bison ceiling, earliest known artistic masterwork"));
    vec_push(v, site_new("Newgrange","Ireland","Europe",ST_BURIAL,"Neolithic Ireland",(0-3200),(0-2900),1699,"Passage tomb; roof box aligned to winter solstice sunrise illuminating chamber"));
    return v;
}

fn all_sites() {
    if (site_init_done == 0) { site_vec = build_sites(); site_init_done = 1; }
    return site_vec;
}
fn site_count() { return vec_len(all_sites()); }

fn sites_by_region(region: Str) {
    var result = vec_new();
    var v = all_sites(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(site_region(p), region) == 1) { vec_push(result, p); }
    }
    return result;
}

fn sites_by_type(stype) {
    var result = vec_new();
    var v = all_sites(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (load64(p+SITE_TYPE) == stype) { vec_push(result, p); }
    }
    return result;
}

fn sites_by_civilization(civ: Str) {
    var result = vec_new();
    var v = all_sites(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(load64(p+SITE_CIV), civ) == 1) { vec_push(result, p); }
    }
    return result;
}

fn sites_active_at(year) {
    var result = vec_new();
    var v = all_sites(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (year >= load64(p+SITE_START) && year <= load64(p+SITE_END)) { vec_push(result, p); }
    }
    return result;
}

fn site_by_name(name: Str) {
    var v = all_sites(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq_lower(site_name(p), name) == 1) { return p; }
    }
    return 0;
}

# --- trade.cyr ---

# itihas — trade routes (15)

enum RouteType { RT_LAND; RT_MARITIME; RT_RIVER; RT_MIXED; }
enum RouteOff { RT_NAME=0; RT_REGIONS=8; RT_TYPE=16; RT_CIVS=24; RT_COMM=32; RT_START=40; RT_END=48; RT_DESC=56; RT_SIZE=64; }

var route_vec = 0;
var route_init_done = 0;

fn rt_new(name: Str, regions: Str, rtype, civs: Str, comm: Str, sy, ey, desc: Str) {
    var p = alloc(RT_SIZE);
    store64(p+RT_NAME,name); store64(p+RT_REGIONS,regions); store64(p+RT_TYPE,rtype);
    store64(p+RT_CIVS,civs); store64(p+RT_COMM,comm);
    store64(p+RT_START,sy); store64(p+RT_END,ey); store64(p+RT_DESC,desc);
    return p;
}
fn rt_name(p) { return load64(p+RT_NAME); }
fn rt_comm(p) { return load64(p+RT_COMM); }

fn build_routes() {
    var v = vec_new();
    vec_push(v, rt_new("Silk Road","East Asia;Central Asia;Near East;Mediterranean",RT_LAND,"Ancient China;Persian Empire;Roman Empire;Mongol Empire","silk;spices;jade;glass;paper",(0-130),1453,"Trans-Eurasian overland network linking Chang'an to Constantinople; primary conduit for silk, ideas, and religions"));
    vec_push(v, rt_new("Maritime Silk Road","East Asia;Southeast Asia;South Asia;Near East;East Africa",RT_MARITIME,"Ancient China;Gupta Empire;Khmer Empire;Arab Caliphates","silk;porcelain;spices;incense;ivory",(0-200),1500,"Sea route from South China Sea through Indian Ocean to Red Sea; monsoon-driven seasonal trade"));
    vec_push(v, rt_new("Incense Route","Arabian Peninsula;Near East;Mediterranean",RT_LAND,"Nabataean Kingdom;Kingdom of Saba","frankincense;myrrh;spices",(0-1000),200,"Caravan route from southern Arabia (Dhofar, Hadramaut) to Gaza and Petra; frankincense and myrrh trade"));
    vec_push(v, rt_new("Amber Road","Europe;Mediterranean",RT_LAND,"Roman Empire;Germanic Tribes","amber;furs;salt",(0-1600),500,"Baltic-to-Mediterranean overland route; Baltic amber traded south for Roman manufactured goods"));
    vec_push(v, rt_new("Trans-Saharan Trade","North Africa;Sub-Saharan Africa",RT_LAND,"Ghana Empire;Mali Empire;Songhai Empire;Arab Caliphates","gold;salt;slaves;ivory;textiles",300,1600,"Camel caravan routes across Sahara linking West African gold to Mediterranean markets; salt-gold exchange powered by camel domestication"));
    vec_push(v, rt_new("Spice Route","Southeast Asia;South Asia;Near East;Mediterranean;Europe",RT_MARITIME,"Gupta Empire;Arab Caliphates;Portuguese Empire;Dutch Republic","pepper;cinnamon;cloves;nutmeg;cardamom",(0-300),1800,"Indian Ocean maritime network for spice trade; Malabar Coast, Strait of Malacca, Moluccas"));
    vec_push(v, rt_new("Tin Route","Europe;Mediterranean",RT_MIXED,"Phoenicia;Ancient Greece;Roman Empire","tin;copper;bronze goods",(0-2500),(0-100),"Cornish and Iberian tin shipped to Mediterranean bronze-producing centers; essential for Bronze Age metallurgy"));
    vec_push(v, rt_new("Via Maris","Near East;North Africa",RT_LAND,"Ancient Egypt;Mesopotamia;Persian Empire","grain;olive oil;textiles;metals",(0-2000),(0-300),"Ancient coastal road from Egypt through Levant to Mesopotamia; major military and commercial artery"));
    vec_push(v, rt_new("Hanseatic Trade Network","Europe",RT_MARITIME,"Hanseatic League","herring;timber;furs;grain;wool",1200,1669,"North and Baltic Sea trade network; merchant guild alliance controlling northern European commerce"));
    vec_push(v, rt_new("Nile Trade Route","North Africa;Sub-Saharan Africa",RT_RIVER,"Ancient Egypt;Kingdom of Kush","gold;ivory;ebony;grain;papyrus",(0-3100),640,"Nile River corridor linking Upper and Lower Egypt to Nubia and Kush; annual flood cycle enabling agriculture and transport"));
    vec_push(v, rt_new("Grand Trunk Road","South Asia;Central Asia",RT_LAND,"Maurya Empire;Gupta Empire;Mughal Empire","textiles;spices;gemstones;horses",(0-300),2147483647,"South Asia's great trunk road from Kabul to Chittagong; rebuilt by Sher Shah Suri, still in use"));
    vec_push(v, rt_new("Austronesian Maritime Network","Southeast Asia;Oceania;East Africa",RT_MARITIME,"Austronesian Peoples","obsidian;pottery;cinnamon;coconut",(0-3000),1500,"Open-ocean trade spanning Taiwan to Madagascar; earliest long-distance maritime exchange network"));
    vec_push(v, rt_new("Varangian Trade Routes","Europe;Near East",RT_RIVER,"Viking Civilization;Byzantine Empire;Arab Caliphates","furs;slaves;amber;silver;swords",750,1100,"Norse river routes via Dnieper and Volga connecting Scandinavia to Constantinople and Baghdad"));
    vec_push(v, rt_new("Triangular Trade","Europe;West Africa;Americas",RT_MARITIME,"British Empire;Portuguese Empire;Spanish Empire","slaves;sugar;rum;cotton;manufactured goods",1500,1867,"Atlantic triangular exchange: European goods to Africa, enslaved people to Americas, plantation commodities to Europe"));
    vec_push(v, rt_new("Tea-Horse Road","East Asia;South Asia",RT_LAND,"Ancient China;Tibet","tea;horses;salt;medicinal herbs",600,1950,"Sichuan-to-Tibet caravan trail; Chinese tea exchanged for Tibetan war horses across Himalayan passes"));
    return v;
}

fn all_routes() {
    if (route_init_done == 0) { route_vec = build_routes(); route_init_done = 1; }
    return route_vec;
}
fn route_count() { return vec_len(all_routes()); }

fn route_by_name(name: Str) {
    var v = all_routes(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq_lower(rt_name(p), name) == 1) { return p; }
    }
    return 0;
}

fn routes_by_commodity(comm: Str) {
    var result = vec_new();
    var v = all_routes(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(rt_comm(p), comm) == 1) { vec_push(result, p); }
    }
    return result;
}

fn routes_by_region(region: Str) {
    var result = vec_new();
    var v = all_routes(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(load64(p+RT_REGIONS), region) == 1) { vec_push(result, p); }
    }
    return result;
}

fn routes_by_type(rtype) {
    var result = vec_new();
    var v = all_routes(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (load64(p+RT_TYPE) == rtype) { vec_push(result, p); }
    }
    return result;
}

fn routes_by_civilization(civ: Str) {
    var result = vec_new();
    var v = all_routes(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(load64(p+RT_CIVS), civ) == 1) { vec_push(result, p); }
    }
    return result;
}

fn routes_active_at(year) {
    var result = vec_new();
    var v = all_routes(); var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (year >= load64(p+RT_START) && year <= load64(p+RT_END)) { vec_push(result, p); }
    }
    return result;
}

# --- logging.cyr ---

# itihas — structured logging via sakshi
# Equivalent to Rust's logging module (ITIHAS_LOG env-based init)
# sakshi is auto-included via cyrius.cyml [deps] stdlib (so the distlib
# bundle resolves SK_INFO from the consumer's stdlib, not a stripped include).

fn itihas_log_init() {
    sakshi_set_level(SK_INFO);
    return 0;
}

fn itihas_log_init_level(level) {
    sakshi_set_level(level);
    return 0;
}

# --- serial.cyr ---

# serial.cyr — JSON serialization for all itihas types
# Uses str_builder from stdlib. Requires json.cyr for json_pair_new/json_build.

# ----------------------------------------------------------------
# JSON string escaping helper
# ----------------------------------------------------------------
fn _json_str(sb, key, val: Str) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\": \"");
    # Escape backslashes, quotes, newlines in val
    var vlen = str_len(val);
    var vd = str_data(val);
    var ji = 0;
    while (ji < vlen) {
        var c = load8(vd + ji);
        if (c == 34) { str_builder_add_cstr(sb, "\\\""); }
        else { if (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
        else { if (c == 10) { str_builder_add_cstr(sb, "\\n"); }
        else { str_builder_add_byte(sb, c); } } }
        ji = ji + 1;
    }
    str_builder_add_cstr(sb, "\"");
    return 0;
}

fn _json_int(sb, key, val) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\": ");
    str_builder_add_int(sb, val);
    return 0;
}

fn _json_sep(sb) { str_builder_add_cstr(sb, ", "); return 0; }

# ----------------------------------------------------------------
# Era
# ----------------------------------------------------------------
fn era_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+ERA_NAME));
    _json_sep(sb); _json_int(sb, "start_year", load64(p+ERA_START));
    _json_sep(sb); _json_int(sb, "end_year", load64(p+ERA_END));
    _json_sep(sb); _json_str(sb, "region", load64(p+ERA_REGION));
    _json_sep(sb); _json_str(sb, "description", load64(p+ERA_DESC));
    _json_sep(sb); _json_int(sb, "category", load64(p+ERA_CAT));
    _json_sep(sb); _json_int(sb, "scope", load64(p+ERA_SCOPE));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# ----------------------------------------------------------------
# Civilization
# ----------------------------------------------------------------
fn civ_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+CIV_NAME));
    _json_sep(sb); _json_str(sb, "region", load64(p+CIV_REGION));
    _json_sep(sb); _json_str(sb, "peak_era", load64(p+CIV_PEAK));
    _json_sep(sb); _json_int(sb, "founded", load64(p+CIV_FOUND));
    _json_sep(sb); _json_int(sb, "ended", load64(p+CIV_END));
    _json_sep(sb); _json_str(sb, "traits", load64(p+CIV_TRAITS));
    _json_sep(sb); _json_str(sb, "script", load64(p+CIV_SCRIPT));
    _json_sep(sb); _json_str(sb, "language", load64(p+CIV_LANG));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# ----------------------------------------------------------------
# Event
# ----------------------------------------------------------------
fn event_to_json(p) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+EVT_NAME));
    _json_sep(sb); _json_int(sb, "year", load64(p+EVT_YEAR));
    _json_sep(sb); _json_str(sb, "era", load64(p+EVT_ERA));
    _json_sep(sb); _json_int(sb, "category", load64(p+EVT_CAT));
    _json_sep(sb); _json_str(sb, "description", load64(p+EVT_DESC));
    _json_sep(sb); _json_str(sb, "civilizations", load64(p+EVT_CIVS));
    _json_sep(sb); _json_int(sb, "significance", load64(p+EVT_SIG));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# ----------------------------------------------------------------
# Figure
