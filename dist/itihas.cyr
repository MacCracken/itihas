    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+CAL_NAME));
    _json_sep(sb); _json_int(sb, "type", load64(p+CAL_TYPE));
    _json_sep(sb); _json_int(sb, "epoch", load64(p+CAL_EPOCH));
    _json_sep(sb); _json_int(sb, "months", load64(p+CAL_MONTHS));
    _json_sep(sb); _json_str(sb, "leap", load64(p+CAL_LEAP));
    str_builder_add_cstr(sb, "}");
