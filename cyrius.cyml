[package]
name = "itihas"
version = "${file:VERSION}"
description = "Itihas — structured world history: civilizations, eras, events, figures, campaigns, sites, trade routes, calendars"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.2.11"
repository = "https://github.com/MacCracken/itihas"

[build]
entry = "src/main.cyr"
output = "build/itihas"

[lib]
# `cyrius distlib` reads this section to build dist/itihas.cyr — the single
# bundle consumers (sankhya, avatara, kiran, joshua, jnana, lipi, vidya)
# include. Order matches src/lib.cyr's include order; lib.cyr itself is last.
modules = [
    "src/util.cyr",
    "src/error.cyr",
    "src/era.cyr",
    "src/calendar.cyr",
    "src/civilization.cyr",
    "src/figure.cyr",
    "src/event.cyr",
    "src/causality.cyr",
    "src/interaction.cyr",
    "src/campaign.cyr",
    "src/site.cyr",
    "src/trade.cyr",
    "src/logging.cyr",
    "src/serial.cyr",
    "src/hoosh.cyr",
    "src/lib.cyr",
]

[deps]
# net + http: hoosh ships a self-contained HTTP client (raw syscalls + net's
# sockaddr_in) for independent use — load-bearing, do not remove.
# tagged: needed transitively (sakshi + net use Result).
# bayan: the data-format stdlib carve (cyrius 6.1.25) moved json/toml/csv/base64/
# bigint out of the stdlib into the bayan sibling, folded back as lib/bayan.cyr.
# itihas's hoosh tool-call parsing uses json_parse/json_get (bayan compat aliases
# for bayan_json_*). Replaces the former standalone "json" dep, which no longer
# exists. result + io are bayan's internal prereqs.
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "assert", "tagged", "result", "io", "fnptr", "bench", "net", "http", "bayan", "sakshi"]
