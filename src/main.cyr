# itihas — Structured World History v2.3.4
# 10 data modules, ported from 8846 lines of Rust
#
# This is the library smoke test / binary entry point. It loads every data
# module and checks core invariants, exiting non-zero on gross failure.
# The full 153-assertion suite lives in tests/itihas.tcyr (`cyrius test`);
# benchmarks in tests/itihas.bcyr (`cyrius bench`).

# Stdlib auto-included via cyrius.cyml

include "src/util.cyr"
include "src/error.cyr"
include "src/era.cyr"
include "src/calendar.cyr"
include "src/civilization.cyr"
include "src/figure.cyr"
include "src/event.cyr"
include "src/causality.cyr"
include "src/interaction.cyr"
include "src/campaign.cyr"
include "src/site.cyr"
include "src/trade.cyr"
include "src/logging.cyr"
include "src/serial.cyr"
include "src/hoosh.cyr"

alloc_init();

# Total entity count across all 10 data modules.
var total = era_count() + calendar_count() + civ_count() + figure_count()
    + event_count() + causality_count() + interaction_count()
    + campaign_count() + site_count() + route_count();

syscall(SYS_WRITE, 1, "itihas: ", 8);
print_num(total);
println(" entities across 10 modules");

# Smoke invariants: every module populated and core lookups resolve.
var failed = 0;
if (era_count() < 25) { failed = 1; }
if (civ_count() < 53) { failed = 1; }
if (event_count() < 105) { failed = 1; }
if (era_by_name("Bronze Age") == 0) { failed = 1; }
if (civ_by_name("Roman Empire") == 0) { failed = 1; }
if (vec_len(events_at_year(476)) == 0) { failed = 1; }

if (failed != 0) {
    println("smoke: FAIL — run `cyrius test tests/itihas.tcyr` for detail");
    syscall(SYS_EXIT, 1);
}
println("smoke: OK (full suite: cyrius test tests/itihas.tcyr)");
syscall(SYS_EXIT, 0);
