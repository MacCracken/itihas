# serial.cyr — JSON serialization for all itihas types, and decoders for the
# three record types other libraries embed (era, civilization, event).
# Uses str_builder from stdlib, json_escape_into from util.cyr, and bayan's
# value tree (bayan_json_v_*) on the decode side.

# ----------------------------------------------------------------
# JSON string escaping helper
# ----------------------------------------------------------------
fn _json_str(sb, key, val: Str) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\": \"");
    # Full RFC 8259 escaping lives in util.cyr — shared with hoosh's request
    # builder. The local copy this replaced handled only " \ and LF, so a TAB
    # or CR in a caller-supplied string emitted raw and produced invalid JSON.
    json_escape_into(sb, val);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

fn _json_int(sb, key, val) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\": ");
    str_builder_add_int(sb, val);
    return 0;
}

fn _json_sep(sb) { str_builder_add_cstr(sb, ", "); return 0; }

# ----------------------------------------------------------------
# Arrays
# ----------------------------------------------------------------
# Lived in hoosh.cyr until the _to_json_into split; it is a serialization
# primitive, and mcp.cyr uses it too, so it belongs beside the record writers.
# Appends the array to a caller-supplied builder. `into_fn` is an
# `X_to_json_into` from serial.cyr, so each record is written straight into `sb`
# — the older shape called `X_to_json`, which built a private builder and a
# finished Str per record, then copied every byte a second time.
fn _json_array_into(sb, v, into_fn) {
    str_builder_add_cstr(sb, "[");
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_add_cstr(sb, ", "); }
        fncall2(into_fn, sb, vec_get(v, i));
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

fn _json_array(v, into_fn) {
    var sb = str_builder_new();
    _json_array_into(sb, v, into_fn);
    return str_builder_build(sb);
}

# ----------------------------------------------------------------
# Decoding
# ----------------------------------------------------------------
# era_from_json, civ_from_json and event_from_json read back exactly what
# era_to_json_into, civ_to_json_into and event_to_json_into write: the same
# keys, enum fields as their integer codes, list fields as the `;`-joined
# strings. So encode -> decode -> encode is byte-identical for every record.
#
# Input is a node of bayan's value tree (what bayan_json_v_parse returns), so a
# consumer can decode records inside a document it has already parsed. The
# *_from_json_text wrappers parse JSON text first.
#
# Output is a 6.6 value-form Result: Ok(record), a new record built with
# era_new / civ_new / evt_new, or Err(ItihasErr) carrying ITIHAS_ERR_DESERIALIZE
# and a message in serde_json's wording, as the Rust 1.x derive reported it:
#   invalid type: string "x", expected i32
#   invalid type: floating point `5.0`, expected i32
#   invalid value: integer `3000000000`, expected i32
#   invalid value: integer `9`, expected variant index 0 <= i < 6
#   missing field `name`
#   duplicate field `name`
#   invalid type: sequence, expected struct Era
# serde_json appends " at line L column C"; bayan's tree keeps no positions, so
# the messages stop before it.
#
# The checks are the ones serde's derive made on the Rust 1.x types:
#   - the input must be an object; unknown keys are ignored;
#   - every field is required, and a repeated field is refused (bayan's parser
#     already refuses a repeated key in text, so this catches a tree built in
#     code with bayan_json_v_obj_set);
#   - a year must be a JSON integer that fits i32 (5.0 and 1e3 are floats);
#   - an enum field must be an integer code inside its enum;
#   - a string field must be a JSON string (null is not one).
# Fields are visited in document order, as serde does, so the first bad field
# in the document is the one reported; missing fields are reported after, in
# declaration order. Nothing is checked beyond the types: an era ending before
# it starts decodes, as it did in Rust.
#
# The record's Str fields are the tree's own decoded strings, borrowed rather
# than copied. Keep the tree for as long as the record, which the default
# allocator does; a tree parsed into an arena that is later reset takes the
# record's strings with it.

# Err(ItihasErr{ITIHAS_ERR_DESERIALIZE, msg}).
fn _json_de_fail(msg: Str) { return itihas_fail(ITIHAS_ERR_DESERIALIZE, msg); }

# Append serde's description of the unexpected JSON value `v`: null, boolean
# `true`, integer `5`, floating point `1.5`, string "x", sequence, map. A
# missing node (v == 0) reads as null.
fn _json_de_unexpected_into(sb, v) {
    var t = bayan_json_v_tag(v);
    if (t == JTAG_BOOL) {
        if (bayan_json_v_bool(v) != 0) { return str_builder_add_cstr(sb, "boolean `true`"); }
        return str_builder_add_cstr(sb, "boolean `false`");
    }
    if (t == JTAG_INT) {
        str_builder_add_cstr(sb, "integer `");
        str_builder_add_int(sb, bayan_json_v_int(v));
        return str_builder_add_cstr(sb, "`");
    }
    if (t == JTAG_FLOAT) {
        # bayan_f64_to_json writes 5.0 as "5.0", as serde's Unexpected::Float does.
        var fb[48];
        var flen = bayan_f64_to_json(bayan_json_v_float(v), &fb);
        str_builder_add_cstr(sb, "floating point `");
        str_builder_add(sb, str_new(&fb, flen));
        return str_builder_add_cstr(sb, "`");
    }
    if (t == JTAG_STR) {
        str_builder_add_cstr(sb, "string ");
        return str_builder_add_json_str(sb, bayan_json_v_str(v));
    }
    if (t == JTAG_ARR) { return str_builder_add_cstr(sb, "sequence"); }
    if (t == JTAG_OBJ) { return str_builder_add_cstr(sb, "map"); }
    return str_builder_add_cstr(sb, "null");
}

# Err "invalid type: <what v is>, expected <exp>" (exp is a C string).
fn _json_de_invalid_type(v, exp) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "invalid type: ");
    _json_de_unexpected_into(sb, v);
    str_builder_add_cstr(sb, ", expected ");
    str_builder_add_cstr(sb, exp);
    return _json_de_fail(str_builder_build(sb));
}

# Ok(v) when v is a JSON object, else Err "invalid type: ..., expected struct <name>".
#must_use
fn _json_de_struct(v, name) {
    if (bayan_json_v_is_obj(v) == 1) { return Ok(v); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "invalid type: ");
    _json_de_unexpected_into(sb, v);
    str_builder_add_cstr(sb, ", expected struct ");
    str_builder_add_cstr(sb, name);
    return _json_de_fail(str_builder_build(sb));
}

# Ok(Str) when v is a JSON string, else Err "invalid type: ..., expected a string".
#must_use
fn _json_de_str(v) {
    if (bayan_json_v_is_str(v) == 1) { return Ok(bayan_json_v_str(v)); }
    return _json_de_invalid_type(v, "a string");
}

# Ok(n) when v is a JSON integer in lo..hi, else Err. A float, even a whole one,
# is "invalid type"; an integer outside the range is "invalid value". `count` picks
# the expected text: 0 for a year ("i32"), else the enum's variant count
# ("variant index 0 <= i < count", serde_derive's wording for a variant index).
# bayan refuses an integer that overflows i64 at parse time, so `n` is exact.
#must_use
fn _json_de_int(v, lo, hi, count) {
    if (bayan_json_v_is_int(v) == 1) {
        var n = bayan_json_v_int(v);
        if (n >= lo && n <= hi) { return Ok(n); }
    }
    var sb = str_builder_new();
    if (bayan_json_v_is_int(v) == 1) {
        str_builder_add_cstr(sb, "invalid value: integer `");
        str_builder_add_int(sb, bayan_json_v_int(v));
        str_builder_add_cstr(sb, "`");
    } else {
        str_builder_add_cstr(sb, "invalid type: ");
        _json_de_unexpected_into(sb, v);
    }
    str_builder_add_cstr(sb, ", expected ");
    if (count == 0) { str_builder_add_cstr(sb, "i32"); }
    else {
        str_builder_add_cstr(sb, "variant index 0 <= i < ");
        str_builder_add_int(sb, count);
    }
    return _json_de_fail(str_builder_build(sb));
}

# Ok(year) when v is a JSON integer that fits the Rust field's i32.
#must_use
fn _json_de_i32(v) { return _json_de_int(v, 0 - 2147483648, 2147483647, 0); }

# Ok(code) when v is a JSON integer naming one of an enum's `count` variants.
#must_use
fn _json_de_code(v, count) { return _json_de_int(v, 0, count - 1, count); }

# The field names in `list` (a C string of space-separated names) as a vec of
# Strs, in declaration order. Each Str borrows the literal's bytes.
#must_use
fn _json_de_keys(list) {
    var v = vec_new();
    var n = strlen(list);
    var i = 0;
    while (i < n) {
        var j = i;
        while (j < n && load8(list + j) != 32) { j = j + 1; }
        vec_push(v, str_new(list + i, j - i));
        i = j + 1;
    }
    return v;
}

# Index of object key `k` (a Str) in `keys`, or -1 for a key the record does not
# have. `hint` is tried first: the writers emit fields in declaration order, so
# in their own output pair i is field i and the scan stops at the first compare.
#must_use
fn _json_de_key(keys, k, hint) {
    if (k == 0) { return 0 - 1; }
    var n = vec_len(keys);
    if (hint < n) {
        if (str_eq(vec_get(keys, hint), k) == 1) { return hint; }
    }
    for (var j = 0; j < n; j = j + 1) {
        if (j != hint) {
            if (str_eq(vec_get(keys, j), k) == 1) { return j; }
        }
    }
    return 0 - 1;
}

# Err "<what> field `<name>`", what being "missing" or "duplicate".
fn _json_de_field_err(what, keys, f) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, " field `");
    str_builder_add(sb, vec_get(keys, f));
    str_builder_add_cstr(sb, "`");
    return _json_de_fail(str_builder_build(sb));
}

# Err "missing field `<name>`" for the first field, in declaration order, whose
# bit is clear in the `seen` mask.
fn _json_de_missing(keys, seen) {
    var n = vec_len(keys);
    var f = 0;
    while (f < n) {
        if ((seen & (1 << f)) == 0) { return _json_de_field_err("missing", keys, f); }
        f = f + 1;
    }
    return _json_de_field_err("missing", keys, 0);
}

# Ok(node) for JSON text `js` (a Str), or Err "malformed JSON: <bayan's reason>
# at byte N". bayan refuses trailing content after the value, as serde_json does.
#must_use
fn _json_de_parse(js: Str) {
    var v = bayan_json_v_parse(js);
    if (v != 0) { return Ok(v); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "malformed JSON: ");
    str_builder_add_cstr(sb, bayan_json_last_error());
    str_builder_add_cstr(sb, " at byte ");
    str_builder_add_int(sb, bayan_json_last_error_pos());
    return _json_de_fail(str_builder_build(sb));
}

# ----------------------------------------------------------------
# Era
# ----------------------------------------------------------------
# Appends the object to a caller-supplied builder. era_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn era_to_json_into(sb, p) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", era_name(p));
    _json_sep(sb); _json_int(sb, "start_year", era_start(p));
    _json_sep(sb); _json_int(sb, "end_year", era_end(p));
    _json_sep(sb); _json_str(sb, "region", era_region(p));
    _json_sep(sb); _json_str(sb, "description", era_desc(p));
    _json_sep(sb); _json_int(sb, "category", era_cat(p));
    _json_sep(sb); _json_int(sb, "scope", era_scope(p));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The era as a JSON object (Str). era_to_json_into appends to a builder instead.
#must_use
fn era_to_json(p) {
    var sb = str_builder_new();
    era_to_json_into(sb, p);
    return str_builder_build(sb);
}

# era_to_json_into's keys, in the order it writes them. Built on first decode.
var _era_json_keys = 0;

# Decode an era from bayan value-tree node `v`: Ok(era), a new record from
# era_new, or Err(ItihasErr) with serde's message. Reads what era_to_json_into
# writes; see "Decoding" above for the checks.
#must_use
fn era_from_json(v) {
    var obj = _json_de_struct(v, "Era")?;
    if (_era_json_keys == 0) {
        _era_json_keys = _json_de_keys("name start_year end_year region description category scope");
    }
    var name = 0; var sy = 0; var ey = 0; var region = 0; var desc = 0; var cat = 0; var scope = 0;
    var seen = 0;
    var n = bayan_json_v_obj_len(obj);
    for (var i = 0; i < n; i = i + 1) {
        var f = _json_de_key(_era_json_keys, bayan_json_v_obj_key(obj, i), i);
        if (f < 0) { continue; }
        if ((seen & (1 << f)) != 0) { return _json_de_field_err("duplicate", _era_json_keys, f); }
        seen = seen | (1 << f);
        var x = bayan_json_v_obj_val(obj, i);
        if (f == 0) { name = _json_de_str(x)?; }
        elif (f == 1) { sy = _json_de_i32(x)?; }
        elif (f == 2) { ey = _json_de_i32(x)?; }
        elif (f == 3) { region = _json_de_str(x)?; }
        elif (f == 4) { desc = _json_de_str(x)?; }
        elif (f == 5) { cat = _json_de_code(x, CONTEMPORARY + 1)?; }
        else { scope = _json_de_code(x, SCOPE_REGIONAL + 1)?; }
    }
    if (seen != 127) { return _json_de_missing(_era_json_keys, seen); }
    return Ok(era_new(name, sy, ey, region, desc, cat, scope));
}

# era_from_json on JSON text `js` (a Str). A syntax error is an Err too.
#must_use
fn era_from_json_text(js: Str) {
    var v = _json_de_parse(js)?;
    return era_from_json(v);
}

# ----------------------------------------------------------------
# Civilization
# ----------------------------------------------------------------
# Appends the object to a caller-supplied builder. civ_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn civ_to_json_into(sb, p) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+CIV_NAME));
    _json_sep(sb); _json_str(sb, "region", load64(p+CIV_REGION));
    _json_sep(sb); _json_str(sb, "peak_era", load64(p+CIV_PEAK));
    _json_sep(sb); _json_int(sb, "founded", load64(p+CIV_FOUND));
    _json_sep(sb); _json_int(sb, "ended", load64(p+CIV_END));
    _json_sep(sb); _json_str(sb, "traits", load64(p+CIV_TRAITS));
    _json_sep(sb); _json_str(sb, "script", load64(p+CIV_SCRIPT));
    _json_sep(sb); _json_str(sb, "language", load64(p+CIV_LANG));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The civilization as a JSON object (Str). civ_to_json_into appends to a builder instead.
#must_use
fn civ_to_json(p) {
    var sb = str_builder_new();
    civ_to_json_into(sb, p);
    return str_builder_build(sb);
}

# civ_to_json_into's keys, in the order it writes them. Built on first decode.
var _civ_json_keys = 0;

# Decode a civilization from bayan value-tree node `v`: Ok(civilization), a new
# record from civ_new, or Err(ItihasErr) with serde's message. Reads what
# civ_to_json_into writes: `founded` / `ended` for the years, `traits` and
# `language` as `;`-joined strings. See "Decoding" above for the checks.
#must_use
fn civ_from_json(v) {
    var obj = _json_de_struct(v, "Civilization")?;
    if (_civ_json_keys == 0) {
        _civ_json_keys = _json_de_keys("name region peak_era founded ended traits script language");
    }
    var name = 0; var region = 0; var peak = 0; var fy = 0; var ey = 0;
    var traits = 0; var script = 0; var lang = 0;
    var seen = 0;
    var n = bayan_json_v_obj_len(obj);
    for (var i = 0; i < n; i = i + 1) {
        var f = _json_de_key(_civ_json_keys, bayan_json_v_obj_key(obj, i), i);
        if (f < 0) { continue; }
        if ((seen & (1 << f)) != 0) { return _json_de_field_err("duplicate", _civ_json_keys, f); }
        seen = seen | (1 << f);
        var x = bayan_json_v_obj_val(obj, i);
        if (f == 0) { name = _json_de_str(x)?; }
        elif (f == 1) { region = _json_de_str(x)?; }
        elif (f == 2) { peak = _json_de_str(x)?; }
        elif (f == 3) { fy = _json_de_i32(x)?; }
        elif (f == 4) { ey = _json_de_i32(x)?; }
        elif (f == 5) { traits = _json_de_str(x)?; }
        elif (f == 6) { script = _json_de_str(x)?; }
        else { lang = _json_de_str(x)?; }
    }
    if (seen != 255) { return _json_de_missing(_civ_json_keys, seen); }
    return Ok(civ_new(name, region, peak, fy, ey, traits, script, lang));
}

# civ_from_json on JSON text `js` (a Str). A syntax error is an Err too.
#must_use
fn civ_from_json_text(js: Str) {
    var v = _json_de_parse(js)?;
    return civ_from_json(v);
}

# ----------------------------------------------------------------
# Event
# ----------------------------------------------------------------
# Appends the object to a caller-supplied builder. event_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn event_to_json_into(sb, p) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+EVT_NAME));
    _json_sep(sb); _json_int(sb, "year", load64(p+EVT_YEAR));
    _json_sep(sb); _json_str(sb, "era", load64(p+EVT_ERA));
    _json_sep(sb); _json_int(sb, "category", load64(p+EVT_CAT));
    _json_sep(sb); _json_str(sb, "description", load64(p+EVT_DESC));
    _json_sep(sb); _json_str(sb, "civilizations", load64(p+EVT_CIVS));
    _json_sep(sb); _json_int(sb, "significance", load64(p+EVT_SIG));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The event as a JSON object (Str). event_to_json_into appends to a builder instead.
#must_use
fn event_to_json(p) {
    var sb = str_builder_new();
    event_to_json_into(sb, p);
    return str_builder_build(sb);
}

# event_to_json_into's keys, in the order it writes them. Built on first decode.
var _evt_json_keys = 0;

# Decode an event from bayan value-tree node `v`: Ok(event), a new record from
# evt_new, or Err(ItihasErr) with serde's message. Reads what event_to_json_into
# writes: `civilizations` as a `;`-joined string, the category and significance
# as their codes. See "Decoding" above for the checks.
#must_use
fn event_from_json(v) {
    var obj = _json_de_struct(v, "Event")?;
    if (_evt_json_keys == 0) {
        _evt_json_keys = _json_de_keys("name year era category description civilizations significance");
    }
    var name = 0; var year = 0; var era = 0; var cat = 0; var desc = 0; var civs = 0; var sig = 0;
    var seen = 0;
    var n = bayan_json_v_obj_len(obj);
    for (var i = 0; i < n; i = i + 1) {
        var f = _json_de_key(_evt_json_keys, bayan_json_v_obj_key(obj, i), i);
        if (f < 0) { continue; }
        if ((seen & (1 << f)) != 0) { return _json_de_field_err("duplicate", _evt_json_keys, f); }
        seen = seen | (1 << f);
        var x = bayan_json_v_obj_val(obj, i);
        if (f == 0) { name = _json_de_str(x)?; }
        elif (f == 1) { year = _json_de_i32(x)?; }
        elif (f == 2) { era = _json_de_str(x)?; }
        elif (f == 3) { cat = _json_de_code(x, CAT_COLLAPSE + 1)?; }
        elif (f == 4) { desc = _json_de_str(x)?; }
        elif (f == 5) { civs = _json_de_str(x)?; }
        else { sig = _json_de_code(x, SIG_GLOBAL + 1)?; }
    }
    if (seen != 127) { return _json_de_missing(_evt_json_keys, seen); }
    return Ok(evt_new(name, year, era, cat, desc, civs, sig));
}

# event_from_json on JSON text `js` (a Str). A syntax error is an Err too.
#must_use
fn event_from_json_text(js: Str) {
    var v = _json_de_parse(js)?;
    return event_from_json(v);
}

