# ----------------------------------------------------------------
# Calendar
# ----------------------------------------------------------------
# Appends the object to a caller-supplied builder. calendar_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn calendar_to_json_into(sb, p) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+CAL_NAME));
    _json_sep(sb); _json_int(sb, "type", load64(p+CAL_TYPE));
    _json_sep(sb); _json_int(sb, "epoch", load64(p+CAL_EPOCH));
    _json_sep(sb); _json_int(sb, "months", load64(p+CAL_MONTHS));
    _json_sep(sb); _json_str(sb, "leap", load64(p+CAL_LEAP));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The calendar as a JSON object (Str). calendar_to_json_into appends to a builder instead.
#must_use
fn calendar_to_json(p) {
    var sb = str_builder_new();
    calendar_to_json_into(sb, p);
    return str_builder_build(sb);
}

# ----------------------------------------------------------------
# Campaign (with nested battles array)
# ----------------------------------------------------------------
# Appends the object to a caller-supplied builder. battle_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn battle_to_json_into(sb, b) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(b+BAT_NAME));
    _json_sep(sb); _json_int(sb, "year", load64(b+BAT_YEAR));
    _json_sep(sb); _json_str(sb, "location", load64(b+BAT_LOC));
    _json_sep(sb); _json_str(sb, "description", load64(b+BAT_DESC));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The battle as a JSON object (Str). battle_to_json_into appends to a builder instead.
#must_use
fn battle_to_json(b) {
    var sb = str_builder_new();
    battle_to_json_into(sb, b);
    return str_builder_build(sb);
}

# Appends the object to a caller-supplied builder. campaign_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn campaign_to_json_into(sb, p) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+CAMP_NAME));
    _json_sep(sb); _json_str(sb, "region", load64(p+CAMP_REGION));
    _json_sep(sb); _json_int(sb, "start_year", load64(p+CAMP_START));
    _json_sep(sb); _json_int(sb, "end_year", load64(p+CAMP_END));
    _json_sep(sb); _json_str(sb, "belligerents_a", load64(p+CAMP_BELLA));
    _json_sep(sb); _json_str(sb, "belligerents_b", load64(p+CAMP_BELLB));
    _json_sep(sb); _json_str(sb, "commanders", load64(p+CAMP_CMDS));
    _json_sep(sb); _json_int(sb, "outcome", load64(p+CAMP_OUT));
    _json_sep(sb); _json_str(sb, "description", load64(p+CAMP_DESC));
    # Battles array
    _json_sep(sb);
    str_builder_add_cstr(sb, "\"battles\": [");
    var bats = load64(p+CAMP_BATTLES);
    var bn = vec_len(bats);
    for (var bi = 0; bi < bn; bi = bi + 1) {
        if (bi > 0) { str_builder_add_cstr(sb, ", "); }
        battle_to_json_into(sb, vec_get(bats, bi));
    }
    str_builder_add_cstr(sb, "]");
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The campaign, with its battles nested, as a JSON object (Str). campaign_to_json_into appends to a builder instead.
#must_use
fn campaign_to_json(p) {
    var sb = str_builder_new();
    campaign_to_json_into(sb, p);
    return str_builder_build(sb);
}

# ----------------------------------------------------------------
# Site
# ----------------------------------------------------------------
# Appends the object to a caller-supplied builder. site_to_json is the
# allocating wrapper; prefer this one when the result is going straight into
# another builder, which saves a throwaway Str and a second copy of every byte.
fn site_to_json_into(sb, p) {
    str_builder_add_cstr(sb, "{");
    _json_str(sb, "name", load64(p+SITE_NAME));
    _json_sep(sb); _json_str(sb, "location", load64(p+SITE_LOC));
    _json_sep(sb); _json_str(sb, "region", load64(p+SITE_REG));
    _json_sep(sb); _json_int(sb, "type", load64(p+SITE_TYPE));
    _json_sep(sb); _json_str(sb, "civilization", load64(p+SITE_CIV));
    _json_sep(sb); _json_int(sb, "start_year", load64(p+SITE_START));
    _json_sep(sb); _json_int(sb, "end_year", load64(p+SITE_END));
    _json_sep(sb); _json_int(sb, "discovered", load64(p+SITE_DISC));
    _json_sep(sb); _json_str(sb, "description", load64(p+SITE_DESC));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The site as a JSON object (Str); a never-lost site's discovery year is 0 (SITE_DISC_NONE).
# site_to_json_into appends to a builder instead.
#must_use
fn site_to_json(p) {
    var sb = str_builder_new();
    site_to_json_into(sb, p);
    return str_builder_build(sb);
}

