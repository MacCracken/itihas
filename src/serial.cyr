    _json_sep(sb); _json_int(sb, "domain", load64(p+FIG_DOM));
    _json_sep(sb); _json_str(sb, "description", load64(p+FIG_DESC));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# The figure as a JSON object (Str). figure_to_json_into appends to a builder instead.
