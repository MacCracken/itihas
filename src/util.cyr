# util.cyr — itihas utility functions
# Case conversion, comparison, and sorting helpers

# ----------------------------------------------------------------
# Checked allocation
# ----------------------------------------------------------------
# alloc() returns 0 on exhaustion rather than aborting, and every allocation
# site in itihas writes into the result immediately — a struct constructor
# store64s its fields, a buffer builder store8s its bytes. So an unchecked
# alloc under memory pressure is a write through a near-NULL pointer (CWE-690),
# which faults at an address that tells you nothing about where it came from.
#
# Aborting is deliberate, and follows the AGNOS policy avatara set in its
# ADR-009: it matches Rust and Go, whose allocators abort rather than return
# null, because a library cannot invent a recovery its caller did not ask for.
# Exit 134 is 128 + SIGABRT, the shell convention for "aborted".
#
# Use xalloc for any allocation whose failure has no local recovery. Where a
# caller CAN degrade meaningfully — hoosh's network buffers, which return a
# failure the caller already reports — check `alloc` explicitly instead.
#must_use
fn xalloc(n) {
    # A non-positive size is a CALLER bug, not exhaustion, and the stdlib
    # alloc() returns 0 for it — reporting that as "out of memory" would send
    # the reader hunting the wrong problem entirely.
    if (n <= 0) {
        var bad = "itihas: fatal - xalloc called with a non-positive size\n";
        syscall(SYS_WRITE, 2, bad, strlen(bad));
        syscall(SYS_EXIT, 134);
    }
    var p = alloc(n);
    if (p == 0) {
        var msg = "itihas: fatal - heap allocation failed (out of memory)\n";
        syscall(SYS_WRITE, 2, msg, strlen(msg));
        syscall(SYS_EXIT, 134);
    }
    return p;
}

# Convert Str to lowercase (ASCII only, allocates new)
#must_use
fn str_lower(s) {
    var slen = str_len(s);
    var sd = str_data(s);
    var buf = xalloc(slen + 1);
    var li = 0;
    while (li < slen) {
        var c = load8(sd + li);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        store8(buf + li, c);
        li = li + 1;
    }
    store8(buf + slen, 0);
    return str_new(buf, slen);
}

# Convert Str to uppercase (ASCII only, allocates new)
#must_use
fn str_upper(s) {
    var slen = str_len(s);
    var sd = str_data(s);
    var buf = xalloc(slen + 1);
    var ui = 0;
    while (ui < slen) {
        var c = load8(sd + ui);
        if (c >= 97) { if (c <= 122) { c = c - 32; } }
        store8(buf + ui, c);
        ui = ui + 1;
    }
    store8(buf + slen, 0);
    return str_new(buf, slen);
}

# Case-insensitive Str equality (ASCII)
#must_use
fn str_eq_lower(a: Str, b: Str) {
    var la = str_len(a);
    var lb = str_len(b);
    if (la != lb) { return 0; }
    var da = str_data(a);
    var db = str_data(b);
    var ei = 0;
    # Compare raw bytes first and fold only where they actually differ. Callers
    # nearly always pass the stored spelling, so the folding arithmetic is off
    # the hot path entirely; the previous form folded both bytes every
    # iteration whether or not it needed to.
    while (ei < la) {
        var ca = load8(da + ei);
        var cb = load8(db + ei);
        if (ca != cb) {
            if (ca >= 65) { if (ca <= 90) { ca = ca + 32; } }
            if (cb >= 65) { if (cb <= 90) { cb = cb + 32; } }
            if (ca != cb) { return 0; }
        }
        ei = ei + 1;
    }
    return 1;
}

# Sort vector in-place using comparison function pointer
# cmp(a, b) should return negative if a < b, 0 if equal, positive if a > b
# Insertion sort, kept deliberately: it is STABLE, and the sorted query results
# (events, campaigns, eras sharing a year) would reorder observably under
# lib/vec.cyr's introsort vec_sort_by, which is not.
#
# The inner loop indexes the backing store directly instead of paying a
# bounds-checked vec_get/vec_set per comparison; the indices are already
# bounded by len.
fn vec_sort(v, cmp) {
    var len = vec_len(v);
    if (len < 2) { return 0; }
    var data = load64(v);
    var si = 1;
    while (si < len) {
        var key = load64(data + si * 8);
        var j = si - 1;
        while (j >= 0) {
            var elem = load64(data + j * 8);
            if (fncall2(cmp, elem, key) <= 0) { break; }
            store64(data + (j + 1) * 8, elem);
            j = j - 1;
        }
        store64(data + (j + 1) * 8, key);
        si = si + 1;
    }
    return 0;
}

# ----------------------------------------------------------------
# Query tracing
# ----------------------------------------------------------------
# The Rust original emitted a `tracing::debug!` on entry to every query,
# carrying the lookup argument. The port kept the logging module but never
# called it from anything, so `itihas_log_init` set a level that nothing
# honoured and an operator had no way to see what a consumer was asking for.
#
# Each helper checks the level FIRST and returns before touching its arguments,
# so a build with logging off pays one call plus one compare per query — the
# argument is an integer or an already-materialised Str, never a construction.
# That matters because these sit on the 200-900 ns query paths the benchmark
# suite measures; see the CHANGELOG for the before/after.
#
# These live in util.cyr rather than logging.cyr because Cyrius resolves
# forward references single-pass and logging.cyr is included after the ten data
# modules that call them.

# Trace a query with one integer argument (a year, a depth, an enum tag).
fn itrace_i(msg, key, val) {
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    var b = xalloc(24);
    var n = fmt_int_buf(val, b);
    sakshi_log_kv(SK_DEBUG, msg, strlen(msg), key, strlen(key), b, n);
    return 0;
}

# Trace a query with one Str argument (a name, a region, a civilization).
fn itrace_s(msg, key, val: Str) {
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    sakshi_log_kv(SK_DEBUG, msg, strlen(msg), key, strlen(key), str_data(val), str_len(val));
    return 0;
}

# Trace a query over an integer RANGE, emitted as `start..end`.
fn itrace_range(msg, start, end) {
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    var sb = str_builder_new();
    str_builder_add_int(sb, start);
    str_builder_add_cstr(sb, "..");
    str_builder_add_int(sb, end);
    var v = str_builder_build(sb);
    sakshi_log_kv(SK_DEBUG, msg, strlen(msg), "range", 5, str_data(v), str_len(v));
    return 0;
}

# Trace a query over a PAIR of Str arguments, emitted as `a, b`.
fn itrace_pair(msg, key, a: Str, b: Str) {
    if (sakshi_get_level() < SK_DEBUG) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, a);
    str_builder_add_cstr(sb, ", ");
    str_builder_add(sb, b);
    var v = str_builder_build(sb);
    sakshi_log_kv(SK_DEBUG, msg, strlen(msg), key, strlen(key), str_data(v), str_len(v));
    return 0;
}

# ----------------------------------------------------------------
# JSON text helpers
# ----------------------------------------------------------------
# Append `val` to `sb` with RFC 8259 string escaping applied, WITHOUT the
# surrounding quotes (callers own those). Escapes the two mandatory characters
# (" and \\), the five shorthand control escapes (\b \t \n \f \r), and emits
# any remaining C0 control byte as \u00XX. Bytes >= 0x80 pass through verbatim,
# so well-formed UTF-8 input stays well-formed UTF-8 output.
#
# Shared by serial.cyr's _json_str and hoosh.cyr's request builder — both used
# to carry their own three-case copy, which silently emitted raw TAB/CR and
# produced invalid JSON.
fn json_escape_into(sb, val: Str) {
    var vlen = str_len(val);
    var vd = str_data(val);
    var i = 0;
    while (i < vlen) {
        var c = load8(vd + i);
        if (c == 34) { str_builder_add_cstr(sb, "\\\""); }
        else { if (c == 92) { str_builder_add_cstr(sb, "\\\\"); }
            else { if (c == 8)  { str_builder_add_cstr(sb, "\\b"); }
                else { if (c == 9)  { str_builder_add_cstr(sb, "\\t"); }
                    else { if (c == 10) { str_builder_add_cstr(sb, "\\n"); }
                        else { if (c == 12) { str_builder_add_cstr(sb, "\\f"); }
                            else { if (c == 13) { str_builder_add_cstr(sb, "\\r"); }
                                else { if (c >= 0 && c < 32) {
                                        # Remaining C0 controls have no shorthand — emit \u00XX.
                                        str_builder_add_cstr(sb, "\\u00");
                                        var hi = c / 16;
                                        var lo = c - hi * 16;
                                        if (hi < 10) { str_builder_add_byte(sb, 48 + hi); }
                                        else { str_builder_add_byte(sb, 87 + hi); }
                                        if (lo < 10) { str_builder_add_byte(sb, 48 + lo); }
                                        else { str_builder_add_byte(sb, 87 + lo); }
                                    }
                                    else { str_builder_add_byte(sb, c); } } } } } } } }
        i = i + 1;
    }
    return 0;
}

# Decode a JSON string body (the bytes BETWEEN the quotes) into a new Str.
# Inverse of json_escape_into for the escapes it produces. A \u escape is decoded to
# UTF-8 for the Basic Multilingual Plane; a surrogate half is emitted as U+FFFD
# rather than as raw bytes, so output is always valid UTF-8.
#
# Needed because a tool call's `arguments` arrives JSON-encoded-as-a-string on
# the OpenAI /v1/chat/completions wire shape, so the raw span is double-escaped
# and will not parse.
#must_use
fn json_unescape(s: Str): Str {
    var slen = str_len(s);
    var sd = str_data(s);
    var sb = str_builder_new();
    var i = 0;
    while (i < slen) {
        var c = load8(sd + i);
        if (c != 92) { str_builder_add_byte(sb, c); i = i + 1; }
        else {
            if (i + 1 >= slen) { str_builder_add_byte(sb, c); i = i + 1; }
            else {
                var e = load8(sd + i + 1);
                if (e == 34) { str_builder_add_byte(sb, 34); i = i + 2; }
                else { if (e == 92) { str_builder_add_byte(sb, 92); i = i + 2; }
                    else { if (e == 47) { str_builder_add_byte(sb, 47); i = i + 2; }
                        else { if (e == 98) { str_builder_add_byte(sb, 8);  i = i + 2; }
                            else { if (e == 116){ str_builder_add_byte(sb, 9);  i = i + 2; }
                                else { if (e == 110){ str_builder_add_byte(sb, 10); i = i + 2; }
                                    else { if (e == 102){ str_builder_add_byte(sb, 12); i = i + 2; }
                                        else { if (e == 114){ str_builder_add_byte(sb, 13); i = i + 2; }
                                            else { if (e == 117 && i + 5 < slen) {
                                                    var cp = _hex4(sd + i + 2);
                                                    if (cp < 0) { str_builder_add_byte(sb, c); i = i + 1; }
                                                    else {
                                                        _utf8_add(sb, cp);
                                                        i = i + 6;
                                                    }
                                                }
                                                else {
                                                    # Unknown escape — keep the backslash literally.
                                                    str_builder_add_byte(sb, c);
                                                    i = i + 1;
                                                } } } } } } } } }
            }
        }
    }
    return str_builder_build(sb);
}

# Parse exactly 4 hex digits at `p`. Returns the value, or -1 if any is invalid.
fn _hex4(p) {
    var v = 0;
    var k = 0;
    while (k < 4) {
        var d = load8(p + k);
        var nib = 0-1;
        if (d >= 48 && d <= 57)  { nib = d - 48; }
        if (d >= 97 && d <= 102) { nib = d - 87; }
        if (d >= 65 && d <= 70)  { nib = d - 55; }
        if (nib < 0) { return 0-1; }
        v = v * 16 + nib;
        k = k + 1;
    }
    return v;
}

# Append code point `cp` to `sb` as UTF-8. Lone surrogates become U+FFFD.
fn _utf8_add(sb, cp) {
    if (cp >= 0xD800 && cp <= 0xDFFF) { cp = 0xFFFD; }
    if (cp < 0x80) { str_builder_add_byte(sb, cp); return 0; }
    if (cp < 0x800) {
        str_builder_add_byte(sb, 0xC0 + cp / 64);
        str_builder_add_byte(sb, 0x80 + (cp - (cp / 64) * 64));
        return 0;
    }
    str_builder_add_byte(sb, 0xE0 + cp / 4096);
    var mid = cp / 64;
    str_builder_add_byte(sb, 0x80 + (mid - (cp / 4096) * 64));
    str_builder_add_byte(sb, 0x80 + (cp - mid * 64));
    return 0;
}

# ----------------------------------------------------------------
# Delimited-list membership
# ----------------------------------------------------------------
# Case-insensitive compare of `n` raw bytes at `pa` and `pb` (ASCII folding).
# Byte-range form so the list helpers below never allocate a temporary Str just
# to compare one token — str_new costs a 16-byte header per call, and these run
# once per record per query.
fn _ci_eq_bytes(pa, pb, n) {
    var i = 0;
    while (i < n) {
        var ca = load8(pa + i);
        var cb = load8(pb + i);
        if (ca != cb) {
            if (ca >= 65) { if (ca <= 90) { ca = ca + 32; } }
            if (cb >= 65) { if (cb <= 90) { cb = cb + 32; } }
            if (ca != cb) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# True when `needle` equals one whole `sep`-delimited token of `list`
# (case-insensitive). Replaces bare str_contains on the ';'-joined belligerent,
# commander, commodity and civilization fields, where a substring test matched
# across token boundaries: "Roman Empire" hit inside "Holy Roman Empire", and
# "Darius I" hit inside "Darius III".
#must_use
fn str_list_has(list: Str, needle: Str, sep) {
    var llen = str_len(list);
    var ld = str_data(list);
    var nlen = str_len(needle);
    if (nlen == 0) { return 0; }
    if (nlen > llen) { return 0; }
    var nd = str_data(needle);
    var start = 0;
    # Tight separator scan: one load8 and one compare per byte. The earlier
    # form recomputed an at_end flag and branched before every load, which cost
    # ~8x a plain str_contains over the same bytes.
    while (start < llen) {
        var e = start;
        while (e < llen) {
            if (load8(ld + e) == sep) { break; }
            e = e + 1;
        }
        if (e - start == nlen) {
            if (_ci_eq_bytes(ld + start, nd, nlen) == 1) { return 1; }
        }
        start = e + 1;
    }
    return 0;
}

# True when `needle` matches a whole `sep`-delimited token of `list`, OR is a
# leading WHOLE-WORD prefix of one (case-insensitive).
#
# Person-name fields want surname search — campaigns_by_commander("Napoleon")
# must still find "Napoleon Bonaparte". A bare substring test also matched
# "Darius I" inside "Darius III" (a different king, 152 years apart); requiring
# the next character to be a space rejects that while keeping the prefix case:
#   "Napoleon" vs "Napoleon Bonaparte" -> next char is ' '  -> match
#   "Darius I" vs "Darius III"         -> next char is 'I'  -> no match
#
# Identity fields (civilizations, commodities) use str_list_has instead, which
# requires whole-token equality — "Roman Empire" must not match the distinct
# polity "Holy Roman Empire".
#must_use
fn str_list_has_name(list: Str, needle: Str, sep) {
    var llen = str_len(list);
    var ld = str_data(list);
    var nlen = str_len(needle);
    if (nlen == 0) { return 0; }
    if (nlen > llen) { return 0; }
    var nd = str_data(needle);
    var start = 0;
    while (start < llen) {
        var e = start;
        while (e < llen) {
            if (load8(ld + e) == sep) { break; }
            e = e + 1;
        }
        var tlen = e - start;
        if (tlen == nlen) {
            if (_ci_eq_bytes(ld + start, nd, nlen) == 1) { return 1; }
        }
        if (tlen > nlen) {
            if (load8(ld + start + nlen) == 32) {
                if (_ci_eq_bytes(ld + start, nd, nlen) == 1) { return 1; }
            }
        }
        start = e + 1;
    }
    return 0;
}
