# itihas — historical eras (25 eras)
# Heap structs via store64/load64

enum EraCategory { ANCIENT; CLASSICAL; MEDIEVAL; EARLY_MODERN; MODERN; CONTEMPORARY; }
enum EraScope { SCOPE_GLOBAL; SCOPE_REGIONAL; }

# Era field offsets: name(0) start_year(8) end_year(16) region(24) description(32) category(40) scope(48) = 56 bytes
enum EraOff { ERA_NAME = 0; ERA_START = 8; ERA_END = 16; ERA_REGION = 24; ERA_DESC = 32; ERA_CAT = 40; ERA_SCOPE = 48; ERA_SIZE = 56; }   #skip-lint

# Sentinel end_year meaning "still ongoing" (i32 max, not i64 max). Stored as a
# real number so range predicates like eras_containing stay simple comparisons;
# presentation layers should render it as "present" rather than the digits.
enum EraSentinel { ERA_ONGOING = 2147483647; }

# --- Era struct (native view over the 56-byte layout) ---
# NOTE: hot paths call the generated Era_<field> accessors directly rather than
# the era_* wrappers. Cyrius does not inline, so era_start -> Era_start_year is
# two calls where the old load64 body was one; routing eras_containing and
# _era_upper_bound through the wrappers cost a measured +12.3% on
# eras_containing_500bce. The era_* names remain the public, stable API.
# Field order MUST match the EraOff offsets above (declaration order x 8, all
# fields i64). #derive(accessors) generates Era_<field>(p) / Era_set_<field>(p,
# v); the era_* accessors below delegate to these and era_new sets fields via
# the generated setters. Named fields make an offset collision a compile error
# rather than a silent aliasing bug — the EraOff enum was the only thing
# keeping the seven offsets distinct, and nothing checked it.
#
# The EraOff enum is retained: serial.cyr and the sorted-view comparators still
# address fields by offset, and tests/itihas.tcyr pins each field to its offset.
#derive(accessors)
struct Era {
    name; start_year; end_year; region; description; category; scope;
}

var era_vec = 0;
var era_init_done = 0;

#must_use
fn era_new(name: Str, sy, ey, region: Str, desc: Str, cat, scope) {
    var p = xalloc(ERA_SIZE);
    Era_set_name(p, name);
    Era_set_start_year(p, sy);
    Era_set_end_year(p, ey);
    Era_set_region(p, region);
    Era_set_description(p, desc);
    Era_set_category(p, cat);
    Era_set_scope(p, scope);
    return p;
}

#must_use
fn era_name(p) { return Era_name(p); }
#must_use
fn era_start(p) { return Era_start_year(p); }
#must_use
fn era_end(p) { return Era_end_year(p); }

# True when this era has no end year yet (end == ERA_ONGOING).
#must_use
fn era_is_ongoing(p) { return Era_end_year(p) == ERA_ONGOING; }
#must_use
fn era_region(p) { return Era_region(p); }

# The description had no accessor at all until the struct migration — serial.cyr
# reached through `load64(p + ERA_DESC)` directly.
#must_use
fn era_desc(p) { return Era_description(p); }
#must_use
fn era_cat(p) { return Era_category(p); }
#must_use
fn era_scope(p) { return Era_scope(p); }

# Build the era table (25 rows). Called once by the lazy initializer.
fn build_eras() {
    var v = vec_new();
    # Global
    vec_push(v, era_new("Bronze Age", (0-3500), (0-1100), "Near East, Mediterranean, South Asia", "Emergence of bronze metallurgy, early writing systems, and first cities", ANCIENT, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Iron Age", (0-1200), (0-550), "Near East, Mediterranean, South Asia", "Widespread iron smelting, alphabetic writing, rise of empires", ANCIENT, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Classical Antiquity", (0-800), 476, "Mediterranean, Europe", "Greek and Roman civilization, philosophy, democracy, republic", CLASSICAL, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Middle Ages", 476, 1453, "Europe, Near East", "Feudalism, monasticism, Islamic Golden Age, Crusades", MEDIEVAL, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Renaissance", 1400, 1610, "Europe", "Revival of classical learning, art, science, and exploration", EARLY_MODERN, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Age of Enlightenment", 1648, 1789, "Europe", "Rationalism, empiricism, natural rights, social contract theory", EARLY_MODERN, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Industrial Age", 1760, 1970, "Global", "Mechanization, mass production, urbanization, world wars", MODERN, SCOPE_GLOBAL));   #skip-lint
    vec_push(v, era_new("Information Age", 1970, ERA_ONGOING, "Global", "Digital revolution, internet, AI, globalization", CONTEMPORARY, SCOPE_GLOBAL));   #skip-lint
    # Chinese dynasties
    vec_push(v, era_new("Xia Dynasty", (0-2070), (0-1600), "East Asia", "Semi-legendary first dynasty of China, Yellow River valley", ANCIENT, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Shang Dynasty", (0-1600), (0-1046), "East Asia", "Oracle bones, bronze casting, earliest Chinese writing", ANCIENT, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Zhou Dynasty", (0-1046), (0-256), "East Asia", "Mandate of Heaven, Confucius, Laozi, Hundred Schools of Thought", ANCIENT, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Qin Dynasty", (0-221), (0-206), "East Asia", "First unification of China, Great Wall begun, Legalism, terracotta army", CLASSICAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Han Dynasty", (0-206), 220, "East Asia", "Silk Road, Confucian state, paper invention, civil service exams", CLASSICAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Tang Dynasty", 618, 907, "East Asia", "Golden age of Chinese poetry, cosmopolitan culture, woodblock printing", MEDIEVAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Song Dynasty", 960, 1279, "East Asia", "Movable type, gunpowder weapons, compass navigation, Neo-Confucianism", MEDIEVAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Ming Dynasty", 1368, 1644, "East Asia", "Great Wall reconstruction, Forbidden City, Zheng He voyages, porcelain", EARLY_MODERN, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Qing Dynasty", 1644, 1912, "East Asia", "Last imperial dynasty, Manchu rule, territorial expansion, Opium Wars", EARLY_MODERN, SCOPE_REGIONAL));   #skip-lint
    # Indian
    vec_push(v, era_new("Vedic Period", (0-1500), (0-500), "South Asia", "Composition of the Vedas, varna system, early Hinduism, Sanskrit literature", ANCIENT, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Maurya Period", (0-322), (0-185), "South Asia", "First pan-Indian empire under Chandragupta and Ashoka, spread of Buddhism", CLASSICAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Gupta Period", 320, 550, "South Asia", "Golden age of India: zero, decimal system, Kalidasa, Aryabhata, Nalanda", CLASSICAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Delhi Sultanate", 1206, 1526, "South Asia", "Turkic and Afghan Muslim rule in northern India, Indo-Islamic architecture", MEDIEVAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Mughal Period", 1526, 1857, "South Asia", "Babur to Bahadur Shah, Taj Mahal, Akbar's religious tolerance, Urdu synthesis", EARLY_MODERN, SCOPE_REGIONAL));   #skip-lint
    # Mesoamerican
    vec_push(v, era_new("Mesoamerican Preclassic", (0-2000), 250, "Mesoamerica", "Olmec civilization, early Maya settlements, development of writing and calendars", ANCIENT, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Mesoamerican Classic", 250, 900, "Mesoamerica", "Maya golden age, Teotihuacan, Zapotec, monumental architecture and astronomy", MEDIEVAL, SCOPE_REGIONAL));   #skip-lint
    vec_push(v, era_new("Mesoamerican Postclassic", 900, 1521, "Mesoamerica", "Toltec and Aztec empires, Chichen Itza, Tenochtitlan, Spanish contact", MEDIEVAL, SCOPE_REGIONAL));   #skip-lint
    return v;
}

#must_use
fn all_eras() {
    if (era_init_done == 0) { era_vec = build_eras(); era_init_done = 1; }
    return era_vec;
}

var era_start_vec = 0;
var era_start_done = 0;

# The table in ascending start-year order, built once. See all_events_by_year
# in event.cyr for the rationale; the ordering is a property of the immutable
# table, so deriving it per query was pure waste.
#
# Scanning this view in order means the result comes out start-sorted for free,
# which is what removes the per-call insertion sort. Order matches the old
# filter-then-stable-sort exactly.
#must_use
fn all_eras_by_start() {
    if (era_start_done == 0) {
        var src = all_eras();
        var out = vec_new();
        var n = vec_len(src);
        for (var i = 0; i < n; i = i + 1) { vec_push(out, vec_get(src, i)); }
        vec_sort(out, &_cmp_era_start);
        era_start_vec = out;
        era_start_done = 1;
    }
    return era_start_vec;
}

# Index of the first record starting AFTER `y` — the exclusive end of the
# prefix that can possibly contain `y`.
fn _era_upper_bound(v, y) {
    var lo = 0;
    var hi = vec_len(v);
    while (lo < hi) {
        var mid = lo + (hi - lo) / 2;
        if (Era_start_year(vec_get(v, mid)) <= y) { lo = mid + 1; }
        else { hi = mid; }
    }
    return lo;
}
#must_use
fn era_count() { return vec_len(all_eras()); }
#must_use
fn era_get(idx) { return vec_get(all_eras(), idx); }

fn _cmp_era_start(a, b) { return load64(a+ERA_START) - load64(b+ERA_START); }

#must_use
fn eras_containing(year) {
    itrace_i("looking up eras containing year", "year", year);
    var result = vec_new();
    var v = all_eras_by_start();
    var ub = _era_upper_bound(v, year);
    var i = 0;
    while (i < ub) {
        var p = vec_get(v, i);
        if (year <= Era_end_year(p)) { vec_push(result, p); }
        i = i + 1;
    }
    return result;
}

#must_use
fn eras_by_scope(scope) {
    itrace_i("looking up eras by scope", "scope", scope);
    var result = vec_new();
    var v = all_eras();
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (era_scope(p) == scope) { vec_push(result, p); }
    }
    return result;
}

#must_use
fn eras_by_region(region: Str) {
    itrace_s("looking up eras by region", "region", region);
    var result = vec_new();
    # Zero-length needle matches every string; return nothing instead of all.
    if (str_len(region) == 0) { return result; }
    var v = all_eras();
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_contains(era_region(p), region) == 1) { vec_push(result, p); }
    }
    return result;
}

#must_use
fn era_by_name(name: Str) {
    itrace_s("looking up era by name", "name", name);
    var v = all_eras();
    var n = vec_len(v);
    for (var i = 0; i < n; i = i + 1) {
        var p = vec_get(v, i);
        if (str_eq_lower(era_name(p), name) == 1) { return p; }
    }
    return 0;
}
