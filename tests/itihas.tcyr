# itihas.tcyr — integration test suite for itihas (run via `cyrius test`)
#
# 285 assertions covering module counts, lookups, filters, cross-module
# integration, case-insensitive lookups, chronological sort, JSON
# serialization, the hoosh data-answer and wire-parsing paths, the 2.4.2
# hardening regressions, and one assertion per public accessor/constructor.
# Ported from the legacy inline harness that used to live in src/main.cyr.

# Stdlib auto-included via cyrius.cyml

include "src/util.cyr"
include "src/error.cyr"
include "src/era.cyr"
include "src/calendar.cyr"
include "src/civilization.cyr"
include "src/figure.cyr"
include "src/event.cyr"
include "src/causality.cyr"
include "src/interaction.cyr"
include "src/campaign.cyr"
include "src/site.cyr"
include "src/trade.cyr"
include "src/logging.cyr"
include "src/serial.cyr"
include "src/hoosh.cyr"

# Thin wrappers over the stdlib assert harness so assert_summary() tracks
# pass/fail counts. ok() passes on any non-zero value (often a pointer), so it
# maps to assert_neq(_, 0) rather than assert() (which requires cond == 1).
fn check(val, expected, name) { return assert_eq(val, expected, name); }
fn ok(val, name) { return assert_neq(val, 0, name); }
fn zero(val, name) { return assert_eq(val, 0, name); }

fn main() {
    alloc_init();
    println("=== itihas test suite ===");

    # ---------------------------------------------------------------
    # Module counts
    # ---------------------------------------------------------------
    println("--- counts ---");
    check(era_count(), 25, "era_count=25");
    check(calendar_count(), 8, "calendar_count=8");
    check(civ_count(), 53, "civ_count=53");
    check(figure_count(), 52, "figure_count=52");
    check(event_count(), 105, "event_count=105");
    check(causality_count(), 13, "causality_count=13");
    check(interaction_count(), 21, "interaction_count=21");
    check(campaign_count(), 14, "campaign_count=14");
    check(site_count(), 32, "site_count=32");
    check(route_count(), 15, "route_count=15");

    # ---------------------------------------------------------------
    # Era lookups
    # ---------------------------------------------------------------
    println("--- era ---");
    ok(era_by_name("Bronze Age"), "era Bronze Age");
    ok(era_by_name("Information Age"), "era Information Age");
    zero(era_by_name("Space Age"), "era Space Age not found");
    ok(vec_len(eras_containing(2025)) > 0, "eras containing 2025");
    ok(vec_len(eras_containing((0-500))) > 0, "eras containing -500");
    check(vec_len(eras_containing((0-50000))), 0, "eras containing -50000 empty");
    ok(vec_len(eras_by_scope(SCOPE_GLOBAL)) > 0, "eras global");
    ok(vec_len(eras_by_scope(SCOPE_REGIONAL)) > 0, "eras regional");
    ok(vec_len(eras_by_region("East Asia")) > 0, "eras East Asia");
    ok(vec_len(eras_by_region("South Asia")) > 0, "eras South Asia");
    check(vec_len(eras_by_region("Mesoamerica")), 3, "eras Mesoamerica=3");

    # ---------------------------------------------------------------
    # Calendar lookups
    # ---------------------------------------------------------------
    println("--- calendar ---");
    ok(calendar_by_name("Gregorian"), "cal Gregorian");
    ok(calendar_by_name("Islamic (Hijri)"), "cal Hijri");
    ok(calendar_by_name("Maya (Long Count)"), "cal Maya");
    zero(calendar_by_name("Martian"), "cal Martian not found");

    # ---------------------------------------------------------------
    # Civilization lookups
    # ---------------------------------------------------------------
    println("--- civilization ---");
    ok(civ_by_name("Mesopotamia"), "civ Mesopotamia");
    ok(civ_by_name("Ancient Greece"), "civ Ancient Greece");
    ok(civ_by_name("Tokugawa Shogunate"), "civ Tokugawa");
    zero(civ_by_name("Atlantis"), "civ Atlantis not found");
    ok(vec_len(civs_active_at((0-500))) > 0, "civs active -500");
    ok(vec_len(civs_by_region("Near East")) > 0, "civs Near East");
    check(vec_len(civs_active_at((0-100000))), 0, "civs active -100000 empty");

    # ---------------------------------------------------------------
    # Figure lookups
    # ---------------------------------------------------------------
    println("--- figure ---");
    ok(figure_by_name("Aristotle"), "fig Aristotle");
    ok(figure_by_name("Ada Lovelace"), "fig Ada Lovelace");
    zero(figure_by_name("Gandalf"), "fig Gandalf not found");
    ok(vec_len(figures_by_domain(DOM_RULER)) > 0, "fig domain Ruler");
    ok(vec_len(figures_by_domain(DOM_SCIENTIST)) > 0, "fig domain Scientist");
    ok(vec_len(figures_by_domain(DOM_EXPLORER)) > 0, "fig domain Explorer");

    # ---------------------------------------------------------------
    # Event lookups
    # ---------------------------------------------------------------
    println("--- event ---");
    ok(event_by_name("French Revolution"), "evt French Revolution");
    ok(event_by_name("Fall of Constantinople"), "evt Fall of Constantinople");
    zero(event_by_name("Battle of Endor"), "evt Battle of Endor not found");
    ok(vec_len(events_by_category(CAT_WAR)) > 0, "evt cat War");
    ok(vec_len(events_by_category(CAT_INVENTION)) > 0, "evt cat Invention");
    ok(vec_len(events_by_significance(SIG_GLOBAL)) > 0, "evt sig Global");
    ok(vec_len(events_at_year(476)) > 0, "evt at_year 476");
    ok(vec_len(events_at_year((0-753))) > 0, "evt at_year -753");
    ok(vec_len(events_between((0-800), 476)) > 0, "evt between -800..476");

    # Verify events_at_year returns correct year
    var evts_476 = events_at_year(476);
    var evt0 = vec_get(evts_476, 0);
    check(evt_year(evt0), 476, "evt at_year returns year 476");

    # ---------------------------------------------------------------
    # Causality lookups
    # ---------------------------------------------------------------
    println("--- causality ---");
    ok(vec_len(causes_of("French Revolution")) > 0, "causes of French Rev");
    ok(vec_len(effects_of("Invention of Writing")) > 0, "effects of Writing");
    var chain = causal_chain("Invention of Writing", 3);
    ok(vec_len(chain) > 0, "chain from Writing depth 3");
    # Code of Hammurabi should be at depth 1
    var ch0 = vec_get(chain, 0);
    ok(str_eq(chain_entry_name(ch0), "Code of Hammurabi") == 1, "chain[0] = Code of Hammurabi");
    check(chain_entry_depth(ch0), 1, "chain[0] depth=1");

    # ---------------------------------------------------------------
    # Interaction lookups
    # ---------------------------------------------------------------
    println("--- interaction ---");
    ok(vec_len(interactions_for("Roman Empire")) > 0, "int for Rome");
    ok(influence_score("Ancient Egypt", "Hittite Empire") > 0, "inf score Egypt-Hittite");
    # Symmetric
    check(influence_score("Ancient Egypt", "Hittite Empire"), influence_score("Hittite Empire", "Ancient Egypt"), "inf score symmetric");
    check(influence_score("Inca Empire", "Ancient China"), 0, "inf score unrelated=0");
    ok(vec_len(interactions_by_type(INT_WAR)) > 0, "int type War");
    ok(vec_len(interactions_by_type(INT_TRADE)) > 0, "int type Trade");
    var rome_nbrs = interaction_neighbors("Roman Empire");
    ok(vec_len(rome_nbrs) > 0, "Rome has neighbors");
    ok(vec_len(interactions_between("Ancient Egypt", "Hittite Empire")) >= 2, "Egypt-Hittite >= 2 interactions");

    # ---------------------------------------------------------------
    # Campaign lookups
    # ---------------------------------------------------------------
    println("--- campaign ---");
    ok(campaign_by_name("Napoleonic Wars"), "camp Napoleonic");
    zero(campaign_by_name("Star Wars"), "camp Star Wars not found");
    ok(vec_len(campaigns_by_outcome(OUT_VICTORY)) > 0, "camp outcome Victory");
    ok(vec_len(campaigns_by_commander("Napoleon")) > 0, "camp cmd Napoleon");
    ok(vec_len(campaigns_by_region("Europe")) > 0, "camp region Europe");
    ok(vec_len(campaigns_by_civilization("Roman Republic")) > 0, "camp civ Roman Republic");
    ok(vec_len(campaigns_between((0-500), (0-200))) > 0, "camp between -500..-200");

    # ---------------------------------------------------------------
    # Site lookups
    # ---------------------------------------------------------------
    println("--- site ---");
    ok(site_by_name("Machu Picchu"), "site Machu Picchu");
    ok(site_by_name("Pompeii"), "site Pompeii");
    zero(site_by_name("Atlantis"), "site Atlantis not found");
    ok(vec_len(sites_by_region("Near East")) > 0, "sites Near East");
    ok(vec_len(sites_by_type(ST_TEMPLE)) > 0, "sites type Temple");
    ok(vec_len(sites_active_at((0-500))) > 0, "sites active -500");
    ok(vec_len(sites_by_civilization("Ancient Egypt")) > 0, "sites civ Egypt");

    # ---------------------------------------------------------------
    # Trade route lookups
    # ---------------------------------------------------------------
    println("--- trade ---");
    ok(route_by_name("Silk Road"), "route Silk Road");
    zero(route_by_name("Route 66"), "route Route 66 not found");
    ok(vec_len(routes_by_commodity("silk")) > 0, "routes commodity silk");
    ok(vec_len(routes_by_region("East Asia")) > 0, "routes region East Asia");
    ok(vec_len(routes_by_type(RT_MARITIME)) > 0, "routes type Maritime");
    ok(vec_len(routes_by_civilization("Roman Empire")) > 0, "routes civ Rome");
    ok(vec_len(routes_active_at(1000)) > 0, "routes active 1000");

    # ---------------------------------------------------------------
    # Integration: cross-module validation
    # ---------------------------------------------------------------
    println("--- integration ---");

    # Era date ordering: start < end for all eras
    var era_dates_ok = 1;
    var ev = all_eras();
    var en = vec_len(ev);
    for (var i = 0; i < en; i = i + 1) {
        var p = vec_get(ev, i);
        if (era_start(p) >= era_end(p)) { era_dates_ok = 0; }
    }
    ok(era_dates_ok, "era start < end for all");

    # Civ date ordering: founding < end for all
    var civ_dates_ok = 1;
    var cv = all_civilizations();
    var cn = vec_len(cv);
    for (var ci = 0; ci < cn; ci = ci + 1) {
        var p = vec_get(cv, ci);
        if (civ_found(p) >= civ_end(p)) { civ_dates_ok = 0; }
    }
    ok(civ_dates_ok, "civ founding < end for all");

    # Campaign date ordering: start <= end
    var camp_dates_ok = 1;
    var cpv = all_campaigns();
    var cpn = vec_len(cpv);
    for (var cpi = 0; cpi < cpn; cpi = cpi + 1) {
        var p = vec_get(cpv, cpi);
        if (load64(p+CAMP_START) > load64(p+CAMP_END)) { camp_dates_ok = 0; }
    }
    ok(camp_dates_ok, "campaign start <= end for all");

    # Site date ordering: start <= end
    var site_dates_ok = 1;
    var sv = all_sites();
    var sn = vec_len(sv);
    for (var sti = 0; sti < sn; sti = sti + 1) {
        var p = vec_get(sv, sti);
        if (load64(p+SITE_START) > load64(p+SITE_END)) { site_dates_ok = 0; }
    }
    ok(site_dates_ok, "site start <= end for all");

    # Route date ordering: start <= end
    var route_dates_ok = 1;
    var rv = all_routes();
    var rn = vec_len(rv);
    for (var rti = 0; rti < rn; rti = rti + 1) {
        var p = vec_get(rv, rti);
        if (load64(p+RT_START) > load64(p+RT_END)) { route_dates_ok = 0; }
    }
    ok(route_dates_ok, "route start <= end for all");

    # Eras + civs at 500 BCE should both return results
    ok(vec_len(eras_containing((0-500))) > 0 && vec_len(civs_active_at((0-500))) > 0, "500 BCE has eras and civs");

    # Boundary: Mesopotamia founding year is active
    var mesop = civ_by_name("Mesopotamia");
    ok(mesop, "Mesopotamia exists");
    var mesop_civs = civs_active_at(civ_found(mesop));
    var found_mesop = 0;
    var mn = vec_len(mesop_civs);
    for (var mi = 0; mi < mn; mi = mi + 1) {
        if (str_eq(civ_name(vec_get(mesop_civs, mi)), "Mesopotamia") == 1) { found_mesop = 1; }
    }
    ok(found_mesop, "Mesopotamia active at own founding year");

    # Region proximity
    check(region_proximity("Mesopotamia", "Assyrian Empire"), 100, "prox Mesopotamia-Assyria=100");
    ok(region_proximity("Roman Empire", "Ancient Greece") >= 50, "prox Rome-Greece >= 50");
    check(region_proximity("Inca Empire", "Ancient China"), 0, "prox Inca-China=0");
    check(region_proximity("Atlantis", "Ancient Greece"), 0, "prox unknown=0");
    # Symmetric
    check(region_proximity("Roman Empire", "Ancient Greece"), region_proximity("Ancient Greece", "Roman Empire"), "prox symmetric");

    # Logging init (just verify it doesn't crash)
    itihas_log_init();
    ok(1, "log init does not crash");

    # Rome active at end year (476)
    var rome_civs = civs_active_at(476);
    var found_rome = 0;
    var rmn = vec_len(rome_civs);
    for (var ri = 0; ri < rmn; ri = ri + 1) {
        if (str_eq(civ_name(vec_get(rome_civs, ri)), "Roman Empire") == 1) { found_rome = 1; }
    }
    ok(found_rome, "Roman Empire active at end year 476");

    # ---------------------------------------------------------------
    # Case-insensitive lookups
    # ---------------------------------------------------------------
    println("--- case-insensitive ---");
    ok(era_by_name("bronze age"), "era lowercase");
    ok(era_by_name("BRONZE AGE"), "era uppercase");
    ok(era_by_name("Bronze Age"), "era mixed case");
    ok(civ_by_name("roman empire"), "civ lowercase");
    ok(civ_by_name("ROMAN EMPIRE"), "civ uppercase");
    ok(event_by_name("fall of the western roman empire"), "event lowercase");
    ok(figure_by_name("JULIUS CAESAR"), "figure uppercase");
    ok(calendar_by_name("gregorian"), "calendar lowercase");
    ok(campaign_by_name("second punic war"), "campaign lowercase");
    ok(site_by_name("POMPEII"), "site uppercase");
    ok(route_by_name("silk road"), "route lowercase");

    # ---------------------------------------------------------------
    # Chronological sort
    # ---------------------------------------------------------------
    println("--- sort ---");
    var sorted_events = events_between(-500, 500);
    var sort_ok = 1;
    for (var si = 1; si < vec_len(sorted_events); si = si + 1) {
        if (evt_year(vec_get(sorted_events, si)) < evt_year(vec_get(sorted_events, si - 1))) { sort_ok = 0; }
    }
    ok(sort_ok, "events_between sorted by year");

    var sorted_camps = campaigns_between(-500, 500);
    var camp_sort_ok = 1;
    for (var sci = 1; sci < vec_len(sorted_camps); sci = sci + 1) {
        if (load64(vec_get(sorted_camps, sci)+CAMP_START) < load64(vec_get(sorted_camps, sci - 1)+CAMP_START)) { camp_sort_ok = 0; }
    }
    ok(camp_sort_ok, "campaigns_between sorted by start");

    var sorted_eras = eras_containing(500);
    var era_sort_ok = 1;
    for (var sei = 1; sei < vec_len(sorted_eras); sei = sei + 1) {
        if (era_start(vec_get(sorted_eras, sei)) < era_start(vec_get(sorted_eras, sei - 1))) { era_sort_ok = 0; }
    }
    ok(era_sort_ok, "eras_containing sorted by start");

    # ---------------------------------------------------------------
    # JSON serialization
    # ---------------------------------------------------------------
    println("--- json ---");
    var bronze = era_by_name("Bronze Age");
    var bronze_json = era_to_json(bronze);
    ok(str_contains(bronze_json, "Bronze Age"), "era json has name");
    ok(str_contains_cstr(bronze_json, "start_year"), "era json has start_year");

    var rome = civ_by_name("Roman Empire");
    var rome_json = civ_to_json(rome);
    ok(str_contains(rome_json, "Roman Empire"), "civ json has name");

    var fall = event_by_name("Fall of the Western Roman Empire");
    var fall_json = event_to_json(fall);
    ok(str_contains(fall_json, "Fall of the Western Roman Empire"), "event json has name");
    ok(str_contains_cstr(fall_json, "\"year\": 476"), "event json has year");

    var caesar = figure_by_name("Julius Caesar");
    var caesar_json = figure_to_json(caesar);
    ok(str_contains(caesar_json, "Julius Caesar"), "figure json has name");

    var greg = calendar_by_name("Gregorian");
    var greg_json = calendar_to_json(greg);
    ok(str_contains(greg_json, "Gregorian"), "calendar json has name");

    var punic = campaign_by_name("Second Punic War");
    var punic_json = campaign_to_json(punic);
    ok(str_contains(punic_json, "Second Punic War"), "campaign json has name");
    ok(str_contains_cstr(punic_json, "battles"), "campaign json has battles");
    ok(str_contains_cstr(punic_json, "Cannae"), "campaign json has battle name");

    var pomp = site_by_name("Pompeii");
    var pomp_json = site_to_json(pomp);
    ok(str_contains(pomp_json, "Pompeii"), "site json has name");

    var silk = route_by_name("Silk Road");
    var silk_json = route_to_json(silk);
    ok(str_contains(silk_json, "Silk Road"), "route json has name");

    # ---------------------------------------------------------------
    # Hoosh: answer_from_data
    # ---------------------------------------------------------------
    println("--- hoosh ---");

    # EventsInRange — known range
    var eq = query_events_in_range((0-500), 500);
    var er = answer_from_data(eq);
    ok(er, "events_in_range returns data");
    check(resp_source(er), SRC_DATA, "events source=DATA");
    ok(str_len(resp_content(er)) > 0, "events content not empty");

    # EventsInRange — empty range
    var eq2 = query_events_in_range(9999, 9999);
    var er2 = answer_from_data(eq2);
    ok(er2, "events empty range returns resp");
    ok(str_contains_cstr(resp_content(er2), "No events"), "events empty msg");

    # CivilizationsAt
    var cq = query_civs_at((0-500));
    var cr = answer_from_data(cq);
    ok(cr, "civs_at returns data");
    ok(str_contains(resp_content(cr), "Ancient Greece"), "civs content has Greece");

    # CausesOf — known
    var caq = query_causes_of("French Revolution");
    var car = answer_from_data(caq);
    ok(car, "causes_of known returns data");

    # CausesOf — unknown (needs LLM)
    var caq2 = query_causes_of("Battle of Endor");
    var car2 = answer_from_data(caq2);
    check(car2, 0, "causes_of unknown returns 0");

    # InteractionsBetween — known
    var iq = query_interactions_between("Ancient Egypt", "Hittite Empire");
    var ir = answer_from_data(iq);
    ok(ir, "interactions known returns data");

    # FigureLookup — found
    var fq = query_figure_lookup("Aristotle");
    var fr = answer_from_data(fq);
    ok(fr, "figure found returns data");
    ok(str_contains_cstr(resp_content(fr), "philosopher"), "figure content has philosopher");

    # FigureLookup — not found
    var fq2 = query_figure_lookup("Gandalf");
    var fr2 = answer_from_data(fq2);
    check(fr2, 0, "figure not found returns 0");

    # FreeForm — always returns 0
    var ffq = query_free_form("Why did Rome fall?");
    check(answer_from_data(ffq), 0, "free_form returns 0");

    # Tool defs
    check(hoosh_tool_count(), 6, "tool_count=6");
    var tdefs = hoosh_tool_defs_json();
    ok(str_contains_cstr(str_from(tdefs), "events_in_range"), "tools has events_in_range");
    ok(str_contains_cstr(str_from(tdefs), "era_lookup"), "tools has era_lookup");

    # parse_tool_call
    var ptc1 = parse_tool_call("events_in_range", "{\"start\": -500, \"end\": 500}");
    ok(ptc1, "parse events_in_range");
    check(load64(ptc1+Q_TYPE), QT_EVENTS_IN_RANGE, "parse type=events");

    var ptc2 = parse_tool_call("civilizations_at", "{\"year\": -500}");
    ok(ptc2, "parse civs_at");
    check(load64(ptc2+Q_TYPE), QT_CIVS_AT, "parse type=civs");

    var ptc3 = parse_tool_call("causes_of", "{\"event\": \"French Revolution\"}");
    ok(ptc3, "parse causes_of");

    var ptc4 = parse_tool_call("interactions_between", "{\"civ_a\": \"Rome\", \"civ_b\": \"Egypt\"}");
    ok(ptc4, "parse interactions");

    var ptc5 = parse_tool_call("figure_lookup", "{\"name\": \"Aristotle\"}");
    ok(ptc5, "parse figure_lookup");

    check(parse_tool_call("unknown_tool", "{}"), 0, "parse unknown=0");
    check(parse_tool_call("events_in_range", "{}"), 0, "parse missing args=0");

    # resolve_era_lookup
    var era_args1 = json_parse(str_from("{\"name\": \"Bronze Age\"}"));
    var elr1 = resolve_era_lookup(era_args1);
    ok(elr1, "era lookup by name");
    ok(str_contains(resp_content(elr1), "Bronze Age"), "era content has name");

    var era_args2 = json_parse(str_from("{\"year\": -500}"));
    var elr2 = resolve_era_lookup(era_args2);
    ok(elr2, "era lookup by year");

    var era_args3 = json_parse(str_from("{\"name\": \"Space Age\"}"));
    var elr3 = resolve_era_lookup(era_args3);
    check(elr3, 0, "era lookup unknown=0");


    # ---------------------------------------------------------------
    # 2.4.2 regressions — util helpers
    # ---------------------------------------------------------------
    println("--- util helpers ---");
    ok(str_eq(str_lower(str_from("MiXeD Case 123")), str_from("mixed case 123")), "str_lower ASCII");
    ok(str_eq(str_upper(str_from("MiXeD Case 123")), str_from("MIXED CASE 123")), "str_upper ASCII");
    check(str_eq_lower(str_from("Bronze Age"), str_from("BRONZE age")), 1, "str_eq_lower folds");
    check(str_eq_lower(str_from("abc"), str_from("abcd")), 0, "str_eq_lower length differs");

    # Whole-token membership: the bug this replaced matched "Roman Empire"
    # inside "Holy Roman Empire".
    var toks = str_from("Holy Roman Empire;Spanish Empire");
    check(str_list_has(toks, str_from("Roman Empire"), 59), 0, "list_has rejects inner substring");
    check(str_list_has(toks, str_from("Holy Roman Empire"), 59), 1, "list_has first token");
    check(str_list_has(toks, str_from("Spanish Empire"), 59), 1, "list_has last token");
    check(str_list_has(toks, str_from("spanish empire"), 59), 1, "list_has is case-insensitive");
    check(str_list_has(toks, str_from(""), 59), 0, "list_has empty needle");
    check(str_list_has(str_from("French Empire"), str_from("French Empire"), 59), 1, "list_has single token");
    # Name matching allows a leading whole-word prefix but not a partial word.
    check(str_list_has_name(str_from("Darius III;Alexander"), str_from("Darius I"), 59), 0, "name rejects Darius I/III");
    check(str_list_has_name(str_from("Napoleon Bonaparte"), str_from("Napoleon"), 59), 1, "name allows surname prefix");
    check(str_list_has_name(str_from("Napoleon Bonaparte"), str_from("Napo"), 59), 0, "name rejects partial word");

    # JSON escaping must cover every C0 control, not just " \ and LF.
    var esb = str_builder_new();
    json_escape_into(esb, str_from("q\"b\\s\tt\rc\nn"));
    var escaped = str_builder_build(esb);
    ok(str_contains_cstr(escaped, "\\\""), "escape quote");
    ok(str_contains_cstr(escaped, "\\\\"), "escape backslash");
    ok(str_contains_cstr(escaped, "\\t"), "escape tab");
    ok(str_contains_cstr(escaped, "\\r"), "escape CR");
    ok(str_contains_cstr(escaped, "\\n"), "escape LF");
    ok(str_eq(json_unescape(escaped), str_from("q\"b\\s\tt\rc\nn")), "escape/unescape roundtrip");
    ok(str_eq(json_unescape(str_from("caf\\u00e9")), str_from("café")), "unescape \\u to UTF-8");
    ok(str_eq(json_unescape(str_from("plain")), str_from("plain")), "unescape passthrough");

    # ---------------------------------------------------------------
    # 2.4.2 regressions — query semantics
    # ---------------------------------------------------------------
    println("--- query semantics ---");
    # campaigns_by_civilization used to return the Thirty Years' War for
    # "Roman Empire", matched inside "Holy Roman Empire".
    check(vec_len(campaigns_by_civilization("Roman Empire")), 0, "no campaign lists Roman Empire");
    check(vec_len(campaigns_by_civilization("Roman Republic")), 2, "Roman Republic has 2 campaigns");
    check(vec_len(campaigns_by_civilization("Holy Roman Empire")), 1, "Holy Roman Empire exact");
    check(vec_len(campaigns_by_commander("Darius I")), 1, "Darius I excludes Darius III");
    ok(vec_len(campaigns_by_commander("Napoleon")) > 0, "Napoleon surname still resolves");
    check(vec_len(routes_by_commodity("silk")), 2, "routes_by_commodity silk exact");

    # Referential integrity restored by the 2.4.2 data corrections.
    ok(vec_len(routes_by_civilization("Viking/Norse")) > 0, "Viking/Norse route resolves");
    ok(vec_len(sites_by_civilization("Great Zimbabwe")) > 0, "Great Zimbabwe site resolves");

    # Causality and interaction lookups now fold case like every *_by_name.
    check(vec_len(causes_of("french revolution")), vec_len(causes_of("French Revolution")), "causes_of folds case");
    check(vec_len(effects_of("invention of writing")), vec_len(effects_of("Invention of Writing")), "effects_of folds case");
    check(vec_len(interactions_for("roman empire")), vec_len(interactions_for("Roman Empire")), "interactions_for folds case");
    check(vec_len(interactions_between("roman empire", "ancient egypt")),
          vec_len(interactions_between("Roman Empire", "Ancient Egypt")), "interactions_between folds case");
    zero(vec_len(causes_of("No Such Event")), "causes_of unknown = 0");
    zero(vec_len(effects_of("No Such Event")), "effects_of unknown = 0");

    # causal_chain depth invariant: nothing may exceed max_depth.
    zero(vec_len(causal_chain("Invention of Writing", 0)), "causal_chain depth 0 = empty");
    ok(vec_len(causal_chain("Invention of Writing", 1)) > 0, "causal_chain depth 1 non-empty");
    var chain3 = causal_chain("Invention of Writing", 3);
    var depth_ok = 1;
    for (var ci = 0; ci < vec_len(chain3); ci = ci + 1) {
        if (load64(vec_get(chain3, ci) + CH_DEPTH) > 3) { depth_ok = 0; }
    }
    ok(depth_ok, "causal_chain respects max_depth");

    # An empty region needle used to match every record.
    zero(vec_len(civs_by_region(str_from(""))), "civs_by_region empty = 0");
    zero(vec_len(eras_by_region(str_from(""))), "eras_by_region empty = 0");

    # campaigns_active_at had no test at all; 1453 pins both inclusive endpoints.
    ok(vec_len(campaigns_active_at(1453)) > 0, "campaigns_active_at 1453");
    zero(vec_len(campaigns_active_at(-5000)), "campaigns_active_at prehistory = 0");

    # Ongoing-era sentinel.
    check(era_is_ongoing(era_by_name("Information Age")), 1, "Information Age is ongoing");
    check(era_is_ongoing(era_by_name("Bronze Age")), 0, "Bronze Age is not ongoing");

    # Corrected data values.
    check(cal_epoch(calendar_by_name("Hebrew")), -3761, "Hebrew epoch is 3761 BCE");
    check(civ_found(civ_by_name("Chola Dynasty")), 848, "Chola founded 848");

    # ---------------------------------------------------------------
    # 2.4.2 regressions — serializer escaping and round-trip
    # ---------------------------------------------------------------
    println("--- json escaping ---");
    var hostile = era_new(str_from("Tab\tAnd \"Quote\""), 1, 2, str_from("R"),
                          str_from("back\\slash\r\nlines"), ANCIENT, SCOPE_GLOBAL);
    var hj = era_to_json(hostile);
    ok(json_parse(hj), "hostile era json parses");
    ok(str_contains_cstr(hj, "\\t"), "hostile era escapes tab");
    ok(str_contains_cstr(hj, "\\r"), "hostile era escapes CR");
    # bayan's json_get returns the RAW escaped span, so the decode step is the
    # caller's; json_unescape is the inverse of what the serializer emitted.
    var hp = json_parse(hj);
    ok(str_eq(json_unescape(json_get(hp, str_from("name"))), str_from("Tab\tAnd \"Quote\"")), "hostile name round-trips");

    # The three *_to_json functions with no previous assertions.
    var caus0 = vec_get(all_causalities(), 0);
    ok(json_parse(causality_to_json(caus0)), "causality json parses");
    var int0 = vec_get(all_interactions(), 0);
    ok(json_parse(interaction_to_json(int0)), "interaction json parses");
    var camp0 = vec_get(all_campaigns(), 0);
    ok(json_parse(campaign_to_json(camp0)), "campaign json parses");

    # resp_data had zero call sites anywhere in the repo.
    var rdq = query_causes_of(str_from("French Revolution"));
    var rdr = answer_from_data(rdq);
    ok(rdr, "causes_of data response");
    ok(json_parse(resp_data(rdr)), "resp_data is valid json");

    # ---------------------------------------------------------------
    # 2.4.2 regressions — hoosh wire path (no network required)
    # ---------------------------------------------------------------
    println("--- hoosh wire ---");
    var hbuf = alloc(2048);
    var hlen = _build_post_header(hbuf, "/v1/chat/completions", "localhost", 123);
    ok(hlen > 0, "post header built");
    var hstr = str_from_buf(hbuf, hlen);
    ok(str_contains_cstr(hstr, "Content-Type: application/json\r\n"), "full Content-Type header");
    ok(str_contains_cstr(hstr, "Content-Length: 123\r\n"), "Content-Length correct");
    ok(str_contains_cstr(hstr, "POST /v1/chat/completions HTTP/1.0\r\n"), "request line");

    # The wire shape hoosh actually emits: arguments as a JSON-ENCODED STRING.
    var wire_esc = "{\"choices\":[{\"message\":{\"tool_calls\":[{\"function\":{\"name\":\"causes_of\",\"arguments\":\"{\\\"event\\\": \\\"French Revolution\\\"}\"}}]}}]}";
    var tc1 = _extract_tool_call(wire_esc, strlen(wire_esc));
    ok(tc1, "extract tool call (escaped args)");
    ok(str_eq(load64(tc1), str_from("causes_of")), "escaped args tool name");
    var q1 = parse_tool_call(load64(tc1), load64(tc1 + 8));
    ok(q1, "escaped args resolve to a query");
    check(load64(q1 + Q_TYPE), QT_CAUSES_OF, "escaped args query type");

    # Object-form arguments must still work (no double-unescape).
    var wire_obj = "{\"tool_calls\":[{\"function\":{\"name\":\"civilizations_at\",\"arguments\":{\"year\": -500}}}]}";
    var tc2 = _extract_tool_call(wire_obj, strlen(wire_obj));
    ok(tc2, "extract tool call (object args)");
    var q2 = parse_tool_call(load64(tc2), load64(tc2 + 8));
    ok(q2, "object args resolve to a query");
    check(load64(q2 + Q_ARG1), -500, "object args value parsed");

    var wire_rng = "{\"tool_calls\":[{\"function\":{\"name\":\"events_in_range\",\"arguments\":\"{\\\"start\\\": -500, \\\"end\\\": 500}\"}}]}";
    var tc3 = _extract_tool_call(wire_rng, strlen(wire_rng));
    var q3 = parse_tool_call(load64(tc3), load64(tc3 + 8));
    ok(q3, "escaped range args resolve");
    check(load64(q3 + Q_ARG1), -500, "range start value");
    check(load64(q3 + Q_ARG2), 500, "range end value");

    # Hostile/truncated bodies must return 0, not read past the buffer.
    var trunc1 = "{\"tool_calls\":[{\"name\":\"causes_of\",\"arguments\"";
    check(_extract_tool_call(trunc1, strlen(trunc1)), 0, "truncated after arguments = 0");
    var trunc2 = "{\"tool_calls\":[{\"name\":\"causes_of";
    check(_extract_tool_call(trunc2, strlen(trunc2)), 0, "unterminated name = 0");
    var trunc3 = "{\"no tool calls here\"}";
    check(_extract_tool_call(trunc3, strlen(trunc3)), 0, "no tool_calls = 0");

    # _extract_content decodes escapes rather than leaking them to the caller.
    var cbody = "{\"choices\":[{\"message\":{\"content\":\"Line one\\nLine \\\"two\\\"\"}}]}";
    var cout = _extract_content(cbody, strlen(cbody));
    ok(str_contains_cstr(cout, "Line one\nLine \"two\""), "content escapes decoded");
    var cnull = "{\"choices\":[{\"message\":{\"content\":null}}]}";
    check(str_len(_extract_content(cnull, strlen(cnull))), 0, "null content = empty");

    # The outgoing request must stay valid JSON for a hostile question.
    var req = _build_inference_request(str_from("What\tabout \"Rome\"\r\nand C:\\path?"), str_from("llama3.2:1b"));
    ok(json_parse(req), "inference request is valid json");
    ok(str_contains_cstr(req, "\\t"), "request escapes tab");

    # Offline failure path: port 1 refuses connect immediately.
    check(hoosh_post(1, str_from("{}")), 0, "hoosh_post connect refused = 0");
    check(llm_answer(1, str_from("q"), str_from("m")), 0, "llm_answer connect refused = 0");


    # ---------------------------------------------------------------
    # Public accessor coverage — every getter asserted at least once
    # ---------------------------------------------------------------
    println("--- accessors ---");
    var e0 = era_by_name("Bronze Age");
    ok(str_eq(era_name(e0), str_from("Bronze Age")), "era_name");
    ok(str_len(era_region(e0)) > 0, "era_region");
    check(era_cat(e0), ANCIENT, "era_cat");
    check(era_scope(e0), SCOPE_GLOBAL, "era_scope");
    ok(era_get(0), "era_get");

    var c0 = calendar_by_name("Gregorian");
    ok(str_eq(cal_name(c0), str_from("Gregorian")), "cal_name");
    check(cal_type(c0), CAL_SOLAR, "cal_type");
    check(cal_months(c0), 12, "cal_months");

    var v0 = civ_by_name("Roman Empire");
    ok(str_len(civ_region(v0)) > 0, "civ_region");
    ok(civ_get(0), "civ_get");

    var f0 = figure_by_name("Aristotle");
    ok(str_eq(fig_name(f0), str_from("Aristotle")), "fig_name");
    check(fig_domain(f0), DOM_PHILOSOPHER, "fig_domain");

    var v1 = event_by_name("Fall of the Western Roman Empire");
    ok(str_eq(evt_name(v1), str_from("Fall of the Western Roman Empire")), "evt_name");
    check(evt_cat(v1), CAT_COLLAPSE, "evt_cat");
    ok(evt_sig(v1) >= 0, "evt_sig");

    var k0 = vec_get(all_causalities(), 0);
    ok(str_len(caus_cause(k0)) > 0, "caus_cause");
    ok(str_len(caus_effect(k0)) > 0, "caus_effect");

    var i0 = vec_get(all_interactions(), 0);
    ok(str_len(int_civa(i0)) > 0, "int_civa");
    ok(str_len(int_civb(i0)) > 0, "int_civb");
    ok(int_type(i0) >= 0, "int_type");
    ok(vec_len(split_regions(str_from("Near East, Europe"))) == 2, "split_regions");

    var m0 = vec_get(all_campaigns(), 0);
    ok(str_len(camp_name(m0)) > 0, "camp_name");
    ok(str_len(camp_region(m0)) > 0, "camp_region");
    ok(camp_out(m0) >= 0, "camp_out");
    ok(str_len(camp_cmds(m0)) > 0, "camp_cmds");
    ok(str_len(camp_bella(m0)) > 0, "camp_bella");
    ok(str_len(camp_bellb(m0)) > 0, "camp_bellb");

    var s0 = vec_get(all_sites(), 0);
    ok(str_len(site_name(s0)) > 0, "site_name");
    ok(str_len(site_region(s0)) > 0, "site_region");

    var r0 = vec_get(all_routes(), 0);
    ok(str_len(rt_name(r0)) > 0, "rt_name");
    ok(str_len(rt_comm(r0)) > 0, "rt_comm");

    # Constructors, used directly rather than only through the build_* tables.
    var ne = era_new(str_from("Test Era"), 1, 2, str_from("R"), str_from("d"), MODERN, SCOPE_REGIONAL);
    check(era_start(ne), 1, "era_new");
    var nc = cal_new(str_from("Test Cal"), CAL_SOLAR, 1, 12, str_from("none"));
    check(cal_months(nc), 12, "cal_new");
    var nv = civ_new(str_from("Test Civ"), str_from("R"), str_from("E"), 1, 2, str_from("t"), str_from("s"), str_from("l"));
    check(civ_found(nv), 1, "civ_new");
    var nf = fig_new(str_from("Test Fig"), 1, 2, str_from("C"), DOM_SCIENTIST, str_from("d"));
    check(fig_domain(nf), DOM_SCIENTIST, "fig_new");
    var nev = evt_new(str_from("Test Evt"), 5, str_from("E"), CAT_WAR, str_from("d"), str_from("c"), SIG_REGIONAL);
    check(evt_year(nev), 5, "evt_new");
    var nk = caus_new(str_from("A"), str_from("B"), 1, str_from("d"));
    ok(str_eq(caus_cause(nk), str_from("A")), "caus_new");
    var ni = int_new(str_from("A"), str_from("B"), INT_TRADE, 1, 2, str_from("d"));
    check(int_type(ni), INT_TRADE, "int_new");
    var ns = site_new(str_from("Test Site"), str_from("X"), str_from("R"), ST_SETTLEMENT, str_from("C"), 1, 2, 3, str_from("d"));
    ok(str_eq(site_name(ns), str_from("Test Site")), "site_new");
    var nr = rt_new(str_from("Test Route"), str_from("R"), RT_LAND, str_from("C"), str_from("goods"), 1, 2, str_from("d"));
    ok(str_eq(rt_name(nr), str_from("Test Route")), "rt_new");
    var nm = camp_new(str_from("Test Camp"), str_from("R"), 1, 2, str_from("A"), str_from("B"), str_from("C"), OUT_VICTORY, str_from("d"));
    bat_add(nm, str_from("Test Battle"), 1, str_from("Loc"), str_from("d"));
    var nbats = load64(nm + CAMP_BATTLES);
    check(vec_len(nbats), 1, "camp_new + bat_add");
    ok(json_parse(battle_to_json(vec_get(nbats, 0))), "battle_to_json parses");

    # The build_* table builders, called directly.
    ok(vec_len(build_eras()) > 0, "build_eras");
    ok(vec_len(build_calendars()) > 0, "build_calendars");
    ok(vec_len(build_civs()) > 0, "build_civs");
    ok(vec_len(build_figs()) > 0, "build_figs");
    ok(vec_len(build_events()) > 0, "build_events");
    ok(vec_len(build_causalities()) > 0, "build_causalities");
    ok(vec_len(build_interactions()) > 0, "build_interactions");
    ok(vec_len(build_campaigns()) > 0, "build_campaigns");
    ok(vec_len(build_sites()) > 0, "build_sites");
    ok(vec_len(build_routes()) > 0, "build_routes");

    # vec_sort with an explicit comparator.
    var sortv = vec_new();
    vec_push(sortv, era_new(str_from("B"), 20, 21, str_from("R"), str_from("d"), MODERN, SCOPE_GLOBAL));
    vec_push(sortv, era_new(str_from("A"), 10, 11, str_from("R"), str_from("d"), MODERN, SCOPE_GLOBAL));
    vec_sort(sortv, &_cmp_era_start);
    check(era_start(vec_get(sortv, 0)), 10, "vec_sort orders ascending");

    itihas_log_init_level(SK_WARN);
    ok(1, "log level set");

    return assert_summary();
}

var rc = main();
syscall(60, rc);
