# itihas.tcyr — integration test suite for itihas (run via `cyrius test`)
#
# Covers module counts, lookups, filters, cross-module integration,
# case-insensitive lookups, chronological sort, JSON serialization and the
# *_from_json decoders (round trips and every error message), the hoosh
# data-answer and wire-parsing paths, the 2.4.2 and 2.6.2 hardening
# regressions, the cross-table date rule, and one assertion per public
# accessor and constructor.
# Ported from the legacy inline harness that used to live in src/main.cyr.

# Stdlib auto-included via cyrius.cyml

include "src/util.cyr"
include "src/error.cyr"
include "src/era.cyr"
include "src/calendar.cyr"
include "src/civilization.cyr"
include "src/figure.cyr"
include "src/event.cyr"
include "src/causality.cyr"
include "src/interaction.cyr"
include "src/campaign.cyr"
include "src/site.cyr"
include "src/trade.cyr"
include "src/logging.cyr"
include "src/serial.cyr"
include "src/hoosh.cyr"

# Thin wrappers over the stdlib assert harness so assert_summary() tracks
# pass/fail counts. ok() passes on any non-zero value (often a pointer), so it
# maps to assert_neq(_, 0) rather than assert() (which requires cond == 1).
fn check(val, expected, name) { return assert_eq(val, expected, name); }
# Passes on any non-zero value, usually a pointer.
fn ok(val, name) { return assert_neq(val, 0, name); }
# Passes on exactly 0: a miss, or an empty count.
fn zero(val, name) { return assert_eq(val, 0, name); }

# ---------------------------------------------------------------
# 2.6.2 helpers
# ---------------------------------------------------------------
# The cross-table date rule from docs/guides/usage.md: a record must not
# contradict the dates of a civilization record it names. Each `;`-token of
# `list` that resolves to a civilization is checked against [a, b]:
#   mode 0: the year a lies inside the civilization's years
#   mode 1: [a, b] overlaps them
#   mode 2: [a, b] lies inside them
var _inv_checked = 0;
var _inv_violations = 0;
fn _inv_list(list, a, b, mode) {
    var n = str_len(list);
    var d = str_data(list);
    var i = 0;
    while (i <= n) {
        var j = i;
        while (j < n) {
            if (load8(d + j) == 59) { break; }
            j = j + 1;
        }
        if (j > i) {
            var c = civ_by_name(str_new(d + i, j - i));
            if (c != 0) {
                _inv_checked = _inv_checked + 1;
                var f = civ_found(c);
                var e = civ_end(c);
                var good = 1;
                if (mode == 0) { if (a < f || a > e) { good = 0; } }
                if (mode == 1) { if (b < f || a > e) { good = 0; } }
                if (mode == 2) { if (a < f || b > e) { good = 0; } }
                if (good == 0) { _inv_violations = _inv_violations + 1; }
            }
        }
        i = j + 1;
    }
    return 0;
}
fn _inv_sweep() {
    var v = all_events();
    for (var i = 0; i < vec_len(v); i = i + 1) {
        var p = vec_get(v, i);
        _inv_list(evt_civs(p), evt_year(p), evt_year(p), 0);
    }
    var iv = all_interactions();
    for (var k = 0; k < vec_len(iv); k = k + 1) {
        var q = vec_get(iv, k);
        _inv_list(int_civa(q), int_start(q), int_end(q), 2);
        _inv_list(int_civb(q), int_start(q), int_end(q), 2);
    }
    var fv = all_figures();
    for (var fi = 0; fi < vec_len(fv); fi = fi + 1) {
        var fp = vec_get(fv, fi);
        _inv_list(fig_civ(fp), fig_birth(fp), fig_death(fp), 1);
    }
    var sv = all_sites();
    for (var si = 0; si < vec_len(sv); si = si + 1) {
        var sp = vec_get(sv, si);
        _inv_list(site_civ(sp), site_start(sp), site_end(sp), 1);
    }
    var rv = all_routes();
    for (var ri = 0; ri < vec_len(rv); ri = ri + 1) {
        var rp = vec_get(rv, ri);
        _inv_list(rt_civs(rp), rt_start(rp), rt_end(rp), 1);
    }
    var cv = all_campaigns();
    for (var ci = 0; ci < vec_len(cv); ci = ci + 1) {
        var cp = vec_get(cv, ci);
        _inv_list(camp_bella(cp), camp_start(cp), camp_end(cp), 1);
        _inv_list(camp_bellb(cp), camp_start(cp), camp_end(cp), 1);
    }
    return 0;
}

# Global eras containing `year`.
fn _global_era_count(year) {
    var v = eras_containing(year);
    var n = 0;
    for (var i = 0; i < vec_len(v); i = i + 1) {
        if (era_scope(vec_get(v, i)) == SCOPE_GLOBAL) { n = n + 1; }
    }
    return n;
}

# Position of record `p` in table `t`, or -1.
fn _table_index(t, p) {
    for (var i = 0; i < vec_len(t); i = i + 1) {
        if (vec_get(t, i) == p) { return i; }
    }
    return 0 - 1;
}

# 1 when `view` holds every record of `table`, ordered by the i64 at `off`,
# and records sharing a key keep their table order (a stable sort).
fn _view_ok(view, table, off) {
    if (vec_len(view) != vec_len(table)) { return 0; }
    for (var i = 1; i < vec_len(view); i = i + 1) {
        var a = vec_get(view, i - 1);
        var b = vec_get(view, i);
        if (load64(a + off) > load64(b + off)) { return 0; }
        if (load64(a + off) == load64(b + off)) {
            if (_table_index(table, a) > _table_index(table, b)) { return 0; }
        }
    }
    return 1;
}

# itihas_parse_int: the parsed value, or 777 when it refuses.
fn _pint(txt) {
    var o[8];
    if (itihas_parse_int(str_from(txt), &o) == 0) { return 777; }
    return load64(&o);
}

# A tool call's name and arguments as Strs, or 0.
fn _tc_name(body) {
    var tc = _extract_tool_call(body, strlen(body));
    if (tc == 0) { return 0; }
    return load64(tc);
}
fn _tc_args(body) {
    var tc = _extract_tool_call(body, strlen(body));
    if (tc == 0) { return 0; }
    return load64(tc + 8);
}

# ---------------------------------------------------------------
# Decoder helpers (*_from_json)
# ---------------------------------------------------------------
# The message of decoding JSON text `js` (a C string) with `decode`, one of the
# *_from_json_text functions; "Ok" when it decodes.
fn _de_msg(decode, js) {
    var t, x = fncall1(decode, str_from(js));
    if (is_ok(t) == 1) { return str_from("Ok"); }
    return itihas_err_msg(x);
}

# Assert that decoding `js` gives exactly the message `want`; print what it gave if not.
fn _de_is(decode, js, want, name) {
    var got = _de_msg(decode, js);
    var same = str_eq(got, str_from(want));
    if (same != 1) { str_println(got); }
    return check(same, 1, name);
}

# Decode `js` and re-encode it with `enc` (an X_to_json); 0 when the decode fails.
fn _de_reencode(decode, enc, js) {
    var t, x = fncall1(decode, str_from(js));
    if (is_ok(t) != 1) { return 0; }
    return fncall1(enc, x);
}

# How many records of `table` survive encode -> decode -> encode byte-identical,
# each decoded on its own from a fresh parse.
fn _de_round_trips(table, enc, dec) {
    var good = 0;
    var n = vec_len(table);
    for (var i = 0; i < n; i = i + 1) {
        var s1 = fncall1(enc, vec_get(table, i));
        var t, r = fncall1(dec, bayan_json_v_parse(s1));
        if (is_ok(t) == 1) {
            if (str_eq(fncall1(enc, r), s1) == 1) { good = good + 1; } else { str_println(s1); }
        } else { str_println(itihas_err_msg(r)); }
    }
    return good;
}

# 1 when the whole table, written as one JSON array, decodes element by element
# from a single parsed document and re-encodes byte-identical: the way a
# consumer reads records embedded in its own JSON.
fn _de_array_round_trip(table, into_fn, dec) {
    var s1 = _json_array(table, into_fn);
    var arr = bayan_json_v_parse(s1);
    var n = bayan_json_v_arr_len(arr);
    if (n != vec_len(table)) { return 0; }
    var out = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        var t, r = fncall1(dec, bayan_json_v_arr_get(arr, i));
        if (is_ok(t) != 1) { return 0; }
        vec_push(out, r);
    }
    return str_eq(_json_array(out, into_fn), s1);
}

# Assert that decoding a tree built in code, an object holding `key` twice with
# value `val`, gives exactly the message `want`.
fn _de_tree_is(decode, key, val, want, name) {
    var obj = bayan_json_v_obj_new();
    bayan_json_v_obj_set(obj, str_from(key), val);
    bayan_json_v_obj_set(obj, str_from(key), val);
    var t, x = fncall1(decode, obj);
    var got = str_from("Ok");
    if (is_ok(t) != 1) { got = itihas_err_msg(x); }
    var same = str_eq(got, str_from(want));
    if (same != 1) { str_println(got); }
    return check(same, 1, name);
}

# One valid era, the base the key-order and unknown-key cases vary.
var DE_ERA = "{\"name\": \"X\", \"start_year\": 1, \"end_year\": 2, \"region\": \"R\", \"description\": \"D\", \"category\": 0, \"scope\": 0}";   #skip-lint

# The decoder suite: round trips over the tables, then one case per error message.
fn test_decode() {
    println("--- decode: round trips ---");
    check(_de_round_trips(all_eras(), &era_to_json, &era_from_json), era_count(), "every era round-trips byte-identical");   #skip-lint
    check(_de_round_trips(all_civilizations(), &civ_to_json, &civ_from_json), civ_count(), "every civilization round-trips byte-identical");   #skip-lint
    check(_de_round_trips(all_events(), &event_to_json, &event_from_json), event_count(), "every event round-trips byte-identical");   #skip-lint
    check(_de_array_round_trip(all_eras(), &era_to_json_into, &era_from_json), 1, "the era array round-trips from one document");   #skip-lint
    check(_de_array_round_trip(all_civilizations(), &civ_to_json_into, &civ_from_json), 1, "the civilization array round-trips from one document");   #skip-lint
    check(_de_array_round_trip(all_events(), &event_to_json_into, &event_from_json), 1, "the event array round-trips from one document");   #skip-lint

    # A decoded record is a new record with the same fields, the sentinel included.
    var info = era_by_name("Information Age");
    var it, ir = era_from_json_text(era_to_json(info));
    check(is_ok(it), 1, "Information Age decodes");
    ok(ir != info, "the decoded era is a new record");
    check(era_end(ir), ERA_ONGOING, "ERA_ONGOING survives the round trip");
    check(era_cat(ir), CONTEMPORARY, "the category code survives");
    ok(str_eq(era_name(ir), era_name(info)), "the name survives");
    var et, er = event_from_json_text(event_to_json(event_by_name("Fall of the Western Roman Empire")));
    check(is_ok(et), 1, "an event decodes from text");
    check(evt_year(er), 476, "the event year survives");
    check(evt_sig(er), evt_sig(event_by_name("Fall of the Western Roman Empire")), "the significance code survives");   #skip-lint
    var ct, cr = civ_from_json_text(civ_to_json(civ_by_name("Indus Valley")));
    check(is_ok(ct), 1, "a civilization decodes from text");
    zero(str_len(civ_lang(cr)), "an empty language survives");
    check(civ_found(cr), 0 - 3300, "a BCE founding year survives");

    # Strings the tables never hold: every escape class, U+0000, 2- and 4-byte
    # UTF-8, and both i32 bounds.
    var nul = alloc(3);
    store8(nul, 97); store8(nul + 1, 0); store8(nul + 2, 98);
    var hostile = era_new(str_from("Tab\tAnd \"Quote\" \\ /"), 0 - 2147483648, 2147483647,
      str_from("Tenochtitlán, 𒀭"), str_new(nul, 3), CONTEMPORARY, SCOPE_REGIONAL);
    var hs = era_to_json(hostile);
    var hst, hsr = era_from_json(bayan_json_v_parse(hs));
    check(is_ok(hst), 1, "a hostile era decodes");
    ok(str_eq(era_to_json(hsr), hs), "a hostile era re-encodes byte-identical");
    check(str_len(era_desc(hsr)), 3, "U+0000 is kept inside the description");
    check(era_start(hsr), 0 - 2147483648, "i32 min is a year");
    var hc = civ_new(str_from("a\r\nb"), str_from(""), str_from("\x01"), 0 - 1, 1, str_from("x;y"), str_from("ꦏ"), str_from("akk;sux"));   #skip-lint
    var hcs = civ_to_json(hc);
    ok(str_eq(_de_reencode(&civ_from_json_text, &civ_to_json, str_cstr(hcs)), hcs), "a hostile civilization re-encodes byte-identical");   #skip-lint
    var he = evt_new(str_from("\x08\x0c"), 0 - 1, str_from("e"), CAT_COLLAPSE, str_from("\\\""), str_from(""), SIG_LOCAL);   #skip-lint
    var hes = event_to_json(he);
    ok(str_eq(_de_reencode(&event_from_json_text, &event_to_json, str_cstr(hes)), hes), "a hostile event re-encodes byte-identical");   #skip-lint

    # Unknown keys are ignored, and key order does not matter.
    var canon = era_to_json(era_new(str_from("X"), 1, 2, str_from("R"), str_from("D"), ANCIENT, SCOPE_GLOBAL));   #skip-lint
    ok(str_eq(_de_reencode(&era_from_json_text, &era_to_json, DE_ERA), canon), "the base era decodes to its canonical form");   #skip-lint
    ok(str_eq(_de_reencode(&era_from_json_text, &era_to_json,
          "{\"extra\": [1, {\"a\": null}], \"name\": \"X\", \"start_year\": 1, \"end_year\": 2, \"region\": \"R\", \"description\": \"D\", \"category\": 0, \"scope\": 0, \"z\": 5}"),   #skip-lint
        canon), "unknown keys are ignored");
    ok(str_eq(_de_reencode(&era_from_json_text, &era_to_json,
          "{\"scope\": 0, \"category\": 0, \"description\": \"D\", \"region\": \"R\", \"end_year\": 2, \"start_year\": 1, \"name\": \"X\"}"),   #skip-lint
        canon), "keys decode in any order");

    println("--- decode: errors ---");
    var de = &era_from_json_text;
    var dc = &civ_from_json_text;
    var dv = &event_from_json_text;
    # The payload: an ItihasErr with the decode code.
    var xt, xe = era_from_json_text(str_from("[]"));
    check(is_err_result(xt), 1, "a decode failure is an Err");
    check(itihas_err_code(xe), ITIHAS_ERR_DESERIALIZE, "its code is ITIHAS_ERR_DESERIALIZE");
    var nt, ne = era_from_json(0);
    check(is_err_result(nt), 1, "a null node is an Err");
    ok(str_eq(itihas_err_msg(ne), str_from("invalid type: null, expected struct Era")), "a null node reads as null");   #skip-lint
    var fe = itihas_err_new(ITIHAS_ERR_UNKNOWN_ERA, str_from("m"));
    check(itihas_err_code(fe), ITIHAS_ERR_UNKNOWN_ERA, "itihas_err_new stores the code");
    ok(str_eq(itihas_err_msg(fe), str_from("m")), "itihas_err_new stores the message");
    var ft, fv = itihas_fail(ITIHAS_ERR_INVALID_YEAR, str_from("y"));
    check(is_err_result(ft), 1, "itihas_fail is an Err");
    check(itihas_err_code(fv), ITIHAS_ERR_INVALID_YEAR, "itihas_fail carries its code");

    # Not an object.
    _de_is(de, "[1]", "invalid type: sequence, expected struct Era", "an array is not an Era");
    _de_is(de, "\"x\"", "invalid type: string \"x\", expected struct Era", "a string is not an Era");   #skip-lint
    _de_is(de, "null", "invalid type: null, expected struct Era", "null is not an Era");
    _de_is(dc, "5", "invalid type: integer `5`, expected struct Civilization", "an integer is not a Civilization");   #skip-lint
    _de_is(dv, "true", "invalid type: boolean `true`, expected struct Event", "a boolean is not an Event");   #skip-lint
    _de_is(dv, "2.5", "invalid type: floating point `2.5`, expected struct Event", "a float is not an Event");   #skip-lint

    # Missing fields, first in declaration order.
    _de_is(de, "{}", "missing field `name`", "an empty object misses name");
    _de_is(de, "{\"name\": \"X\", \"start_year\": 1, \"end_year\": 2, \"region\": \"R\", \"description\": \"D\", \"category\": 0}",   #skip-lint
      "missing field `scope`", "era without scope");
    _de_is(dc, "{\"name\": \"X\", \"region\": \"R\", \"peak_era\": \"P\", \"founded\": 1, \"ended\": 2, \"traits\": \"t\", \"script\": \"s\"}",   #skip-lint
      "missing field `language`", "civilization without language");
    _de_is(dc, "{\"name\": \"X\", \"founding_year\": 1}", "missing field `region`", "the Rust key founding_year is not founded");   #skip-lint
    _de_is(dv, "{\"name\": \"X\", \"year\": 1, \"era\": \"E\", \"category\": 0, \"description\": \"D\", \"significance\": 0}",   #skip-lint
      "missing field `civilizations`", "event without civilizations");

    # Years: JSON integers that fit i32.
    _de_is(de, "{\"start_year\": \"x\"}", "invalid type: string \"x\", expected i32", "a string year");   #skip-lint
    _de_is(de, "{\"start_year\": \"a\\\"b\"}", "invalid type: string \"a\\\"b\", expected i32", "a string year is quoted with escapes");   #skip-lint
    _de_is(de, "{\"start_year\": 5.0}", "invalid type: floating point `5.0`, expected i32", "a whole float is not an integer");   #skip-lint
    _de_is(de, "{\"end_year\": 1e3}", "invalid type: floating point `1000.0`, expected i32", "an exponent makes a float");   #skip-lint
    _de_is(de, "{\"end_year\": null}", "invalid type: null, expected i32", "a null year");
    _de_is(de, "{\"end_year\": 2147483648}", "invalid value: integer `2147483648`, expected i32", "i32 max + 1");   #skip-lint
    _de_is(de, "{\"start_year\": -2147483649}", "invalid value: integer `-2147483649`, expected i32", "i32 min - 1");   #skip-lint
    _de_is(dc, "{\"founded\": [1]}", "invalid type: sequence, expected i32", "an array year");
    _de_is(dc, "{\"name\": \"X\", \"region\": \"R\", \"peak_era\": \"P\", \"founded\": 1, \"ended\": 1.5}",   #skip-lint
      "invalid type: floating point `1.5`, expected i32", "a fractional civilization year");
    _de_is(dv, "{\"year\": 9223372036854775807}", "invalid value: integer `9223372036854775807`, expected i32", "i64 max is not a year");   #skip-lint
    _de_is(de, "{\"name\": \"X\", \"start_year\": -2147483648, \"end_year\": 2147483647, \"region\": \"R\", \"description\": \"D\", \"category\": 0, \"scope\": 0}",   #skip-lint
      "Ok", "both i32 bounds are years");

    # Enum codes: integers inside their enum.
    _de_is(de, "{\"category\": 9}", "invalid value: integer `9`, expected variant index 0 <= i < 6", "era category 9");   #skip-lint
    _de_is(de, "{\"category\": 6}", "invalid value: integer `6`, expected variant index 0 <= i < 6", "era category one past CONTEMPORARY");   #skip-lint
    _de_is(de, "{\"name\": \"X\", \"start_year\": 1, \"end_year\": 2, \"region\": \"R\", \"description\": \"D\", \"category\": 5, \"scope\": 1}",   #skip-lint
      "Ok", "CONTEMPORARY and SCOPE_REGIONAL are codes");
    _de_is(de, "{\"scope\": 2}", "invalid value: integer `2`, expected variant index 0 <= i < 2", "era scope 2");   #skip-lint
    _de_is(de, "{\"scope\": -1}", "invalid value: integer `-1`, expected variant index 0 <= i < 2", "a negative scope");   #skip-lint
    _de_is(de, "{\"category\": \"Ancient\"}", "invalid type: string \"Ancient\", expected variant index 0 <= i < 6", "the Rust variant name is not a code");   #skip-lint
    _de_is(de, "{\"category\": 0.0}", "invalid type: floating point `0.0`, expected variant index 0 <= i < 6", "a float code");   #skip-lint
    _de_is(dv, "{\"category\": 8}", "invalid value: integer `8`, expected variant index 0 <= i < 8", "event category 8");   #skip-lint
    _de_is(dv, "{\"significance\": 4}", "invalid value: integer `4`, expected variant index 0 <= i < 4", "event significance 4");   #skip-lint
    _de_is(dv, "{\"significance\": false}", "invalid type: boolean `false`, expected variant index 0 <= i < 4", "a boolean significance");   #skip-lint

    # Strings.
    _de_is(de, "{\"name\": 5}", "invalid type: integer `5`, expected a string", "an integer name");
    _de_is(de, "{\"name\": null}", "invalid type: null, expected a string", "a null name");
    _de_is(de, "{\"region\": true}", "invalid type: boolean `true`, expected a string", "a boolean region");   #skip-lint
    _de_is(de, "{\"description\": {}}", "invalid type: map, expected a string", "an object description");   #skip-lint
    _de_is(dc, "{\"traits\": [\"a\", \"b\"]}", "invalid type: sequence, expected a string", "the Rust Vec form of traits is refused");   #skip-lint
    _de_is(dv, "{\"civilizations\": null}", "invalid type: null, expected a string", "a null civilizations list");   #skip-lint

    # Duplicates. bayan's parser refuses a repeated key in text, so only a tree
    # built in code can carry one to a decoder, which refuses it as serde does.
    _de_is(de, "{\"name\": \"a\", \"name\": \"b\"}", "malformed JSON: duplicate key at byte 14", "a repeated key in text never parses");   #skip-lint
    _de_tree_is(&era_from_json, "name", bayan_json_v_str_new(str_from("a")), "duplicate field `name`", "a repeated era name in a built tree");   #skip-lint
    _de_tree_is(&civ_from_json, "founded", bayan_json_v_int_new(1), "duplicate field `founded`", "a repeated founding year in a built tree");   #skip-lint
    _de_tree_is(&event_from_json, "significance", bayan_json_v_int_new(0), "duplicate field `significance`", "a repeated significance in a built tree");   #skip-lint

    # Document order: the first bad field in the document wins.
    _de_is(de, "{\"scope\": 9, \"start_year\": \"x\"}", "invalid value: integer `9`, expected variant index 0 <= i < 2", "scope first: scope reported");   #skip-lint
    _de_is(de, "{\"start_year\": \"x\", \"scope\": 9}", "invalid type: string \"x\", expected i32", "start_year first: start_year reported");   #skip-lint
    _de_is(de, "{\"category\": 9}", "invalid value: integer `9`, expected variant index 0 <= i < 6", "a bad field beats a missing one");   #skip-lint

    # JSON text that does not parse.
    _de_is(de, "{} x", "malformed JSON: trailing content after JSON value at byte 3", "trailing content is refused");   #skip-lint
    ok(str_starts_with(_de_msg(de, "{\"name\": "), str_from("malformed JSON: ")), "truncated text is malformed");   #skip-lint
    ok(str_starts_with(_de_msg(dv, ""), str_from("malformed JSON: ")), "empty text is malformed");
    var zt, zv = era_from_json_text(0);
    check(is_err_result(zt), 1, "a null Str is an Err, not a fault");
    return 0;
}

# The suite, one section per module and per regression set; returns the failure count.
fn main() {
    alloc_init();
    println("=== itihas test suite ===");

    # ---------------------------------------------------------------
    # Era struct layout — the #derive(accessors) Era struct must map
    # field-for-field onto the EraOff offsets, and sizeof must be 56.
    # This is what makes an offset renumber a test failure instead of
    # silent field aliasing; serial.cyr and the comparators still read
    # some fields by offset, so the two views have to stay in step.
    # ---------------------------------------------------------------
    println("--- era struct layout ---");
    check(ERA_SIZE, 56, "ERA_SIZE=56");
    var lp = xalloc(ERA_SIZE);
    Era_set_name(lp, 11);        check(load64(lp + ERA_NAME), 11, "Era_set_name -> ERA_NAME");
    Era_set_start_year(lp, 22);  check(load64(lp + ERA_START), 22, "Era_set_start_year -> ERA_START");
    Era_set_end_year(lp, 33);    check(load64(lp + ERA_END), 33, "Era_set_end_year -> ERA_END");
    Era_set_region(lp, 44);      check(load64(lp + ERA_REGION), 44, "Era_set_region -> ERA_REGION");
    Era_set_description(lp, 55); check(load64(lp + ERA_DESC), 55, "Era_set_description -> ERA_DESC");
    Era_set_category(lp, 66);    check(load64(lp + ERA_CAT), 66, "Era_set_category -> ERA_CAT");
    Era_set_scope(lp, 77);       check(load64(lp + ERA_SCOPE), 77, "Era_set_scope -> ERA_SCOPE");
    store64(lp + ERA_START, 99); check(Era_start_year(lp), 99, "Era_start_year reads ERA_START");
    store64(lp + ERA_DESC, 88);  check(era_desc(lp), 88, "era_desc reads ERA_DESC");

    # ---------------------------------------------------------------
    # Module counts
    # ---------------------------------------------------------------
    println("--- counts ---");
    check(era_count(), 25, "era_count=25");
    check(calendar_count(), 8, "calendar_count=8");
    check(civ_count(), 53, "civ_count=53");
    check(figure_count(), 52, "figure_count=52");
    check(event_count(), 105, "event_count=105");
    check(causality_count(), 13, "causality_count=13");
    check(interaction_count(), 21, "interaction_count=21");
    check(campaign_count(), 14, "campaign_count=14");
    check(site_count(), 32, "site_count=32");
    check(route_count(), 15, "route_count=15");

    # ---------------------------------------------------------------
    # Era lookups
    # ---------------------------------------------------------------
    println("--- era ---");
    ok(era_by_name("Bronze Age"), "era Bronze Age");
    ok(era_by_name("Information Age"), "era Information Age");
    zero(era_by_name("Space Age"), "era Space Age not found");
    ok(vec_len(eras_containing(2025)) > 0, "eras containing 2025");
    ok(vec_len(eras_containing((0-500))) > 0, "eras containing -500");
    check(vec_len(eras_containing((0-50000))), 0, "eras containing -50000 empty");
    ok(vec_len(eras_by_scope(SCOPE_GLOBAL)) > 0, "eras global");
    ok(vec_len(eras_by_scope(SCOPE_REGIONAL)) > 0, "eras regional");
    ok(vec_len(eras_by_region("East Asia")) > 0, "eras East Asia");
    ok(vec_len(eras_by_region("South Asia")) > 0, "eras South Asia");
    check(vec_len(eras_by_region("Mesoamerica")), 3, "eras Mesoamerica=3");

    # ---------------------------------------------------------------
    # Calendar lookups
    # ---------------------------------------------------------------
    println("--- calendar ---");
    ok(calendar_by_name("Gregorian"), "cal Gregorian");
    ok(calendar_by_name("Islamic (Hijri)"), "cal Hijri");
    ok(calendar_by_name("Maya (Long Count)"), "cal Maya");
    zero(calendar_by_name("Martian"), "cal Martian not found");

    # ---------------------------------------------------------------
    # Civilization lookups
    # ---------------------------------------------------------------
    println("--- civilization ---");
    ok(civ_by_name("Mesopotamia"), "civ Mesopotamia");
    ok(civ_by_name("Ancient Greece"), "civ Ancient Greece");
    ok(civ_by_name("Tokugawa Shogunate"), "civ Tokugawa");
    zero(civ_by_name("Atlantis"), "civ Atlantis not found");
    ok(vec_len(civs_active_at((0-500))) > 0, "civs active -500");
    ok(vec_len(civs_by_region("Near East")) > 0, "civs Near East");
    check(vec_len(civs_active_at((0-100000))), 0, "civs active -100000 empty");

    # ---------------------------------------------------------------
    # Figure lookups
    # ---------------------------------------------------------------
    println("--- figure ---");
    ok(figure_by_name("Aristotle"), "fig Aristotle");
    ok(figure_by_name("Ada Lovelace"), "fig Ada Lovelace");
    zero(figure_by_name("Gandalf"), "fig Gandalf not found");
    ok(vec_len(figures_by_domain(DOM_RULER)) > 0, "fig domain Ruler");
    ok(vec_len(figures_by_domain(DOM_SCIENTIST)) > 0, "fig domain Scientist");
    ok(vec_len(figures_by_domain(DOM_EXPLORER)) > 0, "fig domain Explorer");

    # ---------------------------------------------------------------
    # Event lookups
    # ---------------------------------------------------------------
    println("--- event ---");
    ok(event_by_name("French Revolution"), "evt French Revolution");
    ok(event_by_name("Fall of Constantinople"), "evt Fall of Constantinople");
    zero(event_by_name("Battle of Endor"), "evt Battle of Endor not found");
    ok(vec_len(events_by_category(CAT_WAR)) > 0, "evt cat War");
    ok(vec_len(events_by_category(CAT_INVENTION)) > 0, "evt cat Invention");
    ok(vec_len(events_by_significance(SIG_GLOBAL)) > 0, "evt sig Global");
    ok(vec_len(events_at_year(476)) > 0, "evt at_year 476");
    ok(vec_len(events_at_year((0-753))) > 0, "evt at_year -753");
    ok(vec_len(events_between((0-800), 476)) > 0, "evt between -800..476");

    # Verify events_at_year returns correct year
    var evts_476 = events_at_year(476);
    var evt0 = vec_get(evts_476, 0);
    check(evt_year(evt0), 476, "evt at_year returns year 476");

    # ---------------------------------------------------------------
    # Causality lookups
    # ---------------------------------------------------------------
    println("--- causality ---");
    ok(vec_len(causes_of("French Revolution")) > 0, "causes of French Rev");
    ok(vec_len(effects_of("Invention of Writing")) > 0, "effects of Writing");
    var chain = causal_chain("Invention of Writing", 3);
    ok(vec_len(chain) > 0, "chain from Writing depth 3");
    # Code of Hammurabi should be at depth 1
    var ch0 = vec_get(chain, 0);
    ok(str_eq(chain_entry_name(ch0), "Code of Hammurabi") == 1, "chain[0] = Code of Hammurabi");
    check(chain_entry_depth(ch0), 1, "chain[0] depth=1");

    # ---------------------------------------------------------------
    # Interaction lookups
    # ---------------------------------------------------------------
    println("--- interaction ---");
    ok(vec_len(interactions_for("Roman Empire")) > 0, "int for Rome");
    ok(influence_score("Ancient Egypt", "Hittite Empire") > 0, "inf score Egypt-Hittite");
    # Symmetric
    check(influence_score("Ancient Egypt", "Hittite Empire"), influence_score("Hittite Empire", "Ancient Egypt"),
      "inf score symmetric");
    check(influence_score("Inca Empire", "Ancient China"), 0, "inf score unrelated=0");
    ok(vec_len(interactions_by_type(INT_WAR)) > 0, "int type War");
    ok(vec_len(interactions_by_type(INT_TRADE)) > 0, "int type Trade");
    var rome_nbrs = interaction_neighbors("Roman Empire");
    ok(vec_len(rome_nbrs) > 0, "Rome has neighbors");
    ok(vec_len(interactions_between("Ancient Egypt", "Hittite Empire")) >= 2, "Egypt-Hittite >= 2 interactions");

    # ---------------------------------------------------------------
    # Campaign lookups
    # ---------------------------------------------------------------
    println("--- campaign ---");
    ok(campaign_by_name("Napoleonic Wars"), "camp Napoleonic");
    zero(campaign_by_name("Star Wars"), "camp Star Wars not found");
    ok(vec_len(campaigns_by_outcome(OUT_VICTORY)) > 0, "camp outcome Victory");
    ok(vec_len(campaigns_by_commander("Napoleon")) > 0, "camp cmd Napoleon");
    ok(vec_len(campaigns_by_region("Europe")) > 0, "camp region Europe");
    ok(vec_len(campaigns_by_civilization("Roman Republic")) > 0, "camp civ Roman Republic");
    ok(vec_len(campaigns_between((0-500), (0-200))) > 0, "camp between -500..-200");

    # ---------------------------------------------------------------
    # Site lookups
    # ---------------------------------------------------------------
    println("--- site ---");
    ok(site_by_name("Machu Picchu"), "site Machu Picchu");
    ok(site_by_name("Pompeii"), "site Pompeii");
    zero(site_by_name("Atlantis"), "site Atlantis not found");
    ok(vec_len(sites_by_region("Near East")) > 0, "sites Near East");
    ok(vec_len(sites_by_type(ST_TEMPLE)) > 0, "sites type Temple");
    ok(vec_len(sites_active_at((0-500))) > 0, "sites active -500");
    ok(vec_len(sites_by_civilization("Ancient Egypt")) > 0, "sites civ Egypt");

    # ---------------------------------------------------------------
    # Trade route lookups
    # ---------------------------------------------------------------
    println("--- trade ---");
    ok(route_by_name("Silk Road"), "route Silk Road");
    zero(route_by_name("Route 66"), "route Route 66 not found");
    ok(vec_len(routes_by_commodity("silk")) > 0, "routes commodity silk");
    ok(vec_len(routes_by_region("East Asia")) > 0, "routes region East Asia");
    ok(vec_len(routes_by_type(ROUTE_MARITIME)) > 0, "routes type Maritime");
    ok(vec_len(routes_by_civilization("Roman Empire")) > 0, "routes civ Rome");
    ok(vec_len(routes_active_at(1000)) > 0, "routes active 1000");

    # ---------------------------------------------------------------
    # Integration: cross-module validation
    # ---------------------------------------------------------------
    println("--- integration ---");

    # Era date ordering: start < end for all eras
    var era_dates_ok = 1;
    var ev = all_eras();
    var en = vec_len(ev);
    for (var i = 0; i < en; i = i + 1) {
        var p = vec_get(ev, i);
        if (era_start(p) >= era_end(p)) { era_dates_ok = 0; }
    }
    ok(era_dates_ok, "era start < end for all");

    # Civ date ordering: founding < end for all
    var civ_dates_ok = 1;
    var cv = all_civilizations();
    var cn = vec_len(cv);
    for (var ci = 0; ci < cn; ci = ci + 1) {
        var p = vec_get(cv, ci);
        if (civ_found(p) >= civ_end(p)) { civ_dates_ok = 0; }
    }
    ok(civ_dates_ok, "civ founding < end for all");

    # Campaign date ordering: start <= end
    var camp_dates_ok = 1;
    var cpv = all_campaigns();
    var cpn = vec_len(cpv);
    for (var cpi = 0; cpi < cpn; cpi = cpi + 1) {
        var p = vec_get(cpv, cpi);
        if (load64(p+CAMP_START) > load64(p+CAMP_END)) { camp_dates_ok = 0; }
    }
    ok(camp_dates_ok, "campaign start <= end for all");

    # Site date ordering: start <= end
    var site_dates_ok = 1;
    var sv = all_sites();
    var sn = vec_len(sv);
    for (var sti = 0; sti < sn; sti = sti + 1) {
        var p = vec_get(sv, sti);
        if (load64(p+SITE_START) > load64(p+SITE_END)) { site_dates_ok = 0; }
    }
    ok(site_dates_ok, "site start <= end for all");

    # Route date ordering: start <= end
    var route_dates_ok = 1;
    var rv = all_routes();
    var rn = vec_len(rv);
    for (var rti = 0; rti < rn; rti = rti + 1) {
        var p = vec_get(rv, rti);
        if (load64(p+ROUTE_START) > load64(p+ROUTE_END)) { route_dates_ok = 0; }
    }
    ok(route_dates_ok, "route start <= end for all");

    # Eras + civs at 500 BCE should both return results
    ok(vec_len(eras_containing((0-500))) > 0 && vec_len(civs_active_at((0-500))) > 0, "500 BCE has eras and civs");

    # Boundary: Mesopotamia founding year is active
    var mesop = civ_by_name("Mesopotamia");
    ok(mesop, "Mesopotamia exists");
    var mesop_civs = civs_active_at(civ_found(mesop));
    var found_mesop = 0;
    var mn = vec_len(mesop_civs);
    for (var mi = 0; mi < mn; mi = mi + 1) {
        if (str_eq(civ_name(vec_get(mesop_civs, mi)), "Mesopotamia") == 1) { found_mesop = 1; }
    }
    ok(found_mesop, "Mesopotamia active at own founding year");

    # Region proximity
    check(region_proximity("Mesopotamia", "Assyrian Empire"), 100, "prox Mesopotamia-Assyria=100");
    ok(region_proximity("Roman Empire", "Ancient Greece") >= 50, "prox Rome-Greece >= 50");
    check(region_proximity("Inca Empire", "Ancient China"), 0, "prox Inca-China=0");
    check(region_proximity("Atlantis", "Ancient Greece"), 0, "prox unknown=0");
    # Symmetric
    check(region_proximity("Roman Empire", "Ancient Greece"), region_proximity("Ancient Greece", "Roman Empire"),
      "prox symmetric");

    # Logging init (just verify it doesn't crash)
    itihas_log_init();
    ok(1, "log init does not crash");

    # Rome active at end year (476)
    var rome_civs = civs_active_at(476);
    var found_rome = 0;
    var rmn = vec_len(rome_civs);
    for (var ri = 0; ri < rmn; ri = ri + 1) {
        if (str_eq(civ_name(vec_get(rome_civs, ri)), "Roman Empire") == 1) { found_rome = 1; }
    }
    ok(found_rome, "Roman Empire active at end year 476");

    # ---------------------------------------------------------------
    # Case-insensitive lookups
    # ---------------------------------------------------------------
    println("--- case-insensitive ---");
    ok(era_by_name("bronze age"), "era lowercase");
    ok(era_by_name("BRONZE AGE"), "era uppercase");
    ok(era_by_name("Bronze Age"), "era mixed case");
    ok(civ_by_name("roman empire"), "civ lowercase");
    ok(civ_by_name("ROMAN EMPIRE"), "civ uppercase");
    ok(event_by_name("fall of the western roman empire"), "event lowercase");
    ok(figure_by_name("JULIUS CAESAR"), "figure uppercase");
    ok(calendar_by_name("gregorian"), "calendar lowercase");
    ok(campaign_by_name("second punic war"), "campaign lowercase");
    ok(site_by_name("POMPEII"), "site uppercase");
    ok(route_by_name("silk road"), "route lowercase");

    # ---------------------------------------------------------------
    # Chronological sort
    # ---------------------------------------------------------------
    println("--- sort ---");
    var sorted_events = events_between(-500, 500);
    var sort_ok = 1;
    for (var si = 1; si < vec_len(sorted_events); si = si + 1) {
        if (evt_year(vec_get(sorted_events, si)) < evt_year(vec_get(sorted_events, si - 1))) { sort_ok = 0; }
    }
    ok(sort_ok, "events_between sorted by year");

    var sorted_camps = campaigns_between(-500, 500);
    var camp_sort_ok = 1;
    for (var sci = 1; sci < vec_len(sorted_camps); sci = sci + 1) {
        var camp_start_cur = camp_start(vec_get(sorted_camps, sci));
        var camp_start_prev = camp_start(vec_get(sorted_camps, sci - 1));
        if (camp_start_cur < camp_start_prev) { camp_sort_ok = 0; }
    }
    ok(camp_sort_ok, "campaigns_between sorted by start");

    var sorted_eras = eras_containing(500);
    var era_sort_ok = 1;
    for (var sei = 1; sei < vec_len(sorted_eras); sei = sei + 1) {
        if (era_start(vec_get(sorted_eras, sei)) < era_start(vec_get(sorted_eras, sei - 1))) { era_sort_ok = 0; }
    }
    ok(era_sort_ok, "eras_containing sorted by start");

    # ---------------------------------------------------------------
    # JSON serialization
    # ---------------------------------------------------------------
    println("--- json ---");
    var bronze = era_by_name("Bronze Age");
    var bronze_json = era_to_json(bronze);
    ok(str_contains(bronze_json, "Bronze Age"), "era json has name");
    ok(str_contains_cstr(bronze_json, "start_year"), "era json has start_year");

    var rome = civ_by_name("Roman Empire");
    var rome_json = civ_to_json(rome);
    ok(str_contains(rome_json, "Roman Empire"), "civ json has name");

    var fall = event_by_name("Fall of the Western Roman Empire");
    var fall_json = event_to_json(fall);
    ok(str_contains(fall_json, "Fall of the Western Roman Empire"), "event json has name");
    ok(str_contains_cstr(fall_json, "\"year\": 476"), "event json has year");

    var caesar = figure_by_name("Julius Caesar");
    var caesar_json = figure_to_json(caesar);
    ok(str_contains(caesar_json, "Julius Caesar"), "figure json has name");

    var greg = calendar_by_name("Gregorian");
    var greg_json = calendar_to_json(greg);
    ok(str_contains(greg_json, "Gregorian"), "calendar json has name");

    var punic = campaign_by_name("Second Punic War");
    var punic_json = campaign_to_json(punic);
    ok(str_contains(punic_json, "Second Punic War"), "campaign json has name");
    ok(str_contains_cstr(punic_json, "battles"), "campaign json has battles");
    ok(str_contains_cstr(punic_json, "Cannae"), "campaign json has battle name");

    var pomp = site_by_name("Pompeii");
    var pomp_json = site_to_json(pomp);
    ok(str_contains(pomp_json, "Pompeii"), "site json has name");

    var silk = route_by_name("Silk Road");
    var silk_json = route_to_json(silk);
    ok(str_contains(silk_json, "Silk Road"), "route json has name");

    # ---------------------------------------------------------------
    # Hoosh: answer_from_data
    # ---------------------------------------------------------------
    println("--- hoosh ---");

    # EventsInRange — known range
    var eq = query_events_in_range((0-500), 500);
    var er = answer_from_data(eq);
    ok(er, "events_in_range returns data");
    check(resp_source(er), SRC_DATA, "events source=DATA");
    ok(str_len(resp_content(er)) > 0, "events content not empty");

    # EventsInRange — empty range
    var eq2 = query_events_in_range(9999, 9999);
    var er2 = answer_from_data(eq2);
    ok(er2, "events empty range returns resp");
    ok(str_contains_cstr(resp_content(er2), "No events"), "events empty msg");

    # CivilizationsAt
    var cq = query_civs_at((0-500));
    var cr = answer_from_data(cq);
    ok(cr, "civs_at returns data");
    ok(str_contains(resp_content(cr), "Ancient Greece"), "civs content has Greece");

    # CausesOf — known
    var caq = query_causes_of("French Revolution");
    var car = answer_from_data(caq);
    ok(car, "causes_of known returns data");

    # CausesOf — unknown (needs LLM)
    var caq2 = query_causes_of("Battle of Endor");
    var car2 = answer_from_data(caq2);
    check(car2, 0, "causes_of unknown returns 0");

    # InteractionsBetween — known
    var iq = query_interactions_between("Ancient Egypt", "Hittite Empire");
    var ir = answer_from_data(iq);
    ok(ir, "interactions known returns data");

    # FigureLookup — found
    var fq = query_figure_lookup("Aristotle");
    var fr = answer_from_data(fq);
    ok(fr, "figure found returns data");
    ok(str_contains_cstr(resp_content(fr), "philosopher"), "figure content has philosopher");

    # FigureLookup — not found
    var fq2 = query_figure_lookup("Gandalf");
    var fr2 = answer_from_data(fq2);
    check(fr2, 0, "figure not found returns 0");

    # FreeForm — always returns 0
    var ffq = query_free_form("Why did Rome fall?");
    check(answer_from_data(ffq), 0, "free_form returns 0");

    # Tool defs
    check(hoosh_tool_count(), 6, "tool_count=6");
    var tdefs = hoosh_tool_defs_json();
    ok(str_contains_cstr(str_from(tdefs), "events_in_range"), "tools has events_in_range");
    ok(str_contains_cstr(str_from(tdefs), "era_lookup"), "tools has era_lookup");

    # parse_tool_call
    var ptc1 = parse_tool_call("events_in_range", "{\"start\": -500, \"end\": 500}");
    ok(ptc1, "parse events_in_range");
    check(load64(ptc1+Q_TYPE), QT_EVENTS_IN_RANGE, "parse type=events");

    var ptc2 = parse_tool_call("civilizations_at", "{\"year\": -500}");
    ok(ptc2, "parse civs_at");
    check(load64(ptc2+Q_TYPE), QT_CIVS_AT, "parse type=civs");

    var ptc3 = parse_tool_call("causes_of", "{\"event\": \"French Revolution\"}");
    ok(ptc3, "parse causes_of");

    var ptc4 = parse_tool_call("interactions_between", "{\"civ_a\": \"Rome\", \"civ_b\": \"Egypt\"}");
    ok(ptc4, "parse interactions");

    var ptc5 = parse_tool_call("figure_lookup", "{\"name\": \"Aristotle\"}");
    ok(ptc5, "parse figure_lookup");

    check(parse_tool_call("unknown_tool", "{}"), 0, "parse unknown=0");
    check(parse_tool_call("events_in_range", "{}"), 0, "parse missing args=0");

    # resolve_era_lookup
    var era_args1 = bayan_json_parse(str_from("{\"name\": \"Bronze Age\"}"));
    var elr1 = resolve_era_lookup(era_args1);
    ok(elr1, "era lookup by name");
    ok(str_contains(resp_content(elr1), "Bronze Age"), "era content has name");

    var era_args2 = bayan_json_parse(str_from("{\"year\": -500}"));
    var elr2 = resolve_era_lookup(era_args2);
    ok(elr2, "era lookup by year");

    var era_args3 = bayan_json_parse(str_from("{\"name\": \"Space Age\"}"));
    var elr3 = resolve_era_lookup(era_args3);
    check(elr3, 0, "era lookup unknown=0");

    # ---------------------------------------------------------------
    # Query tracing
    # ---------------------------------------------------------------
    println("--- tracing ---");
    # The Rust original traced every query entry; the port kept the logging
    # module but never called it. 45 sites are restored (42 data + 3 hoosh),
    # each gated on the level so a build with logging off pays one call and one
    # compare. The regression risk is a trace call breaking the query it sits
    # in front of, so every traced shape is re-asserted with DEBUG on.
    check(sakshi_get_level() >= 0, 1, "trace: sakshi level readable");
    itihas_log_init_level(SK_DEBUG);
    check(vec_len(eras_containing(500)) > 0, 1, "trace: eras_containing works at DEBUG");
    ok(era_by_name("Bronze Age"), "trace: era_by_name works at DEBUG");
    check(vec_len(civs_by_region("Mediterranean")) > 0, 1, "trace: civs_by_region works at DEBUG");
    check(vec_len(events_between(-500, 500)) > 0, 1, "trace: events_between (range shape) works at DEBUG");
    check(influence_score("Ancient Egypt", "Hittite Empire"), 7,
      "trace: influence_score (pair shape) unchanged at DEBUG");
    check(vec_len(causes_of("French Revolution")), 2, "trace: causes_of unchanged at DEBUG");
    check(vec_len(campaigns_by_commander("Napoleon")) > 0, 1, "trace: campaigns_by_commander works at DEBUG");
    check(vec_len(routes_by_commodity("silk")), 2, "trace: routes_by_commodity unchanged at DEBUG");
    check(vec_len(sites_by_region("Near East")) > 0, 1, "trace: sites_by_region works at DEBUG");
    # Restore quiet so the rest of the suite is not noisy.
    itihas_log_init_level(SK_ERROR);
    check(vec_len(eras_containing(500)) > 0, 1, "trace: queries unchanged with tracing off");

    # ---------------------------------------------------------------
    # Checked allocation (CWE-690)
    # ---------------------------------------------------------------
    println("--- xalloc ---");
    # Every allocation site in itihas writes into its result immediately, so an
    # unchecked alloc under exhaustion is a near-NULL write. xalloc aborts
    # instead (exit 134 = 128 + SIGABRT), following avatara's ADR-009.
    # The abort path cannot be asserted from in-process — it exits — so this
    # covers the success path and that the memory is actually usable.
    var xa = xalloc(64);
    ok(xa, "xalloc returns a pointer");
    store64(xa, 0x1234);
    check(load64(xa), 0x1234, "xalloc memory is writable and reads back");
    var xb = xalloc(8);
    ok(xb != xa, "xalloc hands out distinct blocks");
    # xalloc(0) is NOT tested here: the stdlib alloc() returns 0 for a
    # zero-size request, so xalloc aborts — deliberately, and with a distinct
    # "non-positive size" diagnostic rather than a misleading OOM message,
    # because that is a caller bug. No itihas call site can reach it: every
    # size is either a positive struct-size constant or `len + 1`.

    # ---------------------------------------------------------------
    # 2.4.2 regressions — util helpers
    # ---------------------------------------------------------------
    println("--- util helpers ---");
    ok(str_eq(str_lower(str_from("MiXeD Case 123")), str_from("mixed case 123")), "str_lower ASCII");
    ok(str_eq(str_upper(str_from("MiXeD Case 123")), str_from("MIXED CASE 123")), "str_upper ASCII");
    check(str_eq_lower(str_from("Bronze Age"), str_from("BRONZE age")), 1, "str_eq_lower folds");
    check(str_eq_lower(str_from("abc"), str_from("abcd")), 0, "str_eq_lower length differs");

    # Whole-token membership: the bug this replaced matched "Roman Empire"
    # inside "Holy Roman Empire".
    var toks = str_from("Holy Roman Empire;Spanish Empire");
    check(str_list_has(toks, str_from("Roman Empire"), 59), 0, "list_has rejects inner substring");
    check(str_list_has(toks, str_from("Holy Roman Empire"), 59), 1, "list_has first token");
    check(str_list_has(toks, str_from("Spanish Empire"), 59), 1, "list_has last token");
    check(str_list_has(toks, str_from("spanish empire"), 59), 1, "list_has is case-insensitive");
    check(str_list_has(toks, str_from(""), 59), 0, "list_has empty needle");
    check(str_list_has(str_from("French Empire"), str_from("French Empire"), 59), 1, "list_has single token");
    # Name matching allows a leading whole-word prefix but not a partial word.
    check(str_list_has_name(str_from("Darius III;Alexander"), str_from("Darius I"), 59), 0,
      "name rejects Darius I/III");
    check(str_list_has_name(str_from("Napoleon Bonaparte"), str_from("Napoleon"), 59), 1, "name allows surname prefix");
    check(str_list_has_name(str_from("Napoleon Bonaparte"), str_from("Napo"), 59), 0, "name rejects partial word");

    # JSON escaping must cover every C0 control, not just " \ and LF.
    var esb = str_builder_new();
    json_escape_into(esb, str_from("q\"b\\s\tt\rc\nn"));
    var escaped = str_builder_build(esb);
    ok(str_contains_cstr(escaped, "\\\""), "escape quote");
    ok(str_contains_cstr(escaped, "\\\\"), "escape backslash");
    ok(str_contains_cstr(escaped, "\\t"), "escape tab");
    ok(str_contains_cstr(escaped, "\\r"), "escape CR");
    ok(str_contains_cstr(escaped, "\\n"), "escape LF");
    ok(str_eq(json_unescape(escaped), str_from("q\"b\\s\tt\rc\nn")), "escape/unescape roundtrip");
    ok(str_eq(json_unescape(str_from("caf\\u00e9")), str_from("café")), "unescape \\u to UTF-8");
    ok(str_eq(json_unescape(str_from("plain")), str_from("plain")), "unescape passthrough");

    # ---------------------------------------------------------------
    # 2.4.2 regressions — query semantics
    # ---------------------------------------------------------------
    println("--- query semantics ---");
    # campaigns_by_civilization used to return the Thirty Years' War for
    # "Roman Empire", matched inside "Holy Roman Empire".
    check(vec_len(campaigns_by_civilization("Roman Empire")), 0, "no campaign lists Roman Empire");
    check(vec_len(campaigns_by_civilization("Roman Republic")), 2, "Roman Republic has 2 campaigns");
    check(vec_len(campaigns_by_civilization("Holy Roman Empire")), 1, "Holy Roman Empire exact");
    check(vec_len(campaigns_by_commander("Darius I")), 1, "Darius I excludes Darius III");
    ok(vec_len(campaigns_by_commander("Napoleon")) > 0, "Napoleon surname still resolves");
    check(vec_len(routes_by_commodity("silk")), 2, "routes_by_commodity silk exact");

    # Referential integrity restored by the 2.4.2 data corrections.
    ok(vec_len(routes_by_civilization("Viking/Norse")) > 0, "Viking/Norse route resolves");
    ok(vec_len(sites_by_civilization("Great Zimbabwe")) > 0, "Great Zimbabwe site resolves");

    # Causality and interaction lookups now fold case like every *_by_name.
    check(vec_len(causes_of("french revolution")), vec_len(causes_of("French Revolution")), "causes_of folds case");
    check(vec_len(effects_of("invention of writing")), vec_len(effects_of("Invention of Writing")),
      "effects_of folds case");
    check(vec_len(interactions_for("roman empire")), vec_len(interactions_for("Roman Empire")),
      "interactions_for folds case");
    check(vec_len(interactions_between("roman empire", "ancient egypt")),
      vec_len(interactions_between("Roman Empire", "Ancient Egypt")), "interactions_between folds case");
    zero(vec_len(causes_of("No Such Event")), "causes_of unknown = 0");
    zero(vec_len(effects_of("No Such Event")), "effects_of unknown = 0");

    # causal_chain depth invariant: nothing may exceed max_depth.
    zero(vec_len(causal_chain("Invention of Writing", 0)), "causal_chain depth 0 = empty");
    ok(vec_len(causal_chain("Invention of Writing", 1)) > 0, "causal_chain depth 1 non-empty");
    var chain3 = causal_chain("Invention of Writing", 3);
    var depth_ok = 1;
    for (var ci = 0; ci < vec_len(chain3); ci = ci + 1) {
        if (load64(vec_get(chain3, ci) + CH_DEPTH) > 3) { depth_ok = 0; }
    }
    ok(depth_ok, "causal_chain respects max_depth");

    # An empty region needle used to match every record.
    zero(vec_len(civs_by_region(str_from(""))), "civs_by_region empty = 0");
    zero(vec_len(eras_by_region(str_from(""))), "eras_by_region empty = 0");

    # campaigns_active_at had no test at all; 1453 pins both inclusive endpoints.
    ok(vec_len(campaigns_active_at(1453)) > 0, "campaigns_active_at 1453");
    zero(vec_len(campaigns_active_at(-5000)), "campaigns_active_at prehistory = 0");

    # Ongoing-era sentinel.
    check(era_is_ongoing(era_by_name("Information Age")), 1, "Information Age is ongoing");
    check(era_is_ongoing(era_by_name("Bronze Age")), 0, "Bronze Age is not ongoing");

    # Corrected data values.
    check(cal_epoch(calendar_by_name("Hebrew")), -3761, "Hebrew epoch is 3761 BCE");
    check(civ_found(civ_by_name("Chola Dynasty")), 848, "Chola founded 848");

    # ---------------------------------------------------------------
    # 2.4.2 regressions — serializer escaping and round-trip
    # ---------------------------------------------------------------
    println("--- json escaping ---");
    var hostile = era_new(str_from("Tab\tAnd \"Quote\""), 1, 2, str_from("R"),
      str_from("back\\slash\r\nlines"), ANCIENT, SCOPE_GLOBAL);
    var hj = era_to_json(hostile);
    ok(bayan_json_parse(hj), "hostile era json parses");
    ok(str_contains_cstr(hj, "\\t"), "hostile era escapes tab");
    ok(str_contains_cstr(hj, "\\r"), "hostile era escapes CR");
    # bayan_json_get_by_cstr returns the RAW escaped span, so the decode step is the
    # caller's; json_unescape is the inverse of what the serializer emitted.
    var hp = bayan_json_parse(hj);
    ok(str_eq(json_unescape(bayan_json_get_by_cstr(hp, "name")), str_from("Tab\tAnd \"Quote\"")), "hostile name round-trips");   #skip-lint

    # The three *_to_json functions with no previous assertions.
    var caus0 = vec_get(all_causalities(), 0);
    ok(bayan_json_parse(causality_to_json(caus0)), "causality json parses");
    var int0 = vec_get(all_interactions(), 0);
    ok(bayan_json_parse(interaction_to_json(int0)), "interaction json parses");
    var camp0 = vec_get(all_campaigns(), 0);
    ok(bayan_json_parse(campaign_to_json(camp0)), "campaign json parses");

    # resp_data had zero call sites anywhere in the repo.
    var rdq = query_causes_of(str_from("French Revolution"));
    var rdr = answer_from_data(rdq);
    ok(rdr, "causes_of data response");
    ok(bayan_json_parse(resp_data(rdr)), "resp_data is valid json");

    # ---------------------------------------------------------------
    # 2.4.2 regressions — hoosh wire path (no network required)
    # ---------------------------------------------------------------
    println("--- hoosh wire ---");
    var hbuf = alloc(2048);
    var hlen = _build_post_header(hbuf, "/v1/chat/completions", "localhost", 123);
    ok(hlen > 0, "post header built");
    var hstr = str_from_buf(hbuf, hlen);
    ok(str_contains_cstr(hstr, "Content-Type: application/json\r\n"), "full Content-Type header");
    ok(str_contains_cstr(hstr, "Content-Length: 123\r\n"), "Content-Length correct");
    ok(str_contains_cstr(hstr, "POST /v1/chat/completions HTTP/1.0\r\n"), "request line");

    # The wire shape hoosh actually emits: arguments as a JSON-ENCODED STRING.
    var wire_esc = "{\"choices\":[{\"message\":{\"tool_calls\":[{\"function\":{\"name\":\"causes_of\",\"arguments\":\"{\\\"event\\\": \\\"French Revolution\\\"}\"}}]}}]}";   #skip-lint
    var tc1 = _extract_tool_call(wire_esc, strlen(wire_esc));
    ok(tc1, "extract tool call (escaped args)");
    ok(str_eq(load64(tc1), str_from("causes_of")), "escaped args tool name");
    var q1 = parse_tool_call(load64(tc1), load64(tc1 + 8));
    ok(q1, "escaped args resolve to a query");
    check(load64(q1 + Q_TYPE), QT_CAUSES_OF, "escaped args query type");

    # Object-form arguments must still work (no double-unescape).
    var wire_obj = "{\"tool_calls\":[{\"function\":{\"name\":\"civilizations_at\",\"arguments\":{\"year\": -500}}}]}";
    var tc2 = _extract_tool_call(wire_obj, strlen(wire_obj));
    ok(tc2, "extract tool call (object args)");
    var q2 = parse_tool_call(load64(tc2), load64(tc2 + 8));
    ok(q2, "object args resolve to a query");
    check(load64(q2 + Q_ARG1), -500, "object args value parsed");

    var wire_rng = "{\"tool_calls\":[{\"function\":{\"name\":\"events_in_range\",\"arguments\":\"{\\\"start\\\": -500, \\\"end\\\": 500}\"}}]}";   #skip-lint
    var tc3 = _extract_tool_call(wire_rng, strlen(wire_rng));
    var q3 = parse_tool_call(load64(tc3), load64(tc3 + 8));
    ok(q3, "escaped range args resolve");
    check(load64(q3 + Q_ARG1), -500, "range start value");
    check(load64(q3 + Q_ARG2), 500, "range end value");

    # Hostile/truncated bodies must return 0, not read past the buffer.
    var trunc1 = "{\"tool_calls\":[{\"name\":\"causes_of\",\"arguments\"";
    check(_extract_tool_call(trunc1, strlen(trunc1)), 0, "truncated after arguments = 0");
    var trunc2 = "{\"tool_calls\":[{\"name\":\"causes_of";
    check(_extract_tool_call(trunc2, strlen(trunc2)), 0, "unterminated name = 0");
    var trunc3 = "{\"no tool calls here\"}";
    check(_extract_tool_call(trunc3, strlen(trunc3)), 0, "no tool_calls = 0");

    # _extract_content decodes escapes rather than leaking them to the caller.
    var cbody = "{\"choices\":[{\"message\":{\"content\":\"Line one\\nLine \\\"two\\\"\"}}]}";
    var cout = _extract_content(cbody, strlen(cbody));
    ok(str_contains_cstr(cout, "Line one\nLine \"two\""), "content escapes decoded");
    var cnull = "{\"choices\":[{\"message\":{\"content\":null}}]}";
    check(str_len(_extract_content(cnull, strlen(cnull))), 0, "null content = empty");

    # The outgoing request must stay valid JSON for a hostile question.
    var req = _build_inference_request(str_from("What\tabout \"Rome\"\r\nand C:\\path?"), str_from("llama3.2:1b"));
    ok(bayan_json_parse(req), "inference request is valid json");
    ok(str_contains_cstr(req, "\\t"), "request escapes tab");

    # Offline failure path: port 1 refuses connect immediately.
    check(hoosh_post(1, str_from("{}")), 0, "hoosh_post connect refused = 0");
    check(llm_answer(1, str_from("q"), str_from("m")), 0, "llm_answer connect refused = 0");

    # ---------------------------------------------------------------
    # Public accessor coverage — every getter asserted at least once
    # ---------------------------------------------------------------
    println("--- accessors ---");
    var e0 = era_by_name("Bronze Age");
    ok(str_eq(era_name(e0), str_from("Bronze Age")), "era_name");
    ok(str_len(era_region(e0)) > 0, "era_region");
    check(era_cat(e0), ANCIENT, "era_cat");
    check(era_scope(e0), SCOPE_GLOBAL, "era_scope");
    ok(era_get(0), "era_get");

    var c0 = calendar_by_name("Gregorian");
    ok(str_eq(cal_name(c0), str_from("Gregorian")), "cal_name");
    check(cal_type(c0), CAL_SOLAR, "cal_type");
    check(cal_months(c0), 12, "cal_months");

    var v0 = civ_by_name("Roman Empire");
    ok(str_len(civ_region(v0)) > 0, "civ_region");
    ok(civ_get(0), "civ_get");

    var f0 = figure_by_name("Aristotle");
    ok(str_eq(fig_name(f0), str_from("Aristotle")), "fig_name");
    check(fig_domain(f0), DOM_PHILOSOPHER, "fig_domain");

    var v1 = event_by_name("Fall of the Western Roman Empire");
    ok(str_eq(evt_name(v1), str_from("Fall of the Western Roman Empire")), "evt_name");
    check(evt_cat(v1), CAT_COLLAPSE, "evt_cat");
    ok(evt_sig(v1) >= 0, "evt_sig");

    var k0 = vec_get(all_causalities(), 0);
    ok(str_len(caus_cause(k0)) > 0, "caus_cause");
    ok(str_len(caus_effect(k0)) > 0, "caus_effect");

    var i0 = vec_get(all_interactions(), 0);
    ok(str_len(int_civa(i0)) > 0, "int_civa");
    ok(str_len(int_civb(i0)) > 0, "int_civb");
    ok(int_type(i0) >= 0, "int_type");
    ok(vec_len(split_regions(str_from("Near East, Europe"))) == 2, "split_regions");

    var m0 = vec_get(all_campaigns(), 0);
    ok(str_len(camp_name(m0)) > 0, "camp_name");
    ok(str_len(camp_region(m0)) > 0, "camp_region");
    ok(camp_out(m0) >= 0, "camp_out");
    ok(str_len(camp_cmds(m0)) > 0, "camp_cmds");
    ok(str_len(camp_bella(m0)) > 0, "camp_bella");
    ok(str_len(camp_bellb(m0)) > 0, "camp_bellb");

    var s0 = vec_get(all_sites(), 0);
    ok(str_len(site_name(s0)) > 0, "site_name");
    ok(str_len(site_region(s0)) > 0, "site_region");

    var r0 = vec_get(all_routes(), 0);
    ok(str_len(rt_name(r0)) > 0, "rt_name");
    ok(str_len(rt_comm(r0)) > 0, "rt_comm");

    # Constructors, used directly rather than only through the build_* tables.
    var ne = era_new(str_from("Test Era"), 1, 2, str_from("R"), str_from("d"), MODERN, SCOPE_REGIONAL);
    check(era_start(ne), 1, "era_new");
    var nc = cal_new(str_from("Test Cal"), CAL_SOLAR, 1, 12, str_from("none"));
    check(cal_months(nc), 12, "cal_new");
    var nv = civ_new(str_from("Test Civ"), str_from("R"), str_from("E"), 1, 2, str_from("t"), str_from("s"),
      str_from("l"));
    check(civ_found(nv), 1, "civ_new");
    var nf = fig_new(str_from("Test Fig"), 1, 2, str_from("C"), DOM_SCIENTIST, str_from("d"));
    check(fig_domain(nf), DOM_SCIENTIST, "fig_new");
    var nev = evt_new(str_from("Test Evt"), 5, str_from("E"), CAT_WAR, str_from("d"), str_from("c"), SIG_REGIONAL);
    check(evt_year(nev), 5, "evt_new");
    var nk = caus_new(str_from("A"), str_from("B"), 1, str_from("d"));
    ok(str_eq(caus_cause(nk), str_from("A")), "caus_new");
    var ni = int_new(str_from("A"), str_from("B"), INT_TRADE, 1, 2, str_from("d"));
    check(int_type(ni), INT_TRADE, "int_new");
    var ns = site_new(str_from("Test Site"), str_from("X"), str_from("R"), ST_SETTLEMENT, str_from("C"), 1, 2, 3,
      str_from("d"));
    ok(str_eq(site_name(ns), str_from("Test Site")), "site_new");
    var nr = rt_new(str_from("Test Route"), str_from("R"), ROUTE_LAND, str_from("C"), str_from("goods"), 1, 2,
      str_from("d"));
    ok(str_eq(rt_name(nr), str_from("Test Route")), "rt_new");
    var nm = camp_new(str_from("Test Camp"), str_from("R"), 1, 2, str_from("A"), str_from("B"), str_from("C"),
      OUT_VICTORY, str_from("d"));
    bat_add(nm, str_from("Test Battle"), 1, str_from("Loc"), str_from("d"));
    var nbats = load64(nm + CAMP_BATTLES);
    check(vec_len(nbats), 1, "camp_new + bat_add");
    ok(bayan_json_parse(battle_to_json(vec_get(nbats, 0))), "battle_to_json parses");

    # The build_* table builders, called directly.
    ok(vec_len(build_eras()) > 0, "build_eras");
    ok(vec_len(build_calendars()) > 0, "build_calendars");
    ok(vec_len(build_civs()) > 0, "build_civs");
    ok(vec_len(build_figs()) > 0, "build_figs");
    ok(vec_len(build_events()) > 0, "build_events");
    ok(vec_len(build_causalities()) > 0, "build_causalities");
    ok(vec_len(build_interactions()) > 0, "build_interactions");
    ok(vec_len(build_campaigns()) > 0, "build_campaigns");
    ok(vec_len(build_sites()) > 0, "build_sites");
    ok(vec_len(build_routes()) > 0, "build_routes");

    # vec_sort with an explicit comparator.
    var sortv = vec_new();
    vec_push(sortv, era_new(str_from("B"), 20, 21, str_from("R"), str_from("d"), MODERN, SCOPE_GLOBAL));
    vec_push(sortv, era_new(str_from("A"), 10, 11, str_from("R"), str_from("d"), MODERN, SCOPE_GLOBAL));
    vec_sort(sortv, &_cmp_era_start);
    check(era_start(vec_get(sortv, 0)), 10, "vec_sort orders ascending");

    # ---------------------------------------------------------------
    # 2.6.2 P(-1) hardening. Every assertion here fails on 2.6.1.
    # ---------------------------------------------------------------
    println("--- 2.6.2: cross-table data rules ---");
    _inv_sweep();
    check(_inv_violations, 0, "no record contradicts the dates of a civilization it names");
    # 200 references resolve today; the floor keeps the rule from passing
    # vacuously if names ever stop resolving.
    ok(_inv_checked >= 150, "the date rule checks real references");
    var gap_years = 0;
    for (var gy = 0 - 3500; gy <= 2025; gy = gy + 1) {
        if (gy != 0) {
            if (_global_era_count(gy) == 0) { gap_years = gap_years + 1; }
        }
    }
    check(gap_years, 0, "global eras cover 3500 BCE..2025 with no gap (1611..1647 was uncovered)");
    var all_links = all_causalities();
    var links_ok = 1;
    for (var li = 0; li < vec_len(all_links); li = li + 1) {
        var lk = vec_get(all_links, li);
        var le_cause = event_by_name(caus_cause(lk));
        var le_effect = event_by_name(caus_effect(lk));
        if (le_cause == 0 || le_effect == 0) { links_ok = 0; }
        elif (evt_year(le_cause) >= evt_year(le_effect)) { links_ok = 0; }
    }
    ok(links_ok, "every causal link joins two events, cause first");

    println("--- 2.6.2: data corrections ---");
    var silk2 = route_by_name("Silk Road");
    ok(str_list_has(rt_civs(silk2), str_from("Parthian Empire"), 59), "Silk Road names the Parthian Empire");
    zero(str_list_has(rt_civs(silk2), str_from("Persian Empire"), 59), "Silk Road no longer names the Achaemenids");
    check(rt_end(route_by_name("Via Maris")), 1517, "Via Maris in use until 1517");
    check(site_disc(site_by_name("Harappa")), 1829, "Harappa first described 1829");
    check(site_disc(site_by_name("Persepolis")), 1618, "Persepolis identified 1618");
    check(site_start(site_by_name("Altamira")), 0 - 34000, "Altamira dated in BCE, not years ago");
    check(site_end(site_by_name("Altamira")), 0 - 11000, "Altamira sealed c. 11000 BCE");
    ok(str_eq(site_civ(site_by_name("Ajanta Caves")), str_from("Vakataka Dynasty")), "Ajanta under the Vakatakas");
    check(site_disc(site_by_name("Giza")), SITE_DISC_NONE, "Giza was never lost");
    check(civ_end(civ_by_name("Maya")), 1697, "Maya end at Nojpeten 1697");
    check(evt_year(event_by_name("Bantu Migration")), 0 - 1500, "Bantu expansion begins c. 1500 BCE");
    check(evt_year(event_by_name("Founding of the Ghana Empire")), civ_found(civ_by_name("Ghana Empire")),
      "Ghana founding event matches its record");
    ok(event_by_name("Peace of Westphalia"), "Peace of Westphalia");
    zero(event_by_name("Treaty of Westphalia"), "Treaty of Westphalia renamed");
    ok(event_by_name("Launch of the iPhone"), "iPhone launch, not the smartphone's invention");
    ok(str_list_has(camp_bellb(campaign_by_name("Napoleonic Wars")), str_from("Kingdom of Prussia"), 59),
      "Prussia fought Napoleon");
    check(vec_len(causes_of("Bronze Age Collapse")), 1, "Sea Peoples -> Bronze Age Collapse");
    var fr_effects = effects_of("French Revolution");
    check(vec_len(fr_effects), 1, "French Revolution has one effect");
    ok(str_eq(caus_effect(vec_get(fr_effects, 0)), str_from("Haitian Revolution")), "French -> Haitian Revolution");
    zero(vec_len(effects_of("Code of Hammurabi")), "no Code of Hammurabi -> Founding of Rome link");

    println("--- 2.6.2: accessors ---");
    var acc_c = civ_by_name("Maya");
    ok(str_eq(civ_peak(acc_c), str_from("Mesoamerican Classic")), "civ_peak");
    ok(str_eq(civ_traits(acc_c), str_from("hieroglyphic writing;calendar systems;astronomy;pyramids")), "civ_traits");
    ok(str_eq(civ_script(acc_c), str_from("Maya script")), "civ_script");
    ok(str_eq(civ_lang(acc_c), str_from("yua")), "civ_lang");
    var acc_f = figure_by_name("Aristotle");
    check(fig_birth(acc_f), 0 - 384, "fig_birth");
    check(fig_death(acc_f), 0 - 322, "fig_death");
    ok(str_eq(fig_civ(acc_f), str_from("Ancient Greece")), "fig_civ");
    ok(str_contains_cstr(fig_desc(acc_f), "Lyceum"), "fig_desc");
    var acc_e = event_by_name("French Revolution");
    ok(str_eq(evt_era(acc_e), str_from("Age of Enlightenment")), "evt_era");
    ok(str_contains_cstr(evt_desc(acc_e), "monarchy"), "evt_desc");
    ok(str_eq(evt_civs(acc_e), str_from("Kingdom of France")), "evt_civs");
    var acc_s = site_by_name("Machu Picchu");
    ok(str_eq(site_loc(acc_s), str_from("Peru")), "site_loc");
    check(site_type(acc_s), ST_SETTLEMENT, "site_type");
    ok(str_eq(site_civ(acc_s), str_from("Inca Empire")), "site_civ");
    check(site_start(acc_s), 1450, "site_start");
    check(site_end(acc_s), 1572, "site_end");
    check(site_disc(acc_s), 1911, "site_disc");
    ok(str_contains_cstr(site_desc(acc_s), "Intihuatana"), "site_desc");
    var acc_r = route_by_name("Tea-Horse Road");
    ok(str_eq(rt_regions(acc_r), str_from("East Asia;South Asia")), "rt_regions");
    check(rt_type(acc_r), ROUTE_LAND, "rt_type");
    ok(str_eq(rt_civs(acc_r), str_from("Ancient China;Tibet")), "rt_civs");
    check(rt_start(acc_r), 600, "rt_start");
    check(rt_end(acc_r), 1950, "rt_end");
    ok(str_contains_cstr(rt_desc(acc_r), "Sichuan"), "rt_desc");
    var acc_i = vec_get(interactions_between("Roman Empire", "Carthage"), 0);
    check(int_start(acc_i), 0 - 264, "int_start");
    check(int_end(acc_i), 0 - 146, "int_end");
    ok(str_eq(int_desc(acc_i), str_from("Punic Wars")), "int_desc");
    var acc_k = vec_get(causes_of("Code of Hammurabi"), 0);
    check(caus_strength(acc_k), STRENGTH_STRONG, "caus_strength");
    ok(str_contains_cstr(caus_desc(acc_k), "law codes"), "caus_desc");
    ok(str_contains_cstr(cal_leap(calendar_by_name("Gregorian")), "400"), "cal_leap");
    var acc_cp = campaign_by_name("Napoleonic Wars");
    check(camp_start(acc_cp), 1803, "camp_start");
    check(camp_end(acc_cp), 1815, "camp_end");
    check(vec_len(camp_battles(acc_cp)), 4, "camp_battles");
    ok(str_contains_cstr(camp_desc(acc_cp), "hegemony"), "camp_desc");
    var acc_b = vec_get(camp_battles(acc_cp), 3);
    ok(str_eq(bat_name(acc_b), str_from("Battle of Waterloo")), "bat_name");
    check(bat_year(acc_b), 1815, "bat_year");
    ok(str_eq(bat_loc(acc_b), str_from("Waterloo, Belgium")), "bat_loc");
    ok(str_contains_cstr(bat_desc(acc_b), "Blucher"), "bat_desc");

    println("--- 2.6.2: sorted views and collections ---");
    ok(_view_ok(all_eras_by_start(), all_eras(), ERA_START), "eras_by_start: complete, ordered, stable");
    ok(_view_ok(all_civs_by_founded(), all_civilizations(), CIV_FOUND), "civs_by_founded: complete, ordered, stable");
    ok(_view_ok(all_events_by_year(), all_events(), EVT_YEAR), "events_by_year: complete, ordered, stable");
    ok(_view_ok(all_campaigns_by_start(), all_campaigns(), CAMP_START),
      "campaigns_by_start: complete, ordered, stable");
    check(vec_len(all_calendars()), 8, "all_calendars");
    check(vec_len(all_figures()), 52, "all_figures");
    check(vec_len(all_events()), 105, "all_events");
    check(vec_len(events_between(1989, 1989)), 2, "events_between keeps duplicate years");
    check(vec_len(events_between(2, 1)), 0, "events_between inverted is empty");
    ok(vec_len(eras_containing(ERA_ONGOING)) >= 1, "eras_containing(ERA_ONGOING) finds the open era");

    println("--- 2.6.2: query semantics ---");
    zero(vec_len(sites_by_region("")), "sites_by_region empty matches none");
    zero(vec_len(routes_by_region("")), "routes_by_region empty matches none");
    zero(vec_len(campaigns_by_region("")), "campaigns_by_region empty matches none");
    check(vec_len(sites_by_region("near east")), vec_len(sites_by_region("Near East")), "sites region folds case");
    check(vec_len(civs_by_region("NEAR EAST")), vec_len(civs_by_region("Near East")), "civs region folds case");
    check(vec_len(eras_by_region("europe")), vec_len(eras_by_region("Europe")), "eras region folds case");
    check(vec_len(routes_by_region("east asia")), vec_len(routes_by_region("East Asia")), "routes region folds case");
    check(vec_len(campaigns_by_region("europe")), vec_len(campaigns_by_region("Europe")),
      "campaigns region folds case");
    ok(vec_len(sites_by_region("near east")) > 0, "folded region still matches");
    zero(vec_len(campaigns_between(1450, 1340)), "campaigns_between inverted is empty");
    check(vec_len(campaigns_by_commander("Bonaparte")), 1, "commander by surname: Bonaparte");
    check(vec_len(campaigns_by_commander("Grant")), 1, "commander by surname: Grant");
    check(vec_len(campaigns_by_commander("Caesar")), 1, "commander by surname: Caesar");
    check(vec_len(campaigns_by_commander("Wellington")), 1, "commander by later word: Wellington");
    zero(vec_len(campaigns_by_commander("apoleon")), "commander needs whole words");
    zero(vec_len(campaigns_by_commander("E.")), "a middle word of a name does not match");
    check(vec_len(campaigns_by_commander("Robert E. Lee")), 1, "the whole name still matches");
    ok(str_contains_ci(str_from("Near East, Mediterranean"), str_from("MEDITERRANEAN")), "str_contains_ci folds");
    zero(str_contains_ci(str_from("abc"), str_from("")), "str_contains_ci empty needle is 0");
    zero(str_contains_ci(str_from("ab"), str_from("abc")), "str_contains_ci longer needle is 0");

    println("--- 2.6.2: strict integers and unicode ---");
    check(_pint("-500"), 0 - 500, "parse -500");
    check(_pint("5.0"), 5, "parse 5.0 (JSON Schema integer)");
    check(_pint("1e2"), 100, "parse 1e2");
    check(_pint("-5e2"), 0 - 500, "parse -5e2 (was -52)");
    check(_pint("1.5e3"), 1500, "parse 1.5e3 (was 153)");
    check(_pint("476.0"), 476, "parse 476.0 (was 4760)");
    check(_pint("120e-1"), 12, "parse 120e-1");
    check(_pint("1.5"), 777, "refuse 1.5");
    check(_pint("500 BC"), 777, "refuse 500 BC (was 500)");
    check(_pint("null"), 777, "refuse null");
    check(_pint(""), 777, "refuse empty");
    check(_pint("+5"), 777, "refuse +5");
    check(_pint("1e400"), 777, "refuse 1e400");
    check(_pint("99999999999999999999"), 777, "refuse overflow");
    var u_pair = json_unescape(str_from("\\uD808\\uDC2D"));
    check(str_len(u_pair), 4, "surrogate pair decodes to 4 bytes");
    check(load8(str_data(u_pair)), 240, "surrogate pair lead byte F0");
    check(load8(str_data(u_pair) + 3), 173, "surrogate pair last byte AD (U+1202D)");
    var u_lone = json_unescape(str_from("\\uDC2D"));
    check(str_len(u_lone), 3, "lone surrogate becomes U+FFFD");
    check(load8(str_data(u_lone)), 239, "U+FFFD lead byte EF");

    println("--- 2.6.2: hoosh wire ---");
    ok(str_eq(_tc_name("{\"tool_calls\":[{\"function\":{\"arguments\":{\"name\":\"Bronze Age\"},\"name\":\"era_lookup\"}}]}"),   #skip-lint
        str_from("era_lookup")), "tool name is the function's, not a nested argument's");
    zero(_tc_name("{\"tool_calls\":[{\"function\":{\"name\":\"causes_of\",\"arguments\":null}}],\"type\":\"x\"}"),   #skip-lint
      "null arguments: no tool call");
    ok(str_eq(_tc_args("{\"tool_calls\":[{\"function\":{\"name\":\"causes_of\",\"arguments\":{\"event\":\"Siege }of{ X\"}}}]}"),   #skip-lint
        str_from("{\"event\":\"Siege }of{ X\"}")), "braces inside strings do not end the arguments");
    ok(str_eq(_tc_name("{\"note\":\"tool_calls\",\"tool_calls\":[{\"function\":{\"name\":\"figure_lookup\",\"arguments\":{}}}]}"),   #skip-lint
        str_from("figure_lookup")), "the text tool_calls inside a value is skipped");
    ok(str_eq(_tc_name("{\"tool_calls\":[{\"name\":\"figure_lookup\",\"arguments\":{\"name\":\"Aristotle\"}}]}"),   #skip-lint
        str_from("figure_lookup")), "a call without a function wrapper is read directly");
    var arr_body = "{\"choices\":[{\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"Rome fell\"}]}}]}";   #skip-lint
    zero(str_len(_extract_content(arr_body, strlen(arr_body))), "array content is not taken as text (was \"type\")");
    var era_null = resolve_era_lookup(bayan_json_parse(str_from("{\"name\": null, \"year\": 1200}")));
    ok(era_null, "null name falls through to year");
    ok(str_contains_cstr(resp_content(era_null), "Middle Ages"), "year 1200 is in the Middle Ages");
    ok(resolve_era_lookup(bayan_json_parse(str_from("{\"name\": \"Atlantean Age\", \"year\": 1200}"))),
      "a name that misses falls through to year");
    zero(resolve_era_lookup(bayan_json_parse(str_from("{\"name\": \"Atlantean Age\"}"))), "a miss with no year is 0");
    var q_float = parse_tool_call("events_in_range", "{\"start\": -500.0, \"end\": 5e2}");
    ok(q_float, "float-form whole numbers are accepted");
    check(load64(q_float + Q_ARG1), 0 - 500, "start -500.0 (was -5000)");
    check(load64(q_float + Q_ARG2), 500, "end 5e2 (was 52)");
    zero(parse_tool_call("civilizations_at", "{\"year\": \"500 BC\"}"), "500 BC is refused (was 500)");
    check(load64(parse_tool_call("civilizations_at", "{\"year\": 1.5e3}") + Q_ARG1), 1500, "1.5e3 is 1500 (was 153)");
    var q_esc = parse_tool_call("interactions_between", "{\"civ_a\": \"Viking\\/Norse\", \"civ_b\": \"Byzantine Empire\"}");   #skip-lint
    ok(str_eq(load64(q_esc + Q_ARG1), str_from("Viking/Norse")), "string arguments are unescaped");
    var http_ok = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello";
    check(_http_head_end(http_ok, strlen(http_ok)), strlen(http_ok) - 5, "head ends after the blank line");
    check(_http_content_length(http_ok, _http_head_end(http_ok, strlen(http_ok))), 5, "Content-Length read");
    var http_lc = "HTTP/1.1 200 OK\r\ncontent-length:   12\r\n\r\n";
    check(_http_content_length(http_lc, strlen(http_lc)), 12, "Content-Length matched without case");
    var http_none = "HTTP/1.0 200 OK\r\nServer: x\r\n\r\n";
    check(_http_content_length(http_none, strlen(http_none)), 0 - 1, "no Content-Length is -1");
    var http_bad = "HTTP/1.0 200 OK\r\nContent-Length: abc\r\n\r\n";
    check(_http_content_length(http_bad, strlen(http_bad)), 0 - 1, "a malformed Content-Length is -1");
    check(_http_head_end("HTTP/1.1 200 OK\r\nX: y\r\n", 23), 0 - 1, "an incomplete head is -1");

    itihas_log_init_level(SK_WARN);
    ok(1, "log level set");

    test_decode();

    return assert_summary();
}

var rc = main();
syscall(60, rc);
